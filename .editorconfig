root = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
dotnet_analyzer_diagnostic.category-Style.severity = error

# Extern-alias parity fixtures intentionally compare identically named types.
# Preserve inferred types instead of introducing ambiguous simple type names.
[tests/Caladesi.Compiler.Tests/SelfHost*/**.cs]
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error

[tests/Caladesi.LanguageServer.Tests/SelfHost/*.cs]
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error
