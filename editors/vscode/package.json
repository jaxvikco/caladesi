{
  "name": "caladesi",
  "displayName": "Caladesi",
  "description": "Language support for Caladesi, a toy .NET language with TypeScript syntax.",
  "version": "1.0.1",
  "publisher": "jaxvik",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B3A47",
    "theme": "dark"
  },
  "license": "MIT",
  "homepage": "https://github.com/jaxvikco/caladesi#readme",
  "bugs": {
    "url": "https://github.com/jaxvikco/caladesi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaxvikco/caladesi.git",
    "directory": "editors/vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "caladesi",
    "cala",
    ".net"
  ],
  "activationEvents": [
    "onLanguage:caladesi"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "caladesi",
        "aliases": [
          "Caladesi",
          "caladesi"
        ],
        "extensions": [
          ".cala"
        ],
        "icon": {
          "light": "./images/file-icon-light.svg",
          "dark": "./images/file-icon-dark.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xml",
        "extensions": [
          ".calaproj"
        ]
      }
    ],
    "grammars": [
      {
        "language": "caladesi",
        "scopeName": "source.caladesi",
        "path": "./syntaxes/caladesi.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "caladesi.restartServer",
        "title": "Caladesi: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Caladesi",
      "properties": {
        "caladesi.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the Caladesi language server: a native `cala-ls` executable, or `cala-ls.dll` (run with `dotnet`). When empty, the extension looks for `server/cala-ls` inside the extension, then `cala-ls` on the `PATH`, then the development build in `src/Caladesi.LanguageServer/bin`."
        },
        "caladesi.server.dotnetPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `dotnet` executable used to run a server `.dll` and, by the server itself, to evaluate `.calaproj` files. Empty: `dotnet` from `DOTNET_ROOT` or the `PATH`."
        },
        "caladesi.server.runtimePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to `Caladesi.Runtime.dll` (or its folder), used for `.cala` files that do not belong to an `.calaproj`. Empty: next to the server."
        },
        "caladesi.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Caladesi language server."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "caladesi",
        "scopes": {
          "namespace": [
            "entity.name.namespace.caladesi"
          ],
          "class": [
            "entity.name.type.class.caladesi"
          ],
          "struct": [
            "entity.name.type.struct.caladesi"
          ],
          "interface": [
            "entity.name.type.interface.caladesi"
          ],
          "enum": [
            "entity.name.type.enum.caladesi"
          ],
          "enumMember": [
            "variable.other.enummember.caladesi"
          ],
          "typeParameter": [
            "entity.name.type.parameter.caladesi"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify",
    "vscode:prepublish": "npm run bundle",
    "package": "npm run compile && vsce package --no-dependencies --out caladesi.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0",
    "vscode-languageclient": "^9.0.1"
  }
}
