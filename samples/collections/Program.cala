import { List, Dictionary } from "System.Collections.Generic";
import * as IO from "System.IO";
import "System.Linq";
import { ImmutableArray } from "System.Collections.Immutable";

const a = [1, 2, 3];
const b = [...a, 4, ...[5, 6]];
Console.WriteLine(b.Length);
const l: List<int> = [1, 2];
l.Add(3);
Console.WriteLine(l.Count);
const ro: readonly int[] = [7, 8];
Console.WriteLine(ro[1]);
function spanLen(): int { const sp: Span<int> = [1, 2, 3]; return sp.Length; }
Console.WriteLine(spanLen());
const d: Dictionary<string, int> = { one: 1, two: 2 };
Console.WriteLine(d["two"]);
const rec: Record<string, int> = { x: 1 };
Console.WriteLine(rec.Count);
const ia: ImmutableArray<int> = [1, 2, 3];
Console.WriteLine(ia.Length);
Console.WriteLine(b.Where(x => x > 2).Select(x => x * 2).ToArray().Length);
Console.WriteLine(IO.Path.Combine("a", "b"));
const matrix = [[1, 2], [3, 4]];
Console.WriteLine(matrix[1][0]);
const grid = new int[3];
grid[2] = 9;
Console.WriteLine(grid.Sum());
const [first, second] = a;
Console.WriteLine(first + second);
const t: [int, string] = [1, "x"];
Console.WriteLine(t[1]);
const { Length } = "hello";
Console.WriteLine(Length);
