import { TestClassAttribute, TestMethodAttribute, Assert } from "Microsoft.VisualStudio.TestTools.UnitTesting";

@TestClass
export class Tests {
  @TestMethod
  addsNumbers(): void {
    Assert.AreEqual(4, 2 + 2);
  }

  @TestMethod
  stringsCompare(): void {
    Assert.AreEqual("ab", "a" + "b");
    Assert.IsTrue("hello".StartsWith("he"));
  }
}
