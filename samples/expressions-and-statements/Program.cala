export function shout(this s: string): string { return s.ToUpper() + "!"; }
export function twice<T>(this xs: T[]): T[] { return [...xs, ...xs]; }

Console.WriteLine("hi".shout());
Console.WriteLine([1, 2].twice().Length);

class Disp implements IDisposable {
  constructor(private name: string) {}
  Dispose(): void { Console.WriteLine("dispose " + this.name); }
}
{
  using a = new Disp("a");
  using b = new Disp("b");
  Console.WriteLine("body");
}

function add(a: int, b: int = 10, ...rest: int[]): int { return a + b + rest.Sum(); }
Console.WriteLine(add(1));
Console.WriteLine(add(1, 2, 3, 4));

function over(x: int): string { return "int"; }
function over(x: string): string { return "string"; }
Console.WriteLine(over(1) + over("s"));

outer: for (let i = 0; i < 3; i++) {
  for (let j = 0; j < 3; j++) {
    if (j == 2) continue outer;
    if (i == 2) break outer;
    Console.WriteLine(`${i}${j}`);
  }
}
Console.WriteLine(2 ** 10);
Console.WriteLine(-8 >>> 1);
Console.WriteLine(7 / 2);
Console.WriteLine(7.0 / 2);
Console.WriteLine(10n ** 20n);
const big: bigint = 12345678901234567890n;
Console.WriteLine(big + 1n);
const x = 5 as double;
Console.WriteLine(x / 2);
const o: object = "str";
Console.WriteLine((o as string).Length);
let counter = 0;
const inc = () => counter++;
inc(); inc();
Console.WriteLine(counter);
const { a: aa, b: bb } = { a: 1, b: "two" };
Console.WriteLine(aa + bb);
const tpl = `x=${1 + 1}, y=${"s"}`;
Console.WriteLine(tpl);
Console.WriteLine(1 == 1 ? "eq" : "ne");
let u = 5;
u += 7;
Console.WriteLine(u);
const ch: char = 'a';
Console.WriteLine(ch);
const dec = 1.5m + 2m;
Console.WriteLine(dec);
const fl = 1.5f * 2;
Console.WriteLine(fl);
Console.WriteLine(10L * 3);
try { throw new InvalidOperationException("e1"); }
catch (e: ArgumentException) { Console.WriteLine("arg"); }
catch (e: InvalidOperationException) { Console.WriteLine("ioe " + e.Message); }
