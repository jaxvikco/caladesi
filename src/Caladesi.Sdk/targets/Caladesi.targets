<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported after Microsoft.NET.Sdk's targets (and Caladesi.LanguageTargets.targets). -->

  <Target Name="_CaladesiRuntimeVersionRequired" BeforeTargets="_CheckForInvalidConfigurationAndPlatform"
          Condition="'$(CaladesiImplicitRuntimeReference)' == 'true' and '$(DisableImplicitFrameworkReferences)' != 'true' and '$(CaladesiRuntimeVersion)' == ''">
    <Error Code="CALA0001" Text="The version of Caladesi.Runtime could not be taken from the SDK location '$(CaladesiSdkRoot)'; set CaladesiRuntimeVersion, or CaladesiImplicitRuntimeReference to false and reference the runtime yourself." />
  </Target>

  <!-- Implicit usings would generate C# 'global using' lines into an .cala file. -->
  <Target Name="GenerateGlobalUsings" />
</Project>
