<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Source-free packaging wrapper. eng/pack.sh supplies verified native stage3
    compiler/task outputs; this project must never compile an oracle assembly.
  -->
  <PropertyGroup>
    <PackageId>Caladesi.Sdk</PackageId>
    <Description>MSBuild SDK for the Caladesi language (.calaproj). Includes the calac compiler.</Description>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Packaging-only project: no assembly is produced, so there is nothing to version. -->
    <NoWarn>$(NoWarn);CA1016</NoWarn>
    <NoWarn>$(NoWarn);NU5128;NU5100;NU5105</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
    <None Include="targets/**" Pack="true" PackagePath="targets/" />
    <None Include="$(CaladesiTasksDir)Caladesi.Build.Tasks.dll" Pack="true" PackagePath="tasks/net10.0/" />
    <None Include="$(NativeRuntimeDir)Caladesi.Runtime.dll" Pack="true" PackagePath="tasks/net10.0/" />
    <None Include="$(CalacPublishDir)calac.dll;$(CalacPublishDir)calac.pdb;$(CalacPublishDir)calac.deps.json;$(CalacPublishDir)calac.runtimeconfig.json;$(CalacPublishDir)Caladesi.Compiler.dll;$(CalacPublishDir)Caladesi.Runtime.dll"
          Pack="true" PackagePath="tools/net10.0/" />
  </ItemGroup>
  <Import Project="../../eng/NativePackaging.targets" />
</Project>
