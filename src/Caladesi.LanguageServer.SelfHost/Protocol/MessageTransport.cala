import { Stream, BufferedStream, IOException } from "System.IO";
import { CultureInfo, NumberStyles } from "System.Globalization";
import { Encoding, StringBuilder } from "System.Text";
import { Lock } from "System.Threading";

export sealed class MessageReader {
  private readonly _stream: BufferedStream;
  constructor(stream: Stream) { this._stream = new BufferedStream(stream, 64 * 1024); }
  ReadMessage(): byte[]? {
    while (true) {
      let contentLength: int = -1;
      let sawHeader: bool = false;
      while (true) {
        const line: string? = this.ReadLine();
        if (line == null) return null;
        if (line.Length == 0) {
          if (!sawHeader) continue;
          break;
        }
        sawHeader = true;
        const colon: int = line.IndexOf(':');
        if (colon < 0) { Log.Write("ignoring malformed header line"); continue; }
        const name = line.Substring(0, colon).Trim();
        const value = line.Substring(colon + 1).Trim();
        if (!string.Equals(name, "Content-Length", StringComparison.OrdinalIgnoreCase)) continue;
        const [ok, n] = int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture);
        if (ok) contentLength = n;
        else { Log.Write("invalid Content-Length header"); contentLength = -1; }
      }
      if (contentLength < 0) { Log.Write("message without a valid Content-Length, skipping"); continue; }
      if (contentLength > 256 * 1024 * 1024) {
        Log.Write(`message of ${contentLength} bytes is too large, skipping`);
        if (!this.Skip(contentLength)) return null;
        continue;
      }
      const body: byte[] = new byte[contentLength];
      let read: int = 0;
      while (read < contentLength) {
        const n: int = this._stream.Read(body, read, contentLength - read);
        if (n <= 0) return null;
        read += n;
      }
      return body;
    }
  }
  private Skip(count: long): bool {
    const buffer: byte[] = new byte[8192];
    while (count > 0) {
      const n: int = this._stream.Read(buffer, 0, Math.Min(buffer.Length as long, count) as int);
      if (n <= 0) return false;
      count -= n;
    }
    return true;
  }
  private ReadLine(): string? {
    const sb = new StringBuilder();
    while (true) {
      const b: int = this._stream.ReadByte();
      if (b < 0) return sb.Length == 0 ? null : sb.ToString();
      if (b == 10) break;
      if (b == 13) continue;
      if (sb.Length < 16 * 1024) sb.Append(b as char);
    }
    return sb.ToString();
  }
}

export sealed class MessageWriter {
  private readonly _gate: Lock = new Lock();
  private _broken: bool = false;
  constructor(private readonly stream: Stream) {}
  Write(payload: byte[]): void {
    const scope = this._gate.EnterScope();
    try {
      if (this._broken) return;
      try {
        const header: byte[] = Encoding.ASCII.GetBytes("Content-Length: " + payload.Length.ToString(CultureInfo.InvariantCulture) + "\r\n\r\n");
        this.stream.Write(header, 0, header.Length);
        this.stream.Write(payload, 0, payload.Length);
        this.stream.Flush();
      }
      catch (ex: IOException) { this.Broken(ex); }
      catch (ex: ObjectDisposedException) { this.Broken(ex); }
      catch (ex: InvalidOperationException) { this.Broken(ex); }
    } finally { scope.Dispose(); }
  }
  private Broken(ex: Exception): void {
    this._broken = true;
    Log.Write("output stream closed: " + ex.Message);
  }
}

export sealed class Log {
  private static readonly Gate: Lock = new Lock();
  static Write(message: string): void {
    const scope = Log.Gate.EnterScope();
    try {
      try { Console.Error.WriteLine("[cala-ls] " + message); }
      catch (ex: IOException) {}
      catch (ex: ObjectDisposedException) {}
    } finally { scope.Dispose(); }
  }
}
