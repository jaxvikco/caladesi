export type Union<T1, T2> = T1 | T2;
export type Union<T1, T2, T3> = T1 | T2 | T3;
export type Union<T1, T2, T3, T4> = T1 | T2 | T3 | T4;
export type Union<T1, T2, T3, T4, T5> = T1 | T2 | T3 | T4 | T5;
export type Union<T1, T2, T3, T4, T5, T6> = T1 | T2 | T3 | T4 | T5 | T6;
export type Union<T1, T2, T3, T4, T5, T6, T7> = T1 | T2 | T3 | T4 | T5 | T6 | T7;
export type Union<T1, T2, T3, T4, T5, T6, T7, T8> = T1 | T2 | T3 | T4 | T5 | T6 | T7 | T8;
