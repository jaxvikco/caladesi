<Project>
  <Import Project="../Caladesi.Sdk/Sdk/Sdk.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Caladesi.Compiler</RootNamespace>
    <IsPackable>false</IsPackable>
    <CaladesiCompilerPath>$(CaladesiRepoRoot)src/Caladesi.Cli/bin/$(Configuration)/net10.0/calac.dll</CaladesiCompilerPath>
    <CaladesiTasksAssembly>$(CaladesiRepoRoot)src/Caladesi.Build.Tasks/bin/$(Configuration)/net10.0/Caladesi.Build.Tasks.dll</CaladesiTasksAssembly>
    <CaladesiImplicitRuntimeReference>false</CaladesiImplicitRuntimeReference>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stage zero builds this library; it must never reference this project back. -->
    <ProjectReference Include="../Caladesi.Cli/Caladesi.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Caladesi.Build.Tasks/Caladesi.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Caladesi.Runtime/Caladesi.Runtime.csproj" />
    <CustomAdditionalCompileInputs Include="$(CaladesiRepoRoot)src/Caladesi.Cli/bin/$(Configuration)/net10.0/*.dll" />
  </ItemGroup>

  <Import Project="../Caladesi.Sdk/Sdk/Sdk.targets" />
</Project>
