  static readonly RethrowOutsideCatch: DiagnosticDescriptor = Descriptors.E(289, "'throw;' is only allowed inside a catch block.");
  static readonly ReturnValueInIterator: DiagnosticDescriptor = Descriptors.E(290, "A generator cannot return a value; use 'yield'.");
  static readonly RuntimeMissing: DiagnosticDescriptor = Descriptors.E(291, "The required runtime type '{0}' was not found; is Caladesi.Runtime referenced?");
  static readonly SpreadMustBeLast: DiagnosticDescriptor = Descriptors.E(292, "A spread argument must be the last argument.");
  static readonly SpreadNotAllowedHere: DiagnosticDescriptor = Descriptors.E(293, "A spread element is not allowed here.");
  static readonly SpreadTypeMismatch: DiagnosticDescriptor = Descriptors.E(294, "Cannot spread a value of type '{0}' into '{1}'.");
  static readonly StaticViaInstance: DiagnosticDescriptor = Descriptors.E(295, "'{0}' is a static member and must be accessed through the type, not an instance of '{1}'.");
  static readonly StringLiteralTypeNotAllowed: DiagnosticDescriptor = Descriptors.E(296, "String literal types are only allowed in a union declared with a type alias.");
  static readonly StringLiteralUnionNeedsAlias: DiagnosticDescriptor = Descriptors.E(297, "A union of string literals must be declared with a type alias, e.g. 'type Dir = \"up\" | \"down\"'.");
  static readonly StructOnlyForObjectTypes: DiagnosticDescriptor = Descriptors.E(298, "The 'struct' modifier is only allowed on object type aliases.");
  static readonly SuperCallPosition: DiagnosticDescriptor = Descriptors.E(299, "'super(...)' must be the first statement of a constructor of a derived class.");
