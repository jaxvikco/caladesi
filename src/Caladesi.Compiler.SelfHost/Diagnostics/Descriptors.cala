import { DiagnosticDescriptor, DiagnosticSeverity } from "./Diagnostic";
import { CultureInfo } from "System.Globalization";

export sealed class Descriptors {
  private static E(number: int, message: string): DiagnosticDescriptor {
    return new DiagnosticDescriptor("CAL" + number.ToString("D4", CultureInfo.InvariantCulture), DiagnosticSeverity.Error, message);
  }
  private static W(number: int, message: string): DiagnosticDescriptor {
    return new DiagnosticDescriptor("CAL" + number.ToString("D4", CultureInfo.InvariantCulture), DiagnosticSeverity.Warning, message);
  }
  static readonly UnexpectedCharacter: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0001", DiagnosticSeverity.Error, "Unexpected character '{0}'.");
  static readonly UnterminatedString: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0002", DiagnosticSeverity.Error, "Unterminated string literal.");
  static readonly UnterminatedComment: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0003", DiagnosticSeverity.Error, "Unterminated comment.");
  static readonly UnterminatedTemplate: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0004", DiagnosticSeverity.Error, "Unterminated template literal.");
  static readonly InvalidEscape: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0005", DiagnosticSeverity.Error, "Invalid escape sequence.");
  static readonly InvalidNumber: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0006", DiagnosticSeverity.Error, "Invalid numeric literal: {0}");
  static readonly ExpectedToken: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0010", DiagnosticSeverity.Error, "'{0}' expected.");
  static readonly ExpectedIdentifier: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0011", DiagnosticSeverity.Error, "Identifier expected.");
  static readonly ExpectedExpression: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0012", DiagnosticSeverity.Error, "Expression expected.");
  static readonly ExpectedType: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0013", DiagnosticSeverity.Error, "Type expected.");
  static readonly ExpectedStatement: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0014", DiagnosticSeverity.Error, "Statement expected.");
  static readonly ExpectedDeclaration: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0015", DiagnosticSeverity.Error, "Declaration or statement expected.");
  static readonly UnexpectedToken: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0016", DiagnosticSeverity.Error, "Unexpected token '{0}'.");
  static readonly ExpectedMember: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0017", DiagnosticSeverity.Error, "Class member expected.");
  static readonly InvalidAssignmentTarget: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0018", DiagnosticSeverity.Error, "The left-hand side of an assignment must be a variable, property or element access.");
  static readonly ModifierNotAllowed: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0019", DiagnosticSeverity.Error, "Modifier '{0}' is not valid on this declaration.");
  static readonly DuplicateModifier: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0020", DiagnosticSeverity.Error, "Duplicate modifier '{0}'.");
  static readonly ForInNotSupported: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0021", DiagnosticSeverity.Error, "'for...in' is not supported; use 'for...of' over the keys, e.g. 'for (const k of dict.Keys)'.");
  static readonly AnyNotSupported: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0024", DiagnosticSeverity.Error, "'any' is not supported; use a specific type or 'object'.");
  static readonly UndefinedNotSupported: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0025", DiagnosticSeverity.Error, "'undefined' is not supported; use 'null'.");
  static readonly ExportDefaultNotSupported: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0026", DiagnosticSeverity.Error, "'export default' is not supported; use a named export.");
  static readonly FeatureNotSupported: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0028", DiagnosticSeverity.Error, "{0} is not supported.");
  static readonly RegexNotSupported: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0029", DiagnosticSeverity.Error, "Regular expression literals are not supported.");
  static readonly NestingTooDeep: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0330", DiagnosticSeverity.Error, "The code is nested too deeply.");
  static readonly UnaryBeforeExponent: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0331", DiagnosticSeverity.Error, "A unary operator cannot be the left operand of '**'; enclose it in parentheses, e.g. '(-2) ** 2' or '-(2 ** 2)'.");
  static readonly NotSupportedUseInstead: DiagnosticDescriptor = new DiagnosticDescriptor("CAL0332", DiagnosticSeverity.Error, "'{0}' is not supported; use '{1}'.");
  static readonly CannotReadReference: DiagnosticDescriptor = Descriptors.E(100, "Cannot read reference '{0}': {1}");
  static readonly CoreLibraryMissing: DiagnosticDescriptor = Descriptors.E(101, "A reference to the core library (System.Runtime) is required.");
  static readonly ModuleNotFound: DiagnosticDescriptor = Descriptors.E(102, "Cannot find module '{0}'.");
  static readonly ModuleHasNoExport: DiagnosticDescriptor = Descriptors.E(103, "Module '{0}' has no exported member '{1}'.");
  static readonly RecursiveInference: DiagnosticDescriptor = Descriptors.E(150, "'{0}' implicitly has a type that depends on itself; add a type annotation.");
  static readonly TypeAnnotationRequired: DiagnosticDescriptor = Descriptors.E(151, "A type annotation or an initializer is required.");
  static readonly CannotInheritSealed: DiagnosticDescriptor = Descriptors.E(152, "Cannot inherit from sealed type '{0}'.");
  static readonly BaseMustBeClass: DiagnosticDescriptor = Descriptors.E(153, "'{0}' is not a class and cannot be extended.");
  static readonly ImplementsMustBeInterface: DiagnosticDescriptor = Descriptors.E(154, "'{0}' is not an interface.");
  static readonly CircularAlias: DiagnosticDescriptor = Descriptors.E(155, "Type alias '{0}' circularly references itself.");
  static readonly DuplicateType: DiagnosticDescriptor = Descriptors.E(156, "A type named '{0}' is already defined in namespace '{1}'.");
  static readonly DuplicateMember: DiagnosticDescriptor = Descriptors.E(157, "'{0}' is already defined in '{1}' with the same signature.");
  static readonly TopLevelStatementsNotAllowed: DiagnosticDescriptor = Descriptors.E(158, "Top-level statements are only allowed in one file of an executable project.");
  static readonly MultipleEntryPoints: DiagnosticDescriptor = Descriptors.E(159, "The program has more than one entry point.");
  static readonly OverrideNothing: DiagnosticDescriptor = Descriptors.E(160, "'{0}' is marked 'override' but there is no member to override.");
  static readonly MissingOverride: DiagnosticDescriptor = Descriptors.E(161, "'{0}' hides inherited member '{1}'; add the 'override' keyword.");
  static readonly CannotOverrideSealed: DiagnosticDescriptor = Descriptors.E(162, "Cannot override '{0}' because it is not virtual, abstract or override.");
  static readonly AbstractMemberNotImplemented: DiagnosticDescriptor = Descriptors.E(163, "'{0}' does not implement inherited abstract member '{1}'.");
  static readonly InterfaceMemberNotImplemented: DiagnosticDescriptor = Descriptors.E(164, "'{0}' does not implement interface member '{1}'.");
  static readonly AbstractInNonAbstractClass: DiagnosticDescriptor = Descriptors.E(165, "'{0}' is abstract but it is declared in a non-abstract class.");
  static readonly MustReturnTask: DiagnosticDescriptor = Descriptors.E(166, "The return type of an async function must be 'Task' or 'Task<T>'.");
  static readonly MustReturnEnumerable: DiagnosticDescriptor = Descriptors.E(167, "The return type of a generator must be 'IEnumerable<T>' (or 'IAsyncEnumerable<T>' for async generators).");
  static readonly EntryPointInLibrary: DiagnosticDescriptor = Descriptors.E(168, "Libraries cannot contain top-level statements or a 'main' entry point.");
  static readonly InvalidMainSignature: DiagnosticDescriptor = Descriptors.E(169, "'main' must be 'main(args: string[])' or 'main()' returning void, int, Task or Task<int>.");
  static readonly NoEntryPoint: DiagnosticDescriptor = Descriptors.E(170, "Program does not contain an entry point; add top-level statements or a 'main' function.");
  static readonly AmbiguousCall: DiagnosticDescriptor = Descriptors.E(200, "The call to '{0}' is ambiguous between '{1}' and '{2}'.");
  static readonly AnyNotAllowed: DiagnosticDescriptor = Descriptors.E(201, "'any' is not supported; use a specific type or 'object'.");
  static readonly ArgumentNotAssignable: DiagnosticDescriptor = Descriptors.E(202, "Argument of type '{0}' is not assignable to parameter of type '{1}'.");
  static readonly AwaitOutsideAsync: DiagnosticDescriptor = Descriptors.E(203, "'await' is only allowed in async functions and top-level code of executable projects.");
  static readonly BadOperands: DiagnosticDescriptor = Descriptors.E(204, "Operator '{0}' cannot be applied to operands of type '{1}' and '{2}'.");
  static readonly BadUnaryOperand: DiagnosticDescriptor = Descriptors.E(205, "Operator '{0}' cannot be applied to an operand of type '{1}'.");
  static readonly BreakOutsideLoop: DiagnosticDescriptor = Descriptors.E(206, "'break' is only allowed inside a loop or switch statement.");
  static readonly CannotAssignConst: DiagnosticDescriptor = Descriptors.E(207, "Cannot assign to '{0}' because it is a constant.");
  static readonly CannotAssignInitOnly: DiagnosticDescriptor = Descriptors.E(208, "'{0}' can only be assigned in a constructor or object initializer.");
  static readonly CannotAssignReadonly: DiagnosticDescriptor = Descriptors.E(209, "Cannot assign to '{0}' because it is a read-only field.");
  static readonly CannotAssignReadonlyProperty: DiagnosticDescriptor = Descriptors.E(210, "Cannot assign to '{0}' because it is a read-only property.");
  static readonly CannotBeNullable: DiagnosticDescriptor = Descriptors.E(211, "The type '{0}' cannot be made nullable.");
  static readonly CannotConvert: DiagnosticDescriptor = Descriptors.E(212, "Cannot convert type '{0}' to '{1}'.");
  static readonly CannotDestructure: DiagnosticDescriptor = Descriptors.E(213, "Type '{0}' cannot be destructured.");
  static readonly CannotInferEmptyCollection: DiagnosticDescriptor = Descriptors.E(214, "Cannot infer the element type of an empty collection; add a type annotation.");
  static readonly CannotInferIteratorType: DiagnosticDescriptor = Descriptors.E(215, "Cannot infer the element type of the generator; add a return type annotation.");
  static readonly CannotInferNull: DiagnosticDescriptor = Descriptors.E(216, "Cannot infer a type from 'null'; add a type annotation such as '| null'.");
  static readonly CannotInferType: DiagnosticDescriptor = Descriptors.E(217, "Cannot infer a type for this expression; add a type annotation.");
  static readonly CannotInferTypeArguments: DiagnosticDescriptor = Descriptors.E(218, "The type arguments for '{0}' cannot be inferred from the arguments; specify them explicitly.");
  static readonly CannotInstantiate: DiagnosticDescriptor = Descriptors.E(219, "Cannot create an instance of '{0}'.");
  static readonly CannotReturnValue: DiagnosticDescriptor = Descriptors.E(220, "A function returning 'void' cannot return a value.");
  static readonly CatchMustBeException: DiagnosticDescriptor = Descriptors.E(221, "The catch type '{0}' must be System.Exception or derive from it.");
  static readonly CoalesceOnNonNullable: DiagnosticDescriptor = Descriptors.E(222, "The left operand of '??' has type '{0}', which is never null.");
  static readonly CollectionNotConvertible: DiagnosticDescriptor = Descriptors.E(223, "A collection expression cannot be converted to '{0}'.");
  static readonly ConditionalOnNonValue: DiagnosticDescriptor = Descriptors.E(224, "'?.' can only be applied to a value.");
  static readonly ConstNeedsInitializer: DiagnosticDescriptor = Descriptors.E(225, "A 'const' declaration must be initialized.");
  static readonly ConstraintNotAType: DiagnosticDescriptor = Descriptors.E(226, "'class', 'struct' and 'new()' are only allowed in type parameter constraints.");
  static readonly ContinueOutsideLoop: DiagnosticDescriptor = Descriptors.E(227, "'continue' is only allowed inside a loop.");
  static readonly DeclarationNotAllowedHere: DiagnosticDescriptor = Descriptors.E(228, "This declaration is only allowed at the top level of a file.");
  static readonly DefaultMustBeConstant: DiagnosticDescriptor = Descriptors.E(229, "The default value of a parameter must be a compile-time constant.");
  static readonly DestructuringDefaultNeedsNullable: DiagnosticDescriptor = Descriptors.E(230, "A default value in a destructuring pattern requires a nullable element type.");
  static readonly DestructuringNeedsInitializer: DiagnosticDescriptor = Descriptors.E(231, "A destructuring declaration must have an initializer.");
  static readonly DuplicateDefault: DiagnosticDescriptor = Descriptors.E(232, "A switch statement can have only one 'default' label.");
  static readonly DuplicateLocal: DiagnosticDescriptor = Descriptors.E(233, "'{0}' is already declared in this scope.");
  static readonly DuplicateObjectLiteralKey: DiagnosticDescriptor = Descriptors.E(234, "Duplicate property '{0}' in object literal.");
  static readonly DuplicateParameter: DiagnosticDescriptor = Descriptors.E(235, "Duplicate parameter '{0}'.");
  static readonly DuplicateUnionCase: DiagnosticDescriptor = Descriptors.E(236, "The union already contains the type '{0}'.");
  static readonly ExcessLiteralProperty: DiagnosticDescriptor = Descriptors.E(237, "Object literal may only specify known properties, and '{0}' does not exist in type '{1}'.");
  static readonly ExpressionNotAValue: DiagnosticDescriptor = Descriptors.E(238, "This expression does not produce a value.");
  static readonly FunctionNeedsBody: DiagnosticDescriptor = Descriptors.E(239, "Function '{0}' must have a body.");
  static readonly IndexerNeedsArguments: DiagnosticDescriptor = Descriptors.E(240, "'{0}' is an indexer and requires arguments.");
  static readonly InstanceOfImpossible: DiagnosticDescriptor = Descriptors.W(241, "A value of type '{0}' can never be an instance of '{1}'.");
  static readonly InstanceViaType: DiagnosticDescriptor = Descriptors.E(242, "'{0}' is an instance member and cannot be accessed through type '{1}'.");
  static readonly IntersectionNotAllowed: DiagnosticDescriptor = Descriptors.E(243, "Intersection types are only allowed in type parameter constraints.");
  static readonly LabelNotFound: DiagnosticDescriptor = Descriptors.E(244, "Label '{0}' was not found.");
  static readonly LambdaNeedsDelegate: DiagnosticDescriptor = Descriptors.E(245, "A function expression cannot be converted to the non-delegate type '{0}'.");
  static readonly LambdaNotConvertible: DiagnosticDescriptor = Descriptors.E(246, "This function expression cannot be converted to '{0}'.");
  static readonly LambdaParameterCount: DiagnosticDescriptor = Descriptors.E(247, "The function expression has {0} parameter(s) but the target delegate takes {1}.");
  static readonly LambdaParameterType: DiagnosticDescriptor = Descriptors.E(248, "The type '{1}' of parameter '{0}' is incompatible with the delegate parameter type '{2}'.");
  static readonly MemberNotFound: DiagnosticDescriptor = Descriptors.E(249, "Property '{0}' does not exist on type '{1}'.");
  static readonly MemberNotFoundDidYouMean: DiagnosticDescriptor = Descriptors.E(250, "Property '{0}' does not exist on type '{1}'. Did you mean '{2}'?");
  static readonly MethodGroupNeedsDelegate: DiagnosticDescriptor = Descriptors.E(251, "The method group '{0}' cannot be converted to the non-delegate type '{1}'.");
  static readonly MethodGroupNotConvertible: DiagnosticDescriptor = Descriptors.E(252, "No overload of '{0}' matches the delegate type '{1}'.");
  static readonly MissingLiteralMember: DiagnosticDescriptor = Descriptors.E(253, "Property '{0}' is missing in the object literal but required in type '{1}'.");
  static readonly MustReturnValue: DiagnosticDescriptor = Descriptors.E(254, "A function with return type '{0}' must return a value.");
  static readonly NameNotFound: DiagnosticDescriptor = Descriptors.E(255, "Cannot find name '{0}'. Did you forget an import?");
  static readonly NamespaceHasNoMember: DiagnosticDescriptor = Descriptors.E(256, "Namespace '{0}' has no member '{1}'.");
  static readonly NamespaceUsedAsValue: DiagnosticDescriptor = Descriptors.E(257, "'{0}' is a namespace or module and cannot be used as a value.");
  static readonly NewRequiresConstraint: DiagnosticDescriptor = Descriptors.E(258, "Cannot create an instance of type parameter '{0}' because it has no 'new()' constraint.");
  static readonly NewTypeParamNoArgs: DiagnosticDescriptor = Descriptors.E(259, "Cannot create an instance of a type parameter with arguments.");
  static readonly NoAccessibleConstructor: DiagnosticDescriptor = Descriptors.E(260, "Type '{0}' has no accessible constructor.");
  static readonly NoBestCommonType: DiagnosticDescriptor = Descriptors.E(261, "No best common type exists between '{0}' and '{1}'.");
  static readonly NoBestCommonTypeCollection: DiagnosticDescriptor = Descriptors.E(262, "The elements of the collection have no best common type; add a type annotation.");
  static readonly NoBestCommonTypeReturns: DiagnosticDescriptor = Descriptors.E(263, "The return statements have no best common type; add a return type annotation.");
  static readonly NoMatchingOverload: DiagnosticDescriptor = Descriptors.E(264, "No overload for '{0}' matches the argument list ({1}).");
  static readonly NoOverlap: DiagnosticDescriptor = Descriptors.E(265, "This comparison appears to be unintentional because the types '{0}' and '{1}' have no overlap.");
  static readonly NonExhaustiveSwitch: DiagnosticDescriptor = Descriptors.E(266, "The switch is not exhaustive; unhandled cases: {0}.");
  static readonly NotAType: DiagnosticDescriptor = Descriptors.E(267, "'{0}' is not a type.");
  static readonly NotAllPathsReturn: DiagnosticDescriptor = Descriptors.E(268, "Not all code paths of '{0}' return a value.");
  static readonly NotAssignable: DiagnosticDescriptor = Descriptors.E(269, "Type '{0}' is not assignable to type '{1}'.");
  static readonly NotAssignableExplicitExists: DiagnosticDescriptor = Descriptors.E(270, "Type '{0}' is not assignable to type '{1}'. An explicit conversion exists; use 'as {2}'.");
  static readonly NotAwaitable: DiagnosticDescriptor = Descriptors.E(271, "Type '{0}' is not awaitable.");
  static readonly NotCallable: DiagnosticDescriptor = Descriptors.E(272, "This expression is not callable.");
  static readonly NotDisposable: DiagnosticDescriptor = Descriptors.E(273, "Type '{0}' does not implement '{1}'.");
  static readonly NotGeneric: DiagnosticDescriptor = Descriptors.E(274, "'{0}' is not generic.");
  static readonly NotIndexable: DiagnosticDescriptor = Descriptors.E(275, "Type '{0}' has no indexer.");
  static readonly NotIterable: DiagnosticDescriptor = Descriptors.E(276, "Type '{0}' is not iterable.");
  static readonly NullDeref: DiagnosticDescriptor = Descriptors.E(277, "Cannot access a member of 'null'.");
  static readonly NullNotAssignable: DiagnosticDescriptor = Descriptors.E(278, "Type 'null' is not assignable to type '{0}'. Add '| null' to the type to allow null.");
  static readonly ObjectLiteralNotConvertible: DiagnosticDescriptor = Descriptors.E(279, "An object literal cannot be converted to type '{0}'.");
  static readonly ObjectTypeLiteralNotAllowed: DiagnosticDescriptor = Descriptors.E(280, "Object type literals are only allowed as the right-hand side of a type alias.");
  static readonly ObjectTypeMemberNotProperty: DiagnosticDescriptor = Descriptors.E(281, "Only properties are allowed in an object type.");
  static readonly ParameterTypeRequired: DiagnosticDescriptor = Descriptors.E(282, "Parameter '{0}' requires a type annotation.");
  static readonly PossiblyNull: DiagnosticDescriptor = Descriptors.E(283, "'{0}' is possibly null.");
  static readonly PossiblyNullAssign: DiagnosticDescriptor = Descriptors.E(284, "Type '{0}' is not assignable to type '{1}' because it may be null.");
  static readonly ReadonlyOnlyArrays: DiagnosticDescriptor = Descriptors.E(285, "The 'readonly' type modifier is only allowed on array types.");
