    super(SyntaxKind.FunctionExpression, [asyncKeyword, functionKeyword, asterisk, identifier, typeParams, parameters, returnType, body]);
  }
  get AsyncKeyword(): SyntaxToken? { return this.TokOpt(0); }
  get AsteriskToken(): SyntaxToken? { return this.TokOpt(2); }
  get Parameters(): ParameterListSyntax { return this.Node<ParameterListSyntax>(5); }
  get ReturnType(): TypeAnnotationSyntax? { return this.NodeOpt<TypeAnnotationSyntax>(6); }
  get Body(): BlockSyntax { return this.Node<BlockSyntax>(7); }
}

