    this.EmitExpression(binary.Right, true); this.il.Branch(ILOpCode.Br, end);
    this.il.Mark(shortCircuit); this.il.LdcI4(binary.IsAnd ? 0 : 1); this.il.Mark(end); this.Discard(used);
