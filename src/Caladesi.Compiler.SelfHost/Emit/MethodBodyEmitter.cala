      this.il.Stloc(this.GetLocal((target as BoundLocal).Local).Index); return;
    }
    if (target instanceof BoundParameter) {
      this.EmitExpression(assignment.Value, true); if (used) this.il.Op(ILOpCode.Dup, 1);
      this.il.Starg(this.paramIndex[(target as BoundParameter).Parameter]); return;
    }
    if (target instanceof BoundFieldAccess) {
