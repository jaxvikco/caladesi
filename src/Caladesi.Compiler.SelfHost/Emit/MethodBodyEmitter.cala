import { Dictionary, Stack } from "System.Collections.Generic";
import { ImmutableArray } from "System.Collections.Immutable";
import { BigInteger } from "System.Numerics";
import { CultureInfo } from "System.Globalization";
import { ILOpCode } from "System.Reflection.Metadata";
import { LabelHandle } from "System.Reflection.Metadata.Ecma335";
import { MetadataEmitter } from "./MetadataEmitter";
import { ILBuilder, LocalSlot } from "./ILBuilder";
import { TypeSymbol, NullableTypeSymbol, TypeParameterSymbol, TypeKind } from "../Symbols/TypeSymbols";
import { NamedTypeSymbol } from "../Symbols/NamedTypeSymbol";
import { SpecialType, SpecialTypes } from "../Symbols/SpecialType";
import { MethodSymbol, MethodKind, FieldSymbol, PropertySymbol, LocalSymbol, ParameterSymbol, LabelSymbol } from "../Symbols/MemberSymbols";
import { SyntaxNode } from "../Syntax/SyntaxElement";
import { SourceText } from "../Text/SourceText";
import { BoundNode, BoundStatement, BoundBlock, BoundStatementList, BoundNoOp, BoundSequencePoint,
  BoundExpressionStatement, BoundLocalDeclaration, BoundIf, BoundWhile, BoundDoWhile, BoundFor,
  BoundGoto, BoundConditionalGoto, BoundLabel, BoundReturn, BoundThrow, BoundTry, BoundYieldReturn, BoundYieldBreak,
  BoundExpression, BoundLiteral, BoundIsNull, BoundAddressOf, BoundLocal, BoundParameter, BoundThis, BoundBaseReference,
  BoundFieldAccess, BoundPropertyAccess, BoundCall, BoundObjectCreation, BoundDefaultValue, BoundArrayCreation,
  BoundArrayAccess, BoundConversion, ConversionKind, BoundUnary, UnaryOperatorKind, BoundBinary, BinaryOperatorKind,
  BoundLogicalBinary, BoundAssignment, BoundConditional, BoundCoalesce, BoundConditionalAccess, BoundConditionalReceiver,
  BoundTypeTest, TypeTestKind, BoundDelegateCreation, BoundSequence, BoundTypeOf, BoundThrowExpression,
  BoundLambda, BoundAwait, BoundUnbound, BoundMethodGroup, BoundTypeExpression, BoundNamespaceExpression,
  BoundBadExpression } from "../Bound/BoundNodes";

class MethodBodyTryIds {
  constructor(readonly Outer: int, readonly Body: int, readonly Catches: int[], readonly Finally: int) {}
}

class MethodBodyConditionalReceiver {
  constructor(readonly Slot: LocalSlot, readonly ReceiverType: TypeSymbol, readonly IsNullableValue: bool) {}
}

export sealed class MethodBodyEmitter {
  private readonly locals: Dictionary<LocalSymbol, LocalSlot> = new Dictionary<LocalSymbol, LocalSlot>();
  private readonly paramIndex: Dictionary<ParameterSymbol, int> = new Dictionary<ParameterSymbol, int>();
  private readonly labels: Dictionary<LabelSymbol, LabelHandle> = new Dictionary<LabelSymbol, LabelHandle>();
  private readonly labelTry: Dictionary<LabelSymbol, int> = new Dictionary<LabelSymbol, int>();
  private readonly tryParent: Dictionary<int, int> = new Dictionary<int, int>();
  private readonly condReceivers: Dictionary<BoundConditionalReceiver, MethodBodyConditionalReceiver> = new Dictionary<BoundConditionalReceiver, MethodBodyConditionalReceiver>();
  private readonly tryStack: Stack<int> = new Stack<int>();
  private readonly tryIds: Dictionary<BoundTry, MethodBodyTryIds> = new Dictionary<BoundTry, MethodBodyTryIds>();
  private nextTryId: int = 1;
  private returnSlot: LocalSlot? = null;
  private returnLabel: LabelHandle = new LabelHandle();
  private returnLabelUsed: bool = false;
  private readonly hasReturnValue: bool;
  private readonly thisIsByRef: bool;

  constructor(private readonly metadata: MetadataEmitter, private readonly method: MethodSymbol,
    private readonly il: ILBuilder, private readonly getSpecialType: Func<SpecialType, NamedTypeSymbol>,
    private readonly getWellKnownType: Func<string, NamedTypeSymbol?>, private readonly source: SourceText?) {
    this.hasReturnValue = !method.ReturnType.ReturnsNothing && method.MethodKind != MethodKind.Constructor
      && method.MethodKind != MethodKind.StaticConstructor;
    this.thisIsByRef = method.ContainingType != null && method.ContainingType.IsValueType;
    const offset = method.IsStatic ? 0 : 1;
    for (const parameter of method.Parameters) this.paramIndex[parameter] = parameter.Ordinal + offset;
  }

  EmitBody(body: BoundBlock): void {
    this.PreScanLabels(body, 0);
    this.returnLabel = this.il.NewLabel();
    this.EmitStatement(body);
    if (this.hasReturnValue) this.EmitDefault(this.method.ReturnType);
    this.il.Op(ILOpCode.Ret, this.hasReturnValue ? -1 : 0);
    if (this.returnLabelUsed) {
      this.il.Mark(this.returnLabel);
      if (this.returnSlot != null) this.il.Ldloc(this.returnSlot.Index);
      this.il.Op(ILOpCode.Ret, this.returnSlot != null ? -1 : 0);
    }
  }

  private PreScanLabels(node: BoundNode, tryId: int): void {
    if (node instanceof BoundLabel) { this.labelTry[(node as BoundLabel).Label] = tryId; return; }
    if (node instanceof BoundBlock) {
      for (const statement of (node as BoundBlock).Statements) this.PreScanLabels(statement, tryId);
      return;
    }
    if (node instanceof BoundStatementList) {
      for (const statement of (node as BoundStatementList).Statements) this.PreScanLabels(statement, tryId);
      return;
    }
    if (node instanceof BoundIf) {
      const branch = node as BoundIf;
      this.PreScanLabels(branch.Consequence, tryId);
      if (branch.Alternative != null) this.PreScanLabels(branch.Alternative, tryId);
      return;
    }
    if (node instanceof BoundWhile) {
      const loop = node as BoundWhile;
      this.labelTry[loop.BreakLabel] = tryId; this.labelTry[loop.ContinueLabel] = tryId;
      this.PreScanLabels(loop.Body, tryId); return;
    }
    if (node instanceof BoundDoWhile) {
      const loop = node as BoundDoWhile;
      this.labelTry[loop.BreakLabel] = tryId; this.labelTry[loop.ContinueLabel] = tryId;
      this.PreScanLabels(loop.Body, tryId); return;
    }
    if (node instanceof BoundFor) {
      const loop = node as BoundFor;
      this.labelTry[loop.BreakLabel] = tryId; this.labelTry[loop.ContinueLabel] = tryId;
      if (loop.Initializer != null) this.PreScanLabels(loop.Initializer, tryId);
      if (loop.Increment != null) this.PreScanLabels(loop.Increment, tryId);
      this.PreScanLabels(loop.Body, tryId); return;
    }
    if (node instanceof BoundTry) {
      const region = node as BoundTry;
      const outer = region.Finally != null ? this.nextTryId++ : 0;
      const body = this.nextTryId++;
      const catches: int[] = new int[region.Catches.Length];
      for (let i = 0; i < catches.Length; i++) catches[i] = this.nextTryId++;
      const ids = new MethodBodyTryIds(outer, body, catches, region.Finally != null ? this.nextTryId++ : 0);
      this.tryIds[region] = ids;
      const parent = ids.Outer != 0 ? ids.Outer : tryId;
      if (ids.Outer != 0) this.tryParent[ids.Outer] = tryId;
      this.tryParent[ids.Body] = parent;
      for (const id of ids.Catches) this.tryParent[id] = parent;
      if (ids.Finally != 0) this.tryParent[ids.Finally] = tryId;
      this.PreScanLabels(region.Body, ids.Body);
      for (let i = 0; i < region.Catches.Length; i++) this.PreScanLabels(region.Catches[i].Body, ids.Catches[i]);
      if (region.Finally != null) this.PreScanLabels(region.Finally, ids.Finally);
      return;
    }
    if (node instanceof BoundSequencePoint) this.PreScanLabels((node as BoundSequencePoint).Statement, tryId);
  }

  private GetLabel(label: LabelSymbol): LabelHandle {
    const [found, handle] = this.labels.TryGetValue(label);
    if (found) return handle;
    const created = this.il.NewLabel();
    this.labels[label] = created;
    return created;
  }
  private get CurrentTry(): int { return this.tryStack.Count == 0 ? 0 : this.tryStack.Peek(); }
  private GetLocal(local: LocalSymbol): LocalSlot {
    const [found, slot] = this.locals.TryGetValue(local);
    if (found) return slot;
    const created = this.il.NewLocal(this.metadata.ClrType(local.Type), local.IsSynthesized ? null : local.Name);
    this.locals[local] = created;
    return created;
  }
  private TempLocal(type: TypeSymbol): LocalSlot { return this.il.NewLocal(this.metadata.ClrType(type)); }

  private EmitStatement(statement: BoundStatement): void {
    if (statement instanceof BoundBlock) {
      const block = statement as BoundBlock;
      for (const local of block.Locals) this.GetLocal(local);
      for (const child of block.Statements) this.EmitStatement(child);
      return;
    }
    if (statement instanceof BoundStatementList) {
      for (const child of (statement as BoundStatementList).Statements) this.EmitStatement(child);
      return;
    }
    if (statement instanceof BoundNoOp) return;
    if (statement instanceof BoundSequencePoint) {
      const point = statement as BoundSequencePoint;
      this.MarkSequencePoint(point.SyntaxNodeForSpan); this.EmitStatement(point.Statement); return;
    }
    if (statement instanceof BoundExpressionStatement) {
      this.MarkSequencePoint(statement.Syntax);
      this.EmitExpression((statement as BoundExpressionStatement).Expression, false); return;
    }
    if (statement instanceof BoundLocalDeclaration) {
      const declaration = statement as BoundLocalDeclaration;
      this.MarkSequencePoint(declaration.Syntax);
      if (declaration.Initializer != null) {
        this.EmitExpression(declaration.Initializer, true); this.il.Stloc(this.GetLocal(declaration.Local).Index);
      }
      return;
    }
    if (statement instanceof BoundIf) { this.EmitIf(statement as BoundIf); return; }
    if (statement instanceof BoundWhile) { this.EmitWhile(statement as BoundWhile); return; }
    if (statement instanceof BoundDoWhile) { this.EmitDoWhile(statement as BoundDoWhile); return; }
    if (statement instanceof BoundFor) { this.EmitFor(statement as BoundFor); return; }
    if (statement instanceof BoundGoto) { this.EmitGoto((statement as BoundGoto).Label); return; }
    if (statement instanceof BoundConditionalGoto) {
      const branch = statement as BoundConditionalGoto;
      if (this.RequiresLeave(branch.Label)) {
        const skip = this.il.NewLabel();
        this.EmitBranchIf(branch.Condition, skip, !branch.JumpIfTrue);
        this.il.Branch(ILOpCode.Leave, this.GetLabel(branch.Label)); this.il.Mark(skip);
      } else this.EmitBranchIf(branch.Condition, this.GetLabel(branch.Label), branch.JumpIfTrue);
      return;
    }
    if (statement instanceof BoundLabel) { this.il.Mark(this.GetLabel((statement as BoundLabel).Label)); return; }
    if (statement instanceof BoundReturn) { this.EmitReturn(statement as BoundReturn); return; }
    if (statement instanceof BoundThrow) {
      const thrown = statement as BoundThrow;
      this.MarkSequencePoint(thrown.Syntax);
      if (thrown.Expression == null) this.il.Op(ILOpCode.Rethrow, 0);
      else { this.EmitExpression(thrown.Expression, true); this.il.Op(ILOpCode.Throw, -1); }
      return;
    }
    if (statement instanceof BoundTry) { this.EmitTry(statement as BoundTry); return; }
    if (statement instanceof BoundYieldReturn || statement instanceof BoundYieldBreak)
      throw new InvalidOperationException("yield statements must be lowered before emit");
    throw new InvalidOperationException("Unhandled statement " + statement.GetType().Name);
  }

  private MarkSequencePoint(node: SyntaxNode?): void {
    if (node == null || this.source == null) return;
    const span = node.Span;
    if (span.Length == 0) return;
    const position = this.source.GetLinePositionSpan(span);
    this.il.MarkSequencePoint(position.Start.Line + 1, position.Start.Character + 1,
      position.End.Line + 1, position.End.Character + 1);
  }
  private EmitGoto(label: LabelSymbol): void {
    const target = this.GetLabel(label);
    this.il.Branch(this.RequiresLeave(label) ? ILOpCode.Leave : ILOpCode.Br, target);
  }
  private RequiresLeave(label: LabelSymbol): bool {
    const [found, value] = this.labelTry.TryGetValue(label);
    const target = found ? value : 0;
    const current = this.CurrentTry;
    if (target == current) return false;
    let region = target;
    while (region != 0) {
      if (region == current) return false;
      const [hasParent, parent] = this.tryParent.TryGetValue(region);
      region = hasParent ? parent : 0;
    }
    return current != 0;
  }
  private EmitReturn(statement: BoundReturn): void {
    this.MarkSequencePoint(statement.Syntax);
    if (statement.Expression != null) this.EmitExpression(statement.Expression, true);
    if (this.tryStack.Count > 0) {
      if (statement.Expression != null) {
        if (this.returnSlot == null) this.returnSlot = this.TempLocal(this.method.ReturnType);
        this.il.Stloc(this.returnSlot.Index);
      }
      this.returnLabelUsed = true;
      this.il.Branch(ILOpCode.Leave, this.returnLabel);
    } else this.il.Op(ILOpCode.Ret, statement.Expression != null ? -1 : 0);
  }
  private EmitIf(branch: BoundIf): void {
    this.MarkSequencePoint(branch.Condition.Syntax);
    const alternative = this.il.NewLabel();
    this.EmitBranchIf(branch.Condition, alternative, false);
    this.EmitStatement(branch.Consequence);
    if (branch.Alternative != null) {
      const end = this.il.NewLabel();
      this.il.Branch(ILOpCode.Br, end); this.il.Mark(alternative);
      this.EmitStatement(branch.Alternative!); this.il.Mark(end);
    } else this.il.Mark(alternative);
  }
  private EmitWhile(loop: BoundWhile): void {
    const body = this.il.NewLabel();
    const cont = this.GetLabel(loop.ContinueLabel);
    const end = this.GetLabel(loop.BreakLabel);
    this.il.Branch(ILOpCode.Br, cont); this.il.Mark(body);
    this.EmitStatement(loop.Body); this.il.Mark(cont);
    this.MarkSequencePoint(loop.Condition.Syntax);
    this.EmitBranchIf(loop.Condition, body, true); this.il.Mark(end);
  }
  private EmitDoWhile(loop: BoundDoWhile): void {
    const body = this.il.NewLabel();
    this.il.Mark(body); this.EmitStatement(loop.Body);
    this.il.Mark(this.GetLabel(loop.ContinueLabel));
    this.EmitBranchIf(loop.Condition, body, true);
    this.il.Mark(this.GetLabel(loop.BreakLabel));
  }
  private EmitFor(loop: BoundFor): void {
    for (const local of loop.Locals) this.GetLocal(local);
    if (loop.Initializer != null) this.EmitStatement(loop.Initializer);
    const body = this.il.NewLabel();
    const cont = this.GetLabel(loop.ContinueLabel);
    const condition = this.il.NewLabel();
    this.il.Branch(ILOpCode.Br, condition); this.il.Mark(body);
    this.EmitStatement(loop.Body); this.il.Mark(cont);
    if (loop.Increment != null) this.EmitStatement(loop.Increment);
    this.il.Mark(condition);
    if (loop.Condition != null) this.EmitBranchIf(loop.Condition, body, true);
    else this.il.Branch(ILOpCode.Br, body);
    this.il.Mark(this.GetLabel(loop.BreakLabel));
  }
  private EmitTry(region: BoundTry): void {
    const ids = this.tryIds[region];
    const flow = this.il.ControlFlow;
    const start = this.il.NewLabel();
    const finish = this.il.NewLabel();
    const end = this.il.NewLabel();
    const hasFinally = region.Finally != null;
    let outerStart = new LabelHandle();
    let outerEnd = new LabelHandle();
    if (hasFinally) {
      outerStart = this.il.NewLabel(); outerEnd = this.il.NewLabel();
      this.il.Mark(outerStart); this.tryStack.Push(ids.Outer);
    }
    this.il.Mark(start); this.tryStack.Push(ids.Body);
    this.EmitStatement(region.Body); this.il.Branch(ILOpCode.Leave, end);
    this.tryStack.Pop(); this.il.Mark(finish);
    for (let i = 0; i < region.Catches.Length; i++) {
      const handler = region.Catches[i];
      const handlerStart = this.il.NewLabel();
      const handlerEnd = this.il.NewLabel();
      this.il.Mark(handlerStart); this.tryStack.Push(ids.Catches[i]); this.il.ResetDepth(1);
      if (handler.Local != null) this.il.Stloc(this.GetLocal(handler.Local).Index);
      else this.il.Op(ILOpCode.Pop, -1);
      this.EmitStatement(handler.Body); this.il.Branch(ILOpCode.Leave, end);
      this.tryStack.Pop(); this.il.Mark(handlerEnd);
      flow.AddCatchRegion(start, finish, handlerStart, handlerEnd, this.metadata.GetTypeEntity(handler.ExceptionType));
    }
    if (hasFinally) {
      this.il.Mark(end); this.il.Branch(ILOpCode.Leave, outerEnd); this.tryStack.Pop();
      const protectedEnd = this.il.NewLabel();
      const finallyStart = this.il.NewLabel();
      const finallyEnd = this.il.NewLabel();
      this.il.Mark(protectedEnd); this.il.Mark(finallyStart);
      this.tryStack.Push(ids.Finally); this.il.ResetDepth(0);
      this.EmitStatement(region.Finally!); this.il.Op(ILOpCode.Endfinally, 0);
      this.tryStack.Pop(); this.il.Mark(finallyEnd);
      flow.AddFinallyRegion(outerStart, protectedEnd, finallyStart, finallyEnd); this.il.Mark(outerEnd);
    } else this.il.Mark(end);
    this.il.ResetDepth(0);
  }

  EmitExpression(expression: BoundExpression, used: bool): void {
    const constant = expression.ConstantValue;
    if (constant != null && !(expression instanceof BoundAssignment) && !(expression instanceof BoundSequence)
      && !(expression instanceof BoundCall) && expression.Type != null && !expression.Type.IsErrorType) {
      if (used) this.EmitConstant(constant.Value, expression.Type);
      return;
    }
    if (expression instanceof BoundLiteral) {
      const literal = expression as BoundLiteral;
      if (used) this.EmitConstant(literal.Value.Value, literal.Type!);
      return;
    }
    if (expression instanceof BoundIsNull) {
      const operand = (expression as BoundIsNull).Operand;
      const type = this.metadata.ClrType(operand.Type!);
      if (MetadataEmitter.IsNullableValue(operand.Type!)) {
        this.EmitAddress(operand);
        this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(this.FindMethod(type as NamedTypeSymbol, "get_HasValue")), 1, 1);
        this.il.LdcI4(0); this.il.Op(ILOpCode.Ceq, -1);
      } else if (MetadataEmitter.IsValueTypeLike(type)) {
        this.EmitExpression(operand, false); this.il.LdcI4(0);
      } else {
        this.EmitExpression(operand, true);
        if (type instanceof TypeParameterSymbol) this.il.Token(ILOpCode.Box, this.metadata.GetTypeEntity(type), 0);
        this.il.Op(ILOpCode.Ldnull, 1); this.il.Op(ILOpCode.Ceq, -1);
      }
      this.Discard(used); return;
    }
    if (expression instanceof BoundAddressOf) { this.EmitAddress((expression as BoundAddressOf).Operand); this.Discard(used); return; }
    if (expression instanceof BoundLocal) { if (used) this.il.Ldloc(this.GetLocal((expression as BoundLocal).Local).Index); return; }
    if (expression instanceof BoundParameter) { if (used) this.il.Ldarg(this.paramIndex[(expression as BoundParameter).Parameter]); return; }
    if (expression instanceof BoundThis) {
      if (used) { this.il.Ldarg(0); if (this.thisIsByRef) this.EmitLdobj(this.method.ContainingType!); }
      return;
    }
    if (expression instanceof BoundBaseReference) { if (used) this.il.Ldarg(0); return; }
    if (expression instanceof BoundFieldAccess) { this.EmitFieldLoad(expression as BoundFieldAccess, used); return; }
    if (expression instanceof BoundPropertyAccess) { this.EmitPropertyGet(expression as BoundPropertyAccess, used); return; }
    if (expression instanceof BoundCall) {
      const call = expression as BoundCall;
      this.EmitCallCore(call.Method, call.Receiver, call.Arguments, call.IsBaseCall, used); return;
    }
    if (expression instanceof BoundObjectCreation) { this.EmitObjectCreation(expression as BoundObjectCreation, used); return; }
    if (expression instanceof BoundDefaultValue) { if (used) this.EmitDefault(expression.Type!); return; }
    if (expression instanceof BoundArrayCreation) { this.EmitArrayCreation(expression as BoundArrayCreation, used); return; }
    if (expression instanceof BoundArrayAccess) {
      const access = expression as BoundArrayAccess;
      this.EmitExpression(access.Array, true); this.EmitExpression(access.Index, true);
      this.EmitLdelem(access.Type!); this.Discard(used); return;
    }
    if (expression instanceof BoundConversion) { this.EmitConversion(expression as BoundConversion, used); return; }
    if (expression instanceof BoundUnary) { this.EmitUnary(expression as BoundUnary, used); return; }
    if (expression instanceof BoundBinary) { this.EmitBinary(expression as BoundBinary, used); return; }
    if (expression instanceof BoundLogicalBinary) { this.EmitLogical(expression as BoundLogicalBinary, used); return; }
    if (expression instanceof BoundAssignment) { this.EmitAssignment(expression as BoundAssignment, used); return; }
    if (expression instanceof BoundConditional) { this.EmitConditional(expression as BoundConditional, used); return; }
    if (expression instanceof BoundCoalesce) { this.EmitCoalesce(expression as BoundCoalesce, used); return; }
    if (expression instanceof BoundConditionalAccess) { this.EmitConditionalAccess(expression as BoundConditionalAccess, used); return; }
    if (expression instanceof BoundConditionalReceiver) { this.EmitConditionalReceiver(expression as BoundConditionalReceiver, used); return; }
    if (expression instanceof BoundTypeTest) { this.EmitTypeTest(expression as BoundTypeTest, used); return; }
    if (expression instanceof BoundDelegateCreation) { this.EmitDelegateCreation(expression as BoundDelegateCreation, used); return; }
    if (expression instanceof BoundSequence) {
      const sequence = expression as BoundSequence;
      for (const local of sequence.Locals) this.GetLocal(local);
      for (const statement of sequence.SideEffects) this.EmitStatement(statement);
      this.EmitExpression(sequence.Value, used); return;
    }
    if (expression instanceof BoundTypeOf) {
      const typeOf = expression as BoundTypeOf;
      this.il.Token(ILOpCode.Ldtoken, this.metadata.GetTypeEntity(typeOf.Operand), 1);
      this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(this.FindMethod(typeOf.Type! as NamedTypeSymbol, "GetTypeFromHandle")), 1, 1);
      this.Discard(used); return;
    }
    if (expression instanceof BoundThrowExpression) {
      this.EmitExpression((expression as BoundThrowExpression).Operand, true); this.il.Op(ILOpCode.Throw, -1); return;
    }
    if (expression instanceof BoundLambda || expression instanceof BoundAwait || expression instanceof BoundUnbound
      || expression instanceof BoundMethodGroup || expression instanceof BoundTypeExpression
      || expression instanceof BoundNamespaceExpression || expression instanceof BoundBadExpression)
      throw new InvalidOperationException("Expression must be lowered before emit: " + expression.GetType().Name);
    throw new InvalidOperationException("Unhandled expression " + expression.GetType().Name);
  }

  private Discard(used: bool): void { if (!used) this.il.Op(ILOpCode.Pop, -1); }
  private FindMethod(type: NamedTypeSymbol, name: string): MethodSymbol {
    for (const member of type.GetMembers(name)) if (member instanceof MethodSymbol) return member as MethodSymbol;
    throw new InvalidOperationException("Sequence contains no elements");
  }
  private FindMethodWithArity(type: NamedTypeSymbol, name: string, count: int): MethodSymbol {
    for (const member of type.GetMembers(name))
      if (member instanceof MethodSymbol && (member as MethodSymbol).Parameters.Length == count) return member as MethodSymbol;
    throw new InvalidOperationException("Sequence contains no matching element");
  }
  private FindConstructor(type: NamedTypeSymbol, count: int): MethodSymbol {
    for (const ctor of type.InstanceConstructors) if (ctor.Parameters.Length == count) return ctor;
    throw new InvalidOperationException("Sequence contains no matching element");
  }
  private FindCaseConstructor(type: NamedTypeSymbol, caseType: TypeSymbol): MethodSymbol {
    for (const ctor of type.InstanceConstructors)
      if (ctor.Parameters.Length == 1 && ctor.Parameters[0].Type.Equals(caseType)) return ctor;
    throw new InvalidOperationException("Sequence contains no matching element");
  }
  private FindField(type: NamedTypeSymbol, name: string): FieldSymbol {
    for (const member of type.GetMembers(name)) if (member instanceof FieldSymbol) return member as FieldSymbol;
    throw new InvalidOperationException("Sequence contains no elements");
  }

  private EmitConstant(value: object?, type: TypeSymbol): void {
    let target = type;
    if (target instanceof NullableTypeSymbol && value != null) target = (target as NullableTypeSymbol).Underlying;
    if (target.TypeKind == TypeKind.Enum) target = (target as NamedTypeSymbol).EnumUnderlyingType!;
    if (value == null) { this.EmitDefault(type); return; }
    switch (target.SpecialType) {
      case SpecialType.Boolean: this.il.LdcI4((value as bool) ? 1 : 0); return;
      case SpecialType.Char: this.il.LdcI4(value instanceof char ? (value as char) as int : Convert.ToInt32(value)); return;
      case SpecialType.SByte:
      case SpecialType.Byte:
      case SpecialType.Int16:
      case SpecialType.UInt16:
      case SpecialType.Int32:
        this.il.LdcI4(Convert.ToInt32(value instanceof char ? ((value as char) as int) as object : value)); return;
      case SpecialType.UInt32: this.il.LdcI4(Convert.ToUInt32(value) as int); return;
      case SpecialType.Int64: this.il.LdcI8(Convert.ToInt64(value)); return;
      case SpecialType.UInt64: this.il.LdcI8(Convert.ToUInt64(value) as long); return;
      case SpecialType.Single: this.il.LdcR4(Convert.ToSingle(value)); return;
      case SpecialType.Double: this.il.LdcR8(Convert.ToDouble(value)); return;
      case SpecialType.IntPtr: this.il.LdcI4(Convert.ToInt32(value)); this.il.Op(ILOpCode.Conv_i, 0); return;
      case SpecialType.UIntPtr: this.il.LdcI4(Convert.ToUInt32(value) as int); this.il.Op(ILOpCode.Conv_u, 0); return;
      case SpecialType.String: this.il.LdStr(this.metadata.Metadata.GetOrAddUserString(value as string)); return;
      case SpecialType.Decimal: {
        const bits = Decimal.GetBits(Convert.ToDecimal(value));
        const ctor = this.FindConstructor(this.getSpecialType(SpecialType.Decimal), 5);
        this.il.LdcI4(bits[0]); this.il.LdcI4(bits[1]); this.il.LdcI4(bits[2]);
        this.il.LdcI4((bits[3] & (-2147483647 - 1)) != 0 ? 1 : 0);
        this.il.LdcI4((bits[3] >> 16) & 255);
        this.il.Call(ILOpCode.Newobj, this.metadata.GetMethodEntity(ctor), 5, 1); return;
      }
      case SpecialType.BigInteger: {
        let parse: MethodSymbol? = null;
        for (const member of this.getSpecialType(SpecialType.BigInteger).GetMembers("Parse")) {
          if (member instanceof MethodSymbol) {
            const candidate = member as MethodSymbol;
            if (candidate.IsStatic && candidate.Parameters.Length == 1 && candidate.Parameters[0].Type.SpecialType == SpecialType.String) {
              parse = candidate; break;
            }
          }
