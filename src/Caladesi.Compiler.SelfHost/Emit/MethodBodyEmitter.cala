  }
  private static IsUnsignedType(type: TypeSymbol): bool {
    const kind = type.SpecialType;
    return kind == SpecialType.UInt32 || kind == SpecialType.UInt64 || kind == SpecialType.UIntPtr
      || kind == SpecialType.Byte || kind == SpecialType.UInt16 || kind == SpecialType.Char;
  }
  private static IsFloatType(type: TypeSymbol): bool { return type.SpecialType == SpecialType.Single || type.SpecialType == SpecialType.Double; }
  private static IsNullLiteral(expression: BoundExpression): bool {
    return expression instanceof BoundLiteral && (expression as BoundLiteral).Value.IsNull;
  }
  private EmitBinary(binary: BoundBinary, used: bool): void {
    if ((binary.Kind == BinaryOperatorKind.Equal || binary.Kind == BinaryOperatorKind.NotEqual)
      && (MethodBodyEmitter.IsNullLiteral(binary.Right) || MethodBodyEmitter.IsNullLiteral(binary.Left))) {
      this.EmitNullCheck(MethodBodyEmitter.IsNullLiteral(binary.Right) ? binary.Left : binary.Right);
      if (binary.Kind == BinaryOperatorKind.NotEqual) { this.il.LdcI4(0); this.il.Op(ILOpCode.Ceq, -1); }
      this.Discard(used); return;
    }
    this.EmitExpression(binary.Left, true); this.EmitExpression(binary.Right, true);
    const type = binary.OperandType;
    const unsigned = MethodBodyEmitter.IsUnsignedType(type);
    const floating = MethodBodyEmitter.IsFloatType(type);
    switch (binary.Kind) {
      case BinaryOperatorKind.Add: this.il.Op(ILOpCode.Add, -1); break;
      case BinaryOperatorKind.Subtract: this.il.Op(ILOpCode.Sub, -1); break;
      case BinaryOperatorKind.Multiply: this.il.Op(ILOpCode.Mul, -1); break;
      case BinaryOperatorKind.Divide: this.il.Op(unsigned ? ILOpCode.Div_un : ILOpCode.Div, -1); break;
      case BinaryOperatorKind.Remainder: this.il.Op(unsigned ? ILOpCode.Rem_un : ILOpCode.Rem, -1); break;
      case BinaryOperatorKind.And: this.il.Op(ILOpCode.And, -1); break;
      case BinaryOperatorKind.Or: this.il.Op(ILOpCode.Or, -1); break;
      case BinaryOperatorKind.Xor: this.il.Op(ILOpCode.Xor, -1); break;
      case BinaryOperatorKind.ShiftLeft:
      case BinaryOperatorKind.ShiftRight:
      case BinaryOperatorKind.UnsignedShiftRight: {
        const mask = type.SpecialType == SpecialType.Int64 || type.SpecialType == SpecialType.UInt64 ? 63 : 31;
        const count = binary.Right.ConstantValue;
        if (count == null) { this.il.LdcI4(mask); this.il.Op(ILOpCode.And, -1); }
        else { this.il.Op(ILOpCode.Pop, -1); this.il.LdcI4(Convert.ToInt32(count.Value) & mask); }
        const op = binary.Kind == BinaryOperatorKind.ShiftLeft ? ILOpCode.Shl
          : binary.Kind == BinaryOperatorKind.UnsignedShiftRight ? ILOpCode.Shr_un : unsigned ? ILOpCode.Shr_un : ILOpCode.Shr;
        this.il.Op(op, -1); break;
      }
      case BinaryOperatorKind.Equal: this.il.Op(ILOpCode.Ceq, -1); break;
      case BinaryOperatorKind.NotEqual: this.il.Op(ILOpCode.Ceq, -1); this.il.LdcI4(0); this.il.Op(ILOpCode.Ceq, -1); break;
      case BinaryOperatorKind.LessThan: this.il.Op(unsigned ? ILOpCode.Clt_un : ILOpCode.Clt, -1); break;
      case BinaryOperatorKind.GreaterThan: this.il.Op(unsigned ? ILOpCode.Cgt_un : ILOpCode.Cgt, -1); break;
      case BinaryOperatorKind.LessThanOrEqual: this.il.Op(unsigned || floating ? ILOpCode.Cgt_un : ILOpCode.Cgt, -1); this.il.LdcI4(0); this.il.Op(ILOpCode.Ceq, -1); break;
      case BinaryOperatorKind.GreaterThanOrEqual: this.il.Op(unsigned || floating ? ILOpCode.Clt_un : ILOpCode.Clt, -1); this.il.LdcI4(0); this.il.Op(ILOpCode.Ceq, -1); break;
      default: throw new InvalidOperationException("Unhandled binary operator " + binary.Kind);
    }
    this.Discard(used);
  }
  private EmitNullCheck(subject: BoundExpression): void {
    const type = subject.Type!;
    if (MetadataEmitter.IsNullableValue(type)) {
      this.EmitAddress(subject);
      this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(this.FindMethod(this.metadata.ClrType(type) as NamedTypeSymbol, "get_HasValue")), 1, 1);
      this.il.LdcI4(0); this.il.Op(ILOpCode.Ceq, -1); return;
    }
    this.EmitExpression(subject, true);
    if (MetadataEmitter.IsValueTypeLike(this.metadata.ClrType(type)) || type.StripNullable() instanceof TypeParameterSymbol)
      this.il.Token(ILOpCode.Box, this.metadata.GetTypeEntity(type.StripNullable()), 0);
