      case SpecialType.SByte: op = ILOpCode.Ldelem_i1; break;
      case SpecialType.Byte:
      case SpecialType.Boolean: op = ILOpCode.Ldelem_u1; break;
      case SpecialType.Int16: op = ILOpCode.Ldelem_i2; break;
      case SpecialType.UInt16:
      case SpecialType.Char: op = ILOpCode.Ldelem_u2; break;
      case SpecialType.Int32: op = ILOpCode.Ldelem_i4; break;
      case SpecialType.UInt32: op = ILOpCode.Ldelem_u4; break;
      case SpecialType.Int64:
      case SpecialType.UInt64: op = ILOpCode.Ldelem_i8; break;
      case SpecialType.Single: op = ILOpCode.Ldelem_r4; break;
      case SpecialType.Double: op = ILOpCode.Ldelem_r8; break;
      case SpecialType.IntPtr:
      case SpecialType.UIntPtr: op = ILOpCode.Ldelem_i; break;
    }
    if (op != ILOpCode.Nop && type.TypeKind != TypeKind.Enum) { this.il.Op(op, -1); return; }
    if (!MetadataEmitter.IsValueTypeLike(type) && !(type instanceof TypeParameterSymbol)) { this.il.Op(ILOpCode.Ldelem_ref, -1); return; }
