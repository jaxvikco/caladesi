      this.EmitArguments(access.Arguments); this.EmitExpression(assignment.Value, true);
      const temp = this.PreserveAssignment(assignment.Value, used);
      if (constrained != null) { this.il.Encoder.OpCode(ILOpCode.Constrained); this.il.Encoder.Token(this.metadata.GetTypeEntity(constrained)); }
      const op = setter.IsStatic || access.IsBaseAccess ? ILOpCode.Call
