      case UnaryOperatorKind.Minus: this.il.Op(ILOpCode.Neg, 0); break;
      case UnaryOperatorKind.BitwiseNot: this.il.Op(ILOpCode.Not, 0); break;
      case UnaryOperatorKind.Not: this.il.LdcI4(0); this.il.Op(ILOpCode.Ceq, -1); break;
      case UnaryOperatorKind.Plus: break;
    }
