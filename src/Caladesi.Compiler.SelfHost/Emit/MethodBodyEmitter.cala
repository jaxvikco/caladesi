    } else this.il.Ldloc(info.Slot.Index);
  }
  private EmitTypeTest(test: BoundTypeTest, used: bool): void {
    if (test.Kind == TypeTestKind.UnionCase) {
      const union = this.metadata.ClrType(test.Operand.Type!) as NamedTypeSymbol;
      this.EmitFieldReceiver(test.Operand);
      this.il.Token(ILOpCode.Ldfld, this.metadata.GetFieldEntity(this.FindField(union, "Tag")), 0);
      this.il.LdcI4(test.CaseIndex + 1); this.il.Op(ILOpCode.Ceq, -1);
    } else {
      this.EmitExpression(test.Operand, true);
      const type = this.metadata.ClrType(test.Operand.Type!);
      if (MetadataEmitter.IsValueTypeLike(type) || type instanceof TypeParameterSymbol) this.il.Token(ILOpCode.Box, this.metadata.GetTypeEntity(type), 0);
      this.il.Token(ILOpCode.Isinst, this.metadata.GetTypeEntity(test.Target), 0);
      this.il.Op(ILOpCode.Ldnull, 1); this.il.Op(ILOpCode.Cgt_un, -1);
    }
    this.Discard(used);
  }
  private EmitDelegateCreation(creation: BoundDelegateCreation, used: bool): void {
    const method = creation.Method;
    if (creation.Receiver != null && (!method.IsStatic || method.IsExtensionMethod)) {
      const type = creation.Receiver.Type!;
      this.EmitExpression(creation.Receiver, true);
      if (!method.IsStatic && MetadataEmitter.IsValueTypeLike(this.metadata.ClrType(type))) this.il.Token(ILOpCode.Box, this.metadata.GetTypeEntity(type), 0);
    } else this.il.Op(ILOpCode.Ldnull, 1);
    const virtualCall = !method.IsStatic && (method.IsVirtual || method.IsAbstract || method.IsOverride) && creation.Receiver != null && !method.IsSealed;
    if (virtualCall) {
      this.il.Op(ILOpCode.Dup, 1); this.il.Encoder.OpCode(ILOpCode.Ldvirtftn); this.il.Encoder.Token(this.metadata.GetMethodEntity(method));
    } else {
      this.il.Encoder.OpCode(ILOpCode.Ldftn); this.il.Encoder.Token(this.metadata.GetMethodEntity(method));
      this.il.ResetDepth(this.il.CurrentDepth + 1);
    }
    const type = this.metadata.ClrType(creation.Type!) as NamedTypeSymbol;
    this.il.Call(ILOpCode.Newobj, this.metadata.GetMethodEntity(this.FindConstructor(type, 2)), 2, 1); this.Discard(used);
  }
  private EmitBranchIf(condition: BoundExpression, target: LabelHandle, jumpIfTrue: bool): void {
    const constant = condition.ConstantValue;
    if (constant != null && constant.Value instanceof bool) {
      if ((constant.Value as bool) == jumpIfTrue) this.il.Branch(ILOpCode.Br, target);
      return;
    }
    if (condition instanceof BoundUnary && (condition as BoundUnary).Kind == UnaryOperatorKind.Not) {
      this.EmitBranchIf((condition as BoundUnary).Operand, target, !jumpIfTrue); return;
    }
    if (condition instanceof BoundLogicalBinary) {
      const logical = condition as BoundLogicalBinary;
      if (logical.IsAnd == jumpIfTrue) {
        const skip = this.il.NewLabel();
        this.EmitBranchIf(logical.Left, skip, !jumpIfTrue);
        this.EmitBranchIf(logical.Right, target, jumpIfTrue); this.il.Mark(skip);
      } else {
        this.EmitBranchIf(logical.Left, target, jumpIfTrue); this.EmitBranchIf(logical.Right, target, jumpIfTrue);
      }
      return;
    }
    if (condition instanceof BoundBinary && MethodBodyEmitter.IsDirectBranchable(condition as BoundBinary)) {
      const binary = condition as BoundBinary;
      this.EmitExpression(binary.Left, true); this.EmitExpression(binary.Right, true);
      const unsigned = MethodBodyEmitter.IsUnsignedType(binary.OperandType);
      let op: ILOpCode;
      if (jumpIfTrue) {
        switch (binary.Kind) {
          case BinaryOperatorKind.Equal: op = ILOpCode.Beq; break;
          case BinaryOperatorKind.NotEqual: op = ILOpCode.Bne_un; break;
          case BinaryOperatorKind.LessThan: op = unsigned ? ILOpCode.Blt_un : ILOpCode.Blt; break;
          case BinaryOperatorKind.LessThanOrEqual: op = unsigned ? ILOpCode.Ble_un : ILOpCode.Ble; break;
          case BinaryOperatorKind.GreaterThan: op = unsigned ? ILOpCode.Bgt_un : ILOpCode.Bgt; break;
          default: op = unsigned ? ILOpCode.Bge_un : ILOpCode.Bge; break;
        }
      } else {
        switch (binary.Kind) {
          case BinaryOperatorKind.Equal: op = ILOpCode.Bne_un; break;
          case BinaryOperatorKind.NotEqual: op = ILOpCode.Beq; break;
          case BinaryOperatorKind.LessThan: op = unsigned ? ILOpCode.Bge_un : ILOpCode.Bge; break;
          case BinaryOperatorKind.LessThanOrEqual: op = unsigned ? ILOpCode.Bgt_un : ILOpCode.Bgt; break;
          case BinaryOperatorKind.GreaterThan: op = unsigned ? ILOpCode.Ble_un : ILOpCode.Ble; break;
          default: op = unsigned ? ILOpCode.Blt_un : ILOpCode.Blt; break;
        }
      }
      this.il.Branch(op, target); return;
    }
    this.EmitExpression(condition, true); this.il.Branch(jumpIfTrue ? ILOpCode.Brtrue : ILOpCode.Brfalse, target);
  }
  private static IsDirectBranchable(binary: BoundBinary): bool {
    switch (binary.Kind) {
      case BinaryOperatorKind.Equal:
      case BinaryOperatorKind.NotEqual:
      case BinaryOperatorKind.LessThan:
      case BinaryOperatorKind.LessThanOrEqual:
      case BinaryOperatorKind.GreaterThan:
      case BinaryOperatorKind.GreaterThanOrEqual: break;
      default: return false;
    }
    if (MethodBodyEmitter.IsNullLiteral(binary.Right) || MethodBodyEmitter.IsNullLiteral(binary.Left)) return false;
    const type = binary.OperandType;
    if (MethodBodyEmitter.IsFloatType(type)) return false;
    switch (type.SpecialType) {
      case SpecialType.Int32:
      case SpecialType.Int64:
      case SpecialType.UInt32:
      case SpecialType.UInt64:
      case SpecialType.Char:
      case SpecialType.Boolean:
      case SpecialType.Int16:
      case SpecialType.UInt16:
      case SpecialType.Byte:
      case SpecialType.SByte: return true;
      default: return false;
    }
  }

  private EmitConversion(conversion: BoundConversion, used: bool): void {
    const from = conversion.Operand.Type!;
    const to = conversion.Type!;
    switch (conversion.Kind) {
      case ConversionKind.Identity:
      case ConversionKind.TypeOnly:
      case ConversionKind.ImplicitReference: this.EmitExpression(conversion.Operand, used); return;
      case ConversionKind.NullLiteral: if (used) this.EmitDefault(to); return;
      case ConversionKind.ImplicitNumeric:
      case ConversionKind.ExplicitNumeric:
      case ConversionKind.EnumNumeric: this.EmitExpression(conversion.Operand, true); this.EmitNumericConversion(from, to); break;
      case ConversionKind.ToNullable:
        this.EmitExpression(conversion.Operand, true);
        if (MetadataEmitter.IsNullableValue(to))
          this.il.Call(ILOpCode.Newobj, this.metadata.GetMethodEntity(this.FindConstructor(this.metadata.ClrType(to) as NamedTypeSymbol, 1)), 1, 1);
        break;
      case ConversionKind.FromNullable:
        if (MetadataEmitter.IsNullableValue(from)) {
          this.EmitAddress(conversion.Operand);
          this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(this.FindMethod(this.metadata.ClrType(from) as NamedTypeSymbol, "get_Value")), 1, 1);
        } else this.EmitExpression(conversion.Operand, true);
        break;
      case ConversionKind.Boxing:
        this.EmitExpression(conversion.Operand, true);
        if (MetadataEmitter.IsValueTypeLike(this.metadata.ClrType(from)) || from.StripNullable() instanceof TypeParameterSymbol || MetadataEmitter.IsNullableValue(from))
          this.il.Token(ILOpCode.Box, this.metadata.GetTypeEntity(from.StripNullable() instanceof TypeParameterSymbol ? from.StripNullable() : from), 0);
        break;
      case ConversionKind.Unboxing:
        this.EmitExpression(conversion.Operand, true); this.il.Token(ILOpCode.Unbox_any, this.metadata.GetTypeEntity(to), 0); break;
      case ConversionKind.ExplicitReference:
        this.EmitExpression(conversion.Operand, true);
        if (from instanceof TypeParameterSymbol) this.il.Token(ILOpCode.Box, this.metadata.GetTypeEntity(from), 0);
        this.il.Token(to instanceof TypeParameterSymbol || MetadataEmitter.IsValueTypeLike(this.metadata.ClrType(to)) ? ILOpCode.Unbox_any : ILOpCode.Castclass,
          this.metadata.GetTypeEntity(to), 0); break;
      case ConversionKind.TypeParameter: this.EmitExpression(conversion.Operand, true); break;
      case ConversionKind.UserDefined:
        this.EmitExpression(conversion.Operand, true); this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(conversion.Method!), 1, 1); break;
      case ConversionKind.UnionWrap: this.EmitUnionWrap(conversion); break;
      case ConversionKind.UnionExtract: {
        const union = this.metadata.ClrType(from.StripNullable()) as NamedTypeSymbol;
        this.EmitFieldReceiver(conversion.Operand);
        this.il.Token(ILOpCode.Ldfld, this.metadata.GetFieldEntity(this.FindField(union, "Value")), 0);
        const target = this.metadata.ClrType(to);
        this.il.Token(MetadataEmitter.IsValueTypeLike(target) || target instanceof TypeParameterSymbol ? ILOpCode.Unbox_any : ILOpCode.Castclass,
          this.metadata.GetTypeEntity(target), 0); break;
      }
      case ConversionKind.LiftedNumeric: this.EmitLiftedNumeric(conversion); break;
      default: throw new InvalidOperationException("Unhandled conversion " + conversion.Kind);
    }
    this.Discard(used);
  }
  private EmitUnionWrap(conversion: BoundConversion): void {
    const union = this.metadata.ClrType(conversion.Type!.StripNullable()) as NamedTypeSymbol;
    const from = conversion.Operand.Type!;
    const stripped = from.StripNullable();
    if (conversion.CaseIndex == -3 || (stripped instanceof NamedTypeSymbol && (stripped as NamedTypeSymbol).IsUnionType && !stripped.Equals(union))) {
      this.EmitUnionToUnion(conversion, union); return;
    }
    this.EmitExpression(conversion.Operand, true);
    const cases = union.UnionCases;
    const validCase = conversion.CaseIndex >= 0 && conversion.CaseIndex < cases.Length;
    const caseType = validCase ? cases[conversion.CaseIndex] : from;
    if (validCase && !from.Equals(caseType) && MethodBodyEmitter.IsNumericKind(from) && MethodBodyEmitter.IsNumericKind(caseType))
      this.EmitNumericConversion(from, caseType);
    this.il.Call(ILOpCode.Newobj, this.metadata.GetMethodEntity(this.FindCaseConstructor(union, caseType)), 1, 1);
  }
  private EmitUnionToUnion(conversion: BoundConversion, target: NamedTypeSymbol): void {
    const source = this.metadata.ClrType(conversion.Operand.Type!.StripNullable()) as NamedTypeSymbol;
    const temp = this.TempLocal(source);
    this.EmitExpression(conversion.Operand, true); this.il.Stloc(temp.Index);
    const end = this.il.NewLabel();
    const tag = this.FindField(source, "Tag");
    const value = this.FindField(source, "Value");
    const sourceCases = source.UnionCases;
    const targetCases = target.UnionCases;
    for (let i = 0; i < sourceCases.Length; i++) {
      const next = this.il.NewLabel();
      this.il.Ldloca(temp.Index); this.il.Token(ILOpCode.Ldfld, this.metadata.GetFieldEntity(tag), 0);
      this.il.LdcI4(i + 1); this.il.Branch(ILOpCode.Bne_un, next);
      let index = -1;
      for (let j = 0; j < targetCases.Length; j++) if (targetCases[j].Equals(sourceCases[i])) { index = j; break; }
      if (index < 0)
        for (let j = 0; j < targetCases.Length; j++) if (MethodBodyEmitter.ImplicitRef(sourceCases[i], targetCases[j])) { index = j; break; }
      if (index < 0) index = 0;
      this.il.Ldloca(temp.Index); this.il.Token(ILOpCode.Ldfld, this.metadata.GetFieldEntity(value), 0);
      const sourceType = this.metadata.ClrType(sourceCases[i]);
      this.il.Token(MetadataEmitter.IsValueTypeLike(sourceType) || sourceType instanceof TypeParameterSymbol ? ILOpCode.Unbox_any : ILOpCode.Castclass,
        this.metadata.GetTypeEntity(sourceType), 0);
      this.il.Call(ILOpCode.Newobj, this.metadata.GetMethodEntity(this.FindCaseConstructor(target, targetCases[index])), 1, 1);
      this.il.Branch(ILOpCode.Br, end); this.il.Mark(next);
    }
    this.EmitDefault(target); this.il.Mark(end);
  }
  private static ImplicitRef(from: TypeSymbol, to: TypeSymbol): bool {
    let parent = from.BaseType;
    while (parent != null) { if (parent.Equals(to)) return true; parent = parent.BaseType; }
    for (const implemented of from.AllInterfaces) if (implemented.Equals(to)) return true;
    return to.SpecialType == SpecialType.Object;
  }
  private static IsNumericKind(type: TypeSymbol): bool {
    return !(type instanceof NullableTypeSymbol) && (SpecialTypes.IsNumeric(type.SpecialType) || type.SpecialType == SpecialType.Decimal);
  }
  private EmitLiftedNumeric(conversion: BoundConversion): void {
    const from = conversion.Operand.Type! as NullableTypeSymbol;
    const to = conversion.Type! as NullableTypeSymbol;
    const nullable = this.metadata.ClrType(from) as NamedTypeSymbol;
    const temp = this.TempLocal(from);
    this.EmitExpression(conversion.Operand, true); this.il.Stloc(temp.Index);
    const isNull = this.il.NewLabel();
    const end = this.il.NewLabel();
    this.il.Ldloca(temp.Index);
    this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(this.FindMethod(nullable, "get_HasValue")), 1, 1);
    this.il.Branch(ILOpCode.Brfalse, isNull); this.il.Ldloca(temp.Index);
    this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(this.FindMethodWithArity(nullable, "GetValueOrDefault", 0)), 1, 1);
    this.EmitNumericConversion(from.Underlying, to.Underlying);
    this.il.Call(ILOpCode.Newobj, this.metadata.GetMethodEntity(this.FindConstructor(this.metadata.ClrType(to) as NamedTypeSymbol, 1)), 1, 1);
    this.il.Branch(ILOpCode.Br, end); this.il.Mark(isNull); this.EmitDefault(to); this.il.Mark(end);
  }
  private static Underlying(type: TypeSymbol): SpecialType {
    return type.TypeKind == TypeKind.Enum ? (type as NamedTypeSymbol).EnumUnderlyingType!.SpecialType : type.SpecialType;
  }
  private EmitNumericConversion(fromType: TypeSymbol, toType: TypeSymbol): void {
    const from = MethodBodyEmitter.Underlying(fromType);
    const to = MethodBodyEmitter.Underlying(toType);
    if (from == to) return;
    if (from == SpecialType.Decimal || to == SpecialType.Decimal) {
      const decimalType = this.getSpecialType(SpecialType.Decimal);
      this.getSpecialType(from); this.getSpecialType(to);
      const name = from == SpecialType.Decimal || from == SpecialType.Single || from == SpecialType.Double ? "op_Explicit" : "op_Implicit";
      let method: MethodSymbol? = null;
      for (const member of decimalType.GetMembers(name)) {
        if (member instanceof MethodSymbol) {
          const candidate = member as MethodSymbol;
          if (candidate.Parameters.Length == 1 && candidate.Parameters[0].Type.SpecialType == from && candidate.ReturnType.SpecialType == to) {
            method = candidate; break;
          }
        }
      }
      if (method == null) {
        this.EmitNumericConversion(fromType, this.getSpecialType(SpecialType.Int32));
        this.EmitNumericConversion(this.getSpecialType(SpecialType.Int32), toType); return;
      }
      this.il.Call(ILOpCode.Call, this.metadata.GetMethodEntity(method), 1, 1); return;
    }
    const unsignedFrom = from == SpecialType.Byte || from == SpecialType.UInt16 || from == SpecialType.Char
      || from == SpecialType.UInt32 || from == SpecialType.UInt64 || from == SpecialType.UIntPtr;
    switch (to) {
      case SpecialType.SByte: this.il.Op(ILOpCode.Conv_i1, 0); break;
      case SpecialType.Byte: this.il.Op(ILOpCode.Conv_u1, 0); break;
      case SpecialType.Int16: this.il.Op(ILOpCode.Conv_i2, 0); break;
      case SpecialType.UInt16:
      case SpecialType.Char: this.il.Op(ILOpCode.Conv_u2, 0); break;
      case SpecialType.Int32:
        if (from == SpecialType.Int64 || from == SpecialType.UInt64 || from == SpecialType.Single || from == SpecialType.Double
          || from == SpecialType.UInt32 || from == SpecialType.IntPtr || from == SpecialType.UIntPtr) this.il.Op(ILOpCode.Conv_i4, 0);
        break;
      case SpecialType.UInt32:
        if (from != SpecialType.Byte && from != SpecialType.UInt16 && from != SpecialType.Char) this.il.Op(ILOpCode.Conv_u4, 0);
        break;
      case SpecialType.Int64:
        this.il.Op(from == SpecialType.UInt32 || from == SpecialType.UInt16 || from == SpecialType.Byte || from == SpecialType.Char || from == SpecialType.UIntPtr
          ? ILOpCode.Conv_u8 : ILOpCode.Conv_i8, 0); break;
      case SpecialType.UInt64:
        this.il.Op(unsignedFrom || from == SpecialType.Single || from == SpecialType.Double ? ILOpCode.Conv_u8 : ILOpCode.Conv_i8, 0); break;
      case SpecialType.Single:
        if (unsignedFrom) this.il.Op(ILOpCode.Conv_r_un, 0);
        this.il.Op(ILOpCode.Conv_r4, 0); break;
      case SpecialType.Double:
        if (unsignedFrom) this.il.Op(ILOpCode.Conv_r_un, 0);
        this.il.Op(ILOpCode.Conv_r8, 0); break;
      case SpecialType.IntPtr: this.il.Op(unsignedFrom ? ILOpCode.Conv_u : ILOpCode.Conv_i, 0); break;
      case SpecialType.UIntPtr: this.il.Op(ILOpCode.Conv_u, 0); break;
    }
  }
}
