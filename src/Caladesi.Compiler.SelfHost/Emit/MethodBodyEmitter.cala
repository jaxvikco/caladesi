      case SpecialType.Byte:
      case SpecialType.Boolean: op = ILOpCode.Stelem_i1; break;
      case SpecialType.Int16:
      case SpecialType.UInt16:
      case SpecialType.Char: op = ILOpCode.Stelem_i2; break;
      case SpecialType.Int32:
      case SpecialType.UInt32: op = ILOpCode.Stelem_i4; break;
      case SpecialType.Int64:
      case SpecialType.UInt64: op = ILOpCode.Stelem_i8; break;
      case SpecialType.Single: op = ILOpCode.Stelem_r4; break;
      case SpecialType.Double: op = ILOpCode.Stelem_r8; break;
      case SpecialType.IntPtr:
      case SpecialType.UIntPtr: op = ILOpCode.Stelem_i; break;
    }
    if (op != ILOpCode.Nop && type.TypeKind != TypeKind.Enum) { this.il.Op(op, -3); return; }
    if (!MetadataEmitter.IsValueTypeLike(type) && !(type instanceof TypeParameterSymbol)) { this.il.Op(ILOpCode.Stelem_ref, -3); return; }
