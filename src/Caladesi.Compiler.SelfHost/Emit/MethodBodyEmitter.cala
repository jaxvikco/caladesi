    else if (instance) this.il.Ldarg(0);
    this.EmitArguments(arguments);
    let op: ILOpCode;
    if (!instance || method.MethodKind == MethodKind.Constructor || isBase) op = ILOpCode.Call;
    else if (constrained != null) op = ILOpCode.Callvirt;
