    } else {
      this.EmitExpression(coalesce.Left, true); this.il.Op(ILOpCode.Dup, 1);
      if (type.StripNullable() instanceof TypeParameterSymbol) this.il.Token(ILOpCode.Box, this.metadata.GetTypeEntity(type.StripNullable()), 0);
      this.il.Branch(ILOpCode.Brtrue, end); this.il.Op(ILOpCode.Pop, -1);
      this.EmitExpression(coalesce.Right, true); this.il.Mark(end);
