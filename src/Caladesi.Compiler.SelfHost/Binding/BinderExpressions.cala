  ConstantValue } from "../Symbols/MemberSymbols";
import { SourceFieldSymbol, SourcePropertySymbol } from "../Symbols/Source/SourceMembers";
import { TypeAliasSymbol } from "../Symbols/Source/SourceTypes";
import { SourceUnionSymbol, SourceLiteralEnumSymbol } from "../Symbols/Source/SourceTypeAliasTypes";
import { SpecialType, SpecialTypes } from "../Symbols/SpecialType";
import { SyntaxNode, SeparatedSyntaxList } from "../Syntax/SyntaxElement";
import { SyntaxKind } from "../Syntax/SyntaxKind";
import { ExpressionSyntax, TypeSyntax, SimpleNameSyntax, IdentifierNameSyntax, GenericNameSyntax,
  TypeArgumentListSyntax, LiteralExpressionSyntax, TemplateExpressionSyntax, ThisExpressionSyntax,
  SuperExpressionSyntax, ParenthesizedExpressionSyntax, ArrayLiteralExpressionSyntax,
  ObjectLiteralExpressionSyntax, ArrowFunctionSyntax, FunctionExpressionSyntax,
  PrefixUnaryExpressionSyntax, PostfixUnaryExpressionSyntax, AwaitExpressionSyntax,
  ThrowExpressionSyntax, TypeOfExpressionSyntax, YieldExpressionSyntax, BinaryExpressionSyntax,
  AssignmentExpressionSyntax, ConditionalExpressionSyntax, InvocationExpressionSyntax,
  NewExpressionSyntax, ArrayCreationExpressionSyntax, MemberAccessExpressionSyntax,
  ElementAccessExpressionSyntax, NonNullExpressionSyntax, AsExpressionSyntax,
  SatisfiesExpressionSyntax, InstanceOfExpressionSyntax, SpreadElementSyntax, MissingExpressionSyntax,
  ParameterListSyntax, BlockSyntax, PropertyAssignmentSyntax, ShorthandPropertyAssignmentSyntax,
  SpreadAssignmentSyntax, VariableDeclaratorSyntax, BindingPatternSyntax } from "../Syntax/Nodes.Core";
import { Descriptors } from "../Diagnostics/Descriptors";
import { BoundNode, BoundExpression, BoundBadExpression, BoundLiteral, BoundLocal, BoundParameter,
  BoundThis, BoundBaseReference, BoundFieldAccess, BoundPropertyAccess, BoundCall,
  BoundMemberInit, BoundObjectCreation, BoundDefaultValue, BoundArrayCreation, BoundArrayAccess,
  BoundConversion, ConversionKind, BoundUnary, UnaryOperatorKind, BoundBinary, BinaryOperatorKind,
  BoundLogicalBinary, BoundAssignment, BoundConditional, BoundCoalesce, BoundConditionalReceiver,
  BoundConditionalAccess, BoundTypeTest, TypeTestKind, BoundLambda, BoundDelegateCreation,
  BoundSequence, BoundAddressOf, BoundTypeOf, AwaitInfo, BoundAwait, BoundThrowExpression,
  BoundTypeExpression, BoundNamespaceExpression, BoundMethodGroup, BoundUnbound,
  BoundStatement, BoundBlock, BoundExpressionStatement, BoundLocalDeclaration } from "../Bound/BoundNodes";
import { LambdaInfo, CollectionInfo, ObjectLiteralInfo } from "../Bound/UnboundInfo";
import { BinderExpressionLiterals } from "./BinderExpressionLiterals";
import { BinderExpressionLambdas } from "./BinderExpressionLambdas";

// A module receiver deliberately has no value type; only name lookup consumes it.
export sealed class BinderExpressionModule<TFile> extends BoundExpression {
  constructor(public readonly File: TFile) { super(null); }
}

class BinderAssignmentBinding<TFile> {
  constructor(private readonly binder: Binder<TFile>, private readonly expressions: BinderExpressions<TFile>,
    private readonly syntax: AssignmentExpressionSyntax, private readonly type: TypeSymbol,
    private readonly right: BoundExpression?, private readonly kind: BinaryOperatorKind?) {}
  Coalesce(read: BoundExpression): BoundExpression {
    const rhs = this.expressions.Convert(this.binder.BindValue(this.syntax.Right, this.type.StripNullable()), this.type, this.syntax.Right);
    return this.expressions.At(new BoundCoalesce(read, rhs, this.type), this.syntax);
  }
  Logical(read: BoundExpression): BoundExpression {
    return this.expressions.At(new BoundLogicalBinary(
      this.syntax.OperatorToken.Kind == SyntaxKind.AmpersandAmpersandEqualsToken,
      this.binder.Conversions.ConvertToBool(read, this.syntax.Left),
      this.binder.Conversions.ConvertToBool(this.binder.BindValue(this.syntax.Right), this.syntax.Right),
      this.binder.BoolType), this.syntax);
  }
  Arithmetic(read: BoundExpression): BoundExpression {
    const value = this.syntax.OperatorToken.Kind == SyntaxKind.AsteriskAsteriskEqualsToken ?
      this.expressions.Power(this.syntax, read, this.right!) :
      this.expressions.Arithmetic(this.syntax, this.kind as BinaryOperatorKind, read, this.right!);
    if (value.HasErrors || value.Type == null) return value;
    if (this.binder.Classifier.ClassifyImplicit(value, value.Type, this.type).Exists)
      return this.expressions.Convert(value, this.type, this.syntax);
    if (SpecialTypes.IsNumeric(value.Type!.StripNullable().SpecialType) && SpecialTypes.IsNumeric(this.type.StripNullable().SpecialType))
      return this.binder.Conversions.ConvertExplicit(value, this.type, this.syntax);
    this.binder.Report(Descriptors.NotAssignable, this.syntax, [value.Type!.ToDisplayString(), this.type.ToDisplayString()]);
    return this.expressions.Bad(this.syntax, value);
  }
}
class BinderIncrementBinding<TFile> {
  constructor(private readonly binder: Binder<TFile>, private readonly expressions: BinderExpressions<TFile>,
    private readonly type: TypeSymbol, private readonly special: SpecialType,
    private readonly increment: bool, private readonly at: SyntaxNode) {}
  Compute(read: BoundExpression): BoundExpression {
    const oneType = this.special == SpecialType.BigInteger || this.special == SpecialType.Decimal ||
      SpecialTypes.IsFloating(this.special) ? this.type : this.binder.IntType;
    const one = this.expressions.Convert(this.binder.Literal(1, this.binder.IntType, this.at), oneType, this.at);
    const value = this.expressions.Arithmetic(this.at, this.increment ? BinaryOperatorKind.Add : BinaryOperatorKind.Subtract, read, one);
    if (value.HasErrors || value.Type!.Equals(this.type)) return value;
    return this.binder.Conversions.ConvertExplicit(value, this.type, this.at);
  }
}

export sealed class BinderExpressions<TFile> {
  UsesThis: bool = false;
  constructor(private readonly binder: Binder<TFile>) {}

  Bind(syntax: ExpressionSyntax): BoundExpression { return this.Bind(syntax, null); }
  Bind(syntax: ExpressionSyntax, target: TypeSymbol?): BoundExpression {
    let result = this.BindCore(syntax, target);
    if (target != null && !target.IsErrorType && result instanceof BoundUnbound) {
      const bound = (result as BoundUnbound).BindToType.Invoke(target);
      if (!(bound instanceof BoundUnbound)) result = bound;
    }
    if (result.Syntax == null) result.Syntax = syntax;
    return result;
  }
  BindDestructuringDeclaration(syntax: VariableDeclaratorSyntax, isConst: bool): BoundStatement {
    return new BinderExpressionLiterals<TFile>(this.binder, this).DestructuringDeclaration(syntax, isConst);
  }
  BindDestructuringFrom(pattern: BindingPatternSyntax, source: BoundExpression, type: TypeSymbol,
    isConst: bool, at: SyntaxNode): BoundStatement {
    return new BinderExpressionLiterals<TFile>(this.binder, this).DestructuringFrom(pattern, source, type, isConst, at);
  }
  GetIterationType(type: TypeSymbol, isAsync: bool = false): TypeSymbol? {
    return new BinderExpressionLiterals<TFile>(this.binder, this).IterationType(type, isAsync);
  }
  static HasNaturalType(value: BoundUnbound): bool {
    if (!value.IsLambda) return true;
    const info = value.Lambda;
    if (info == null || info.IsGenerator) return false;
    for (const type of info.ExplicitParameterTypes) if (type == null) return false;
    return true;
  }

  private BindCore(syntax: ExpressionSyntax, target: TypeSymbol?): BoundExpression {
    if (syntax instanceof LiteralExpressionSyntax) return this.BindLiteral(syntax as LiteralExpressionSyntax);
    if (syntax instanceof TemplateExpressionSyntax) return this.BindTemplate(syntax as TemplateExpressionSyntax);
    if (syntax instanceof IdentifierNameSyntax) {
      const identifier = syntax as IdentifierNameSyntax;
      return identifier.Identifier.IsMissing ? this.Bad(syntax) :
        this.BindName(identifier.Name, ImmutableArray<TypeSymbol>.Empty, syntax);
    }
    if (syntax instanceof GenericNameSyntax) {
      const generic = syntax as GenericNameSyntax;
      return this.BindName(generic.Name, this.BindTypeArguments(generic.TypeArguments), syntax);
    }
    if (syntax instanceof ThisExpressionSyntax) return this.ImplicitThis(syntax);
    if (syntax instanceof SuperExpressionSyntax) {
      this.binder.Report(Descriptors.SuperNotAllowedHere, syntax, []);
      return this.Bad(syntax);
    }
    if (syntax instanceof ParenthesizedExpressionSyntax)
      return this.binder.BindExpression((syntax as ParenthesizedExpressionSyntax).Expression, target);
    if (syntax instanceof ArrayLiteralExpressionSyntax)
      return new BinderExpressionLiterals<TFile>(this.binder, this).Collection(syntax as ArrayLiteralExpressionSyntax, target);
    if (syntax instanceof ObjectLiteralExpressionSyntax)
      return new BinderExpressionLiterals<TFile>(this.binder, this).Object(syntax as ObjectLiteralExpressionSyntax);
    if (syntax instanceof ArrowFunctionSyntax)
      return new BinderExpressionLambdas<TFile>(this.binder, this).Arrow(syntax as ArrowFunctionSyntax);
    if (syntax instanceof FunctionExpressionSyntax)
      return new BinderExpressionLambdas<TFile>(this.binder, this).Function(syntax as FunctionExpressionSyntax);
    if (syntax instanceof PrefixUnaryExpressionSyntax) return this.BindPrefix(syntax as PrefixUnaryExpressionSyntax);
    if (syntax instanceof PostfixUnaryExpressionSyntax) {
      const postfix = syntax as PostfixUnaryExpressionSyntax;
      return this.Increment(postfix.Operand, postfix.OperatorToken.Kind == SyntaxKind.PlusPlusToken, false, syntax);
    }
    if (syntax instanceof AwaitExpressionSyntax) return this.BindAwait(syntax as AwaitExpressionSyntax);
    if (syntax instanceof ThrowExpressionSyntax) {
      const value = this.binder.BindToType((syntax as ThrowExpressionSyntax).Operand, this.binder.Special(SpecialType.Exception));
      return value.HasErrors ? this.Bad(syntax, value) : this.At(new BoundThrowExpression(value, NeverTypeSymbol.Instance), syntax);
    }
    if (syntax instanceof TypeOfExpressionSyntax)
      return this.At(new BoundTypeOf(this.binder.BindType((syntax as TypeOfExpressionSyntax).Type),
        this.binder.Special(SpecialType.Type)), syntax);
    if (syntax instanceof YieldExpressionSyntax) {
      this.binder.Report(Descriptors.YieldNotAllowedHere, syntax, []);
      return this.Bad(syntax);
    }
    if (syntax instanceof BinaryExpressionSyntax) return this.BindBinary(syntax as BinaryExpressionSyntax, target);
    if (syntax instanceof AssignmentExpressionSyntax) return this.BindAssignment(syntax as AssignmentExpressionSyntax);
    if (syntax instanceof ConditionalExpressionSyntax) return this.BindConditional(syntax as ConditionalExpressionSyntax, target);
    if (syntax instanceof InvocationExpressionSyntax) return this.BindInvocation(syntax as InvocationExpressionSyntax, target);
    if (syntax instanceof NewExpressionSyntax) return this.BindNew(syntax as NewExpressionSyntax, target);
    if (syntax instanceof ArrayCreationExpressionSyntax) {
      const array = syntax as ArrayCreationExpressionSyntax;
      const element = this.binder.BindType(array.ElementType);
      const size = this.ConvertIndex(this.binder.BindValue(array.Size), array.Size);
      return element.IsErrorType ? this.Bad(syntax, size) :
        this.At(new BoundArrayCreation(this.binder.Context.CreateArrayType(element), size,
          ImmutableArray<BoundExpression>.Empty), syntax);
    }
    if (syntax instanceof MemberAccessExpressionSyntax) return this.BindMemberAccess(syntax as MemberAccessExpressionSyntax);
    if (syntax instanceof ElementAccessExpressionSyntax) return this.BindElementAccess(syntax as ElementAccessExpressionSyntax);
    if (syntax instanceof NonNullExpressionSyntax) {
      const value = this.binder.BindValue((syntax as NonNullExpressionSyntax).Expression);
      return value.Type instanceof NullableTypeSymbol ?
        this.At(new BoundConversion(value, ConversionKind.FromNullable, (value.Type as NullableTypeSymbol).Underlying), syntax) : value;
    }
    if (syntax instanceof AsExpressionSyntax) {
      const cast = syntax as AsExpressionSyntax;
      const type = this.binder.BindType(cast.Type);
      const value = this.binder.BindValue(cast.Expression, type);
      return type.IsErrorType ? this.Bad(syntax, value) :
        this.binder.Conversions.ConvertExplicit(value, type, syntax);
    }
    if (syntax instanceof SatisfiesExpressionSyntax) {
      const satisfies = syntax as SatisfiesExpressionSyntax;
      const type = this.binder.BindType(satisfies.Type);
      const value = this.binder.BindValue(satisfies.Expression, type);
      if (type.IsErrorType) return value;
      const converted = this.binder.Conversions.ConvertImplicit(value, type, syntax);
      return value instanceof BoundUnbound ? converted : value;
    }
    if (syntax instanceof InstanceOfExpressionSyntax) return this.BindInstanceOf(syntax as InstanceOfExpressionSyntax);
    if (syntax instanceof SpreadElementSyntax) {
      this.binder.Report(Descriptors.SpreadNotAllowedHere, syntax, []);
      return this.Bad(syntax);
    }
    if (syntax instanceof TypeSyntax) return this.At(new BoundTypeExpression(this.binder.BindType(syntax as TypeSyntax)), syntax);
    return this.Bad(syntax);
  }

  At<T extends BoundNode>(node: T, syntax: SyntaxNode?): T {
    node.Syntax = syntax;
    return node;
  }
    private BindMemberAccess(syntax: MemberAccessExpressionSyntax): BoundExpression {
      let left: BoundExpression;
      if (syntax.Expression instanceof SuperExpressionSyntax) {
        const current = this.binder.CurrentType;
        if (current == null || current.BaseType == null || this.StaticContext) {
          this.binder.Report(Descriptors.SuperNotAllowedHere, syntax, []);
          return this.Bad(syntax);
        }
        this.UsesThis = true;
        left = this.At(new BoundBaseReference(current.BaseType), syntax.Expression);
        const access = this.BindMemberOf(left, syntax.Name, syntax);
        if (access instanceof BoundMethodGroup) (access as BoundMethodGroup).IsBaseAccess = true;
        if (access instanceof BoundPropertyAccess) (access as BoundPropertyAccess).IsBaseAccess = true;
        return access;
      }
      left = this.Natural(this.binder.BindExpression(syntax.Expression), syntax.Expression);
      if (left.HasErrors) return this.Bad(syntax, left);
      if (left instanceof BoundConditionalAccess && !(syntax.Expression instanceof ParenthesizedExpressionSyntax)) {
        const chain = left as BoundConditionalAccess;
        const inner = syntax.IsConditional ? this.ConditionalMember(chain.WhenNotNull, syntax) :
          this.BindMemberOf(chain.WhenNotNull, syntax.Name, syntax);
        return this.MakeConditional(chain.Receiver, chain.Placeholder, inner, syntax);
      }
      return syntax.IsConditional ? this.ConditionalMember(left, syntax) : this.BindMemberOf(left, syntax.Name, syntax);
    }
    private ConditionalMember(left: BoundExpression, syntax: MemberAccessExpressionSyntax): BoundExpression {
      if (left.Type == null || left instanceof BoundTypeExpression || left instanceof BoundMethodGroup) {
        this.binder.Report(Descriptors.ConditionalOnNonValue, syntax, []);
        return this.Bad(syntax, left);
      }
      if (left.Type.IsValueType && !(left.Type instanceof NullableTypeSymbol))
        return this.BindMemberOf(left, syntax.Name, syntax);
      const placeholder = this.At(new BoundConditionalReceiver(left.Type.StripNullable()), syntax.Expression);
      return this.MakeConditional(left, placeholder, this.BindMemberOf(placeholder, syntax.Name, syntax), syntax);
    }
    MakeConditional(receiver: BoundExpression, placeholder: BoundConditionalReceiver,
      inner: BoundExpression, syntax: SyntaxNode): BoundExpression {
      if (inner.HasErrors) return this.Bad(syntax, inner);
      let type = inner.Type;
      if (type != null && !type.IsVoid && !type.IsNeverType && !(type instanceof NullableTypeSymbol))
        type = new NullableTypeSymbol(type);
      return this.At(new BoundConditionalAccess(receiver, placeholder, inner, type), syntax);
    }
    BindMemberOf(left: BoundExpression, name: SimpleNameSyntax, syntax: SyntaxNode): BoundExpression {
      if (name.Identifier.IsMissing) return this.Bad(syntax, left);
      const args = name instanceof GenericNameSyntax ? this.BindTypeArguments((name as GenericNameSyntax).TypeArguments) :
        ImmutableArray<TypeSymbol>.Empty;
      if (left instanceof BinderExpressionModule<TFile>) {
        const exports = this.binder.Context.GetScope((left as BinderExpressionModule<TFile>).File).GetExports(name.Name);
        return this.BindSymbols(exports, name.Name, args, name);
      }
      if (left instanceof BoundNamespaceExpression) {
        const ns = (left as BoundNamespaceExpression).Namespace;
        const child = args.Length == 0 ? ns.GetNamespaceMember(name.Name) : null;
        if (child != null) {
          this.binder.Record(name, child);
          return this.At(new BoundNamespaceExpression(child), syntax);
        }
        const type = ns.GetTypeMember(name.Name, args.Length);
        if (type != null) {
          this.binder.Record(name, type);
          return this.At(new BoundTypeExpression(this.NamedOrNullable(args.Length == 0 ? type : type.Construct(args))), syntax);
        }
        this.binder.Report(Descriptors.NamespaceHasNoMember, name, [ns.ToDisplayString(), name.Name]);
        return this.Bad(syntax, left);
      }
      let type = left.Type;
      if (type == null || type.IsErrorType) return this.Bad(syntax, left);
      const isStatic = left instanceof BoundTypeExpression;
      if (!isStatic && type instanceof NullableTypeSymbol) {
        this.binder.Report(Descriptors.PossiblyNull, syntax, ["expression"]);
        type = (type as NullableTypeSymbol).Underlying;
      }
      if (type.IsNullType || type.IsVoid) {
        this.binder.Report(type.IsNullType ? Descriptors.NullDeref : Descriptors.VoidDeref, syntax, []);
        return this.Bad(syntax, left);
      }
      const members = this.binder.LookupMembers(type, name.Name);
      const methods = this.Methods(members);
      if (!methods.IsDefaultOrEmpty && methods.Length == members.Length) {
        this.binder.Record(name, methods[0]);
        return this.At(new BoundMethodGroup(left, name.Name, methods, args), syntax);
      }
      for (const member of members) {
        if (member instanceof MethodSymbol) continue;
        this.binder.Record(name, member);
        if (member instanceof NamedTypeSymbol) {
          if (!isStatic) {
            this.binder.Report(Descriptors.TypeViaInstance, name, [name.Name]);
            return this.Bad(syntax, left);
          }
          for (const candidate of members) if (candidate instanceof NamedTypeSymbol &&
            (candidate as NamedTypeSymbol).OwnArity == args.Length) {
            const nested = candidate as NamedTypeSymbol;
            let full = args;
            if (type instanceof NamedTypeSymbol && nested.Arity > nested.OwnArity)
              full = (type as NamedTypeSymbol).TypeArguments.AddRange(args);
            return this.At(new BoundTypeExpression(this.NamedOrNullable(full.Length == 0 ? nested : nested.Construct(full))), syntax);
          }
          this.binder.Report(Descriptors.TypeNotGeneric, name, [name.Name, args.Length]);
          return this.Bad(syntax, left);
        }
        if (isStatic && !member.IsStatic) {
          this.binder.Report(Descriptors.InstanceViaType, name, [name.Name, type.ToDisplayString()]);
          return this.Bad(syntax, left);
        }
        if (!isStatic && member.IsStatic)
          this.binder.Report(Descriptors.StaticViaInstance, name, [name.Name, type.ToDisplayString()]);
        const receiver = member.IsStatic ? null : left;
        if (member instanceof FieldSymbol) return this.Narrow(new BoundFieldAccess(receiver, member as FieldSymbol), syntax);
        if (member instanceof PropertySymbol) {
          const property = member as PropertySymbol;
          if (property.IsIndexer) {
            this.binder.Report(Descriptors.IndexerNeedsArguments, name, [name.Name]);
            return this.Bad(syntax, left);
          }
          return this.Narrow(new BoundPropertyAccess(receiver, property, ImmutableArray<BoundExpression>.Empty), syntax);
        }
      }
      if (!isStatic) for (const extension of this.binder.LookupExtensionMethods(name.Name))
        return this.At(new BoundMethodGroup(left, name.Name, ImmutableArray<MethodSymbol>.Empty, args), syntax);
      this.binder.Report(Descriptors.MemberNotFound, name, [name.Name, type.ToDisplayString()]);
      return this.Bad(syntax, left);
    }
    private BindElementAccess(syntax: ElementAccessExpressionSyntax): BoundExpression {
      const left = this.Natural(this.binder.BindValue(syntax.Expression), syntax.Expression);
      if (left.HasErrors) return this.Bad(syntax, left);
      if (left instanceof BoundConditionalAccess && !(syntax.Expression instanceof ParenthesizedExpressionSyntax) && !syntax.IsConditional) {
        const chain = left as BoundConditionalAccess;
        return this.MakeConditional(chain.Receiver, chain.Placeholder, this.ElementOn(chain.WhenNotNull, syntax), syntax);
      }
      if (syntax.IsConditional && left.Type != null) {
        const placeholder = this.At(new BoundConditionalReceiver(left.Type.StripNullable()), syntax.Expression);
        return this.MakeConditional(left, placeholder, this.ElementOn(placeholder, syntax), syntax);
      }
      return this.ElementOn(left, syntax);
    }
    private ElementOn(left: BoundExpression, syntax: ElementAccessExpressionSyntax): BoundExpression {
      let type = left.Type;
      const args = this.BindArguments(syntax.Arguments);
      if (type == null || type.IsErrorType) return this.Bad(syntax, left);
      if (type instanceof NullableTypeSymbol) {
        this.binder.Report(Descriptors.PossiblyNull, syntax.Expression, ["expression"]);
        type = (type as NullableTypeSymbol).Underlying;
      }
      if (type instanceof ArrayTypeSymbol) {
        const array = type as ArrayTypeSymbol;
        if (array.Rank != 1 || args.Length != 1) {
          this.binder.Report(Descriptors.NotIndexable, syntax, [type.ToDisplayString()]);
          return this.Bad(syntax, left);
        }
        return this.Narrow(new BoundArrayAccess(left, this.ConvertIndex(args[0], syntax.Arguments.Get(0)), array.ElementType), syntax);
      }
      if (type instanceof NamedTypeSymbol && (type as NamedTypeSymbol).IsTuple && args.Length == 1) {
        const tuple = type as NamedTypeSymbol;
        const value = args[0].ConstantValue?.Value;
        if (value instanceof int) {
          const index = value as int;
          if (index >= 0 && index < tuple.TypeArguments.Length && index < 7)
            for (const field of tuple.GetMembers("Item" + (index + 1)))
              if (field instanceof FieldSymbol) return this.Narrow(new BoundFieldAccess(left, field as FieldSymbol), syntax);
        }
        this.binder.Report(Descriptors.TupleIndexMustBeConstant, syntax, [tuple.ToDisplayString()]);
        return this.Bad(syntax, left);
      }
      const indexers = new List<PropertySymbol>();
      this.CollectIndexers(type, new HashSet<TypeSymbol>(), indexers);
      const accessors = new List<MethodSymbol>();
      for (const indexer of indexers) {
        const accessor = indexer.GetMethod ?? indexer.SetMethod;
        if (accessor != null) accessors.Add(accessor);
      }
      if (accessors.Count == 0) {
        this.binder.Report(Descriptors.NotIndexable, syntax, [type.ToDisplayString()]);
        return this.Bad(syntax, left);
      }
      const resolved = this.binder.Overloads.ResolveOverloads(accessors, args, ImmutableArray<TypeSymbol>.Empty,
        syntax, "this[]", true, true, args.Length);
      if (resolved == null) return this.Bad(syntax, left);
      let property = indexers[0];
      if (resolved.Method.AssociatedSymbol instanceof PropertySymbol) property = resolved.Method.AssociatedSymbol as PropertySymbol;
      if (resolved.Method.ContainingType != null) for (const member of resolved.Method.ContainingType.GetMembers()) {
        if (!(member instanceof PropertySymbol)) continue;
        const candidate = member as PropertySymbol;
        if (Object.ReferenceEquals(candidate.GetMethod?.OriginalDefinition, resolved.Method.OriginalDefinition) ||
          Object.ReferenceEquals(candidate.SetMethod?.OriginalDefinition, resolved.Method.OriginalDefinition)) property = candidate;
      }
      return this.Narrow(new BoundPropertyAccess(left, property, resolved.Arguments), syntax);
    }
    private CollectIndexers(type: TypeSymbol, seen: HashSet<TypeSymbol>, result: List<PropertySymbol>): void {
      if (!seen.Add(type)) return;
      for (const member of type.GetMembers()) if (member instanceof PropertySymbol) {
        const property = member as PropertySymbol;
        if (property.IsIndexer && !property.IsStatic && this.binder.IsAccessible(property)) result.Add(property);
      }
      if (result.Count > 0 && type.TypeKind != TypeKind.Interface) return;
      if (type.TypeKind == TypeKind.Interface || type instanceof TypeParameterSymbol)
        for (const iface of type.AllInterfaces) this.CollectIndexers(iface, seen, result);
      if (type instanceof TypeParameterSymbol)
        for (const constraint of (type as TypeParameterSymbol).ConstraintTypes) this.CollectIndexers(constraint, seen, result);
      if (type.BaseType != null) this.CollectIndexers(type.BaseType, seen, result);
    }
    ConvertIndex(value: BoundExpression, syntax: SyntaxNode): BoundExpression {
      const special = value.Type?.SpecialType ?? SpecialType.None;
      if (special == SpecialType.Int32 || special == SpecialType.UInt32 || special == SpecialType.Int64 ||
        special == SpecialType.UInt64 || special == SpecialType.IntPtr || special == SpecialType.UIntPtr) return value;
      return this.Convert(value, this.binder.IntType, syntax);
    }

    BindArguments(list: SeparatedSyntaxList<ExpressionSyntax>): ImmutableArray<BoundExpression> {
      const args = ImmutableArray.CreateBuilder<BoundExpression>();
      for (let i = 0; i < list.Count; i++) {
        const syntax = list.Get(i);
        if (syntax instanceof SpreadElementSyntax) {
          if (i != list.Count - 1) this.binder.Report(Descriptors.SpreadMustBeLast, syntax, []);
          args.Add(this.binder.BindValue((syntax as SpreadElementSyntax).Expression));
        } else args.Add(this.binder.BindValue(syntax));
      }
      return args.ToImmutable();
    }
    private BindInvocation(syntax: InvocationExpressionSyntax, target: TypeSymbol?): BoundExpression {
      if (syntax.Expression instanceof SuperExpressionSyntax) {
        this.binder.Report(Descriptors.SuperCallPosition, syntax.Expression, []);
        this.BindArguments(syntax.Arguments.Arguments);
        return this.Bad(syntax);
      }
      const callee = this.Natural(this.binder.BindExpression(syntax.Expression), syntax.Expression);
      let result: BoundExpression;
      if (callee instanceof BoundConditionalAccess && !(syntax.Expression instanceof ParenthesizedExpressionSyntax)) {
        const chain = callee as BoundConditionalAccess;
        result = this.MakeConditional(chain.Receiver, chain.Placeholder, this.InvokeOn(chain.WhenNotNull, syntax, target), syntax);
      } else result = this.InvokeOn(callee, syntax, target);
      this.binder.Flow.InvalidateAfterCall(this.CalledMethod(result));
      return result;
    }
    private CalledMethod(value: BoundExpression): MethodSymbol? {
      if (value instanceof BoundCall) return (value as BoundCall).Method;
      if (value instanceof BoundObjectCreation) return (value as BoundObjectCreation).Constructor;
      if (value instanceof BoundConditionalAccess) return this.CalledMethod((value as BoundConditionalAccess).WhenNotNull);
      if (value instanceof BoundSequence) return this.CalledMethod((value as BoundSequence).Value);
      return null;
    }
    private InvokeOn(callee: BoundExpression, syntax: InvocationExpressionSyntax, target: TypeSymbol?): BoundExpression {
      const args = this.BindArguments(syntax.Arguments.Arguments);
      if (callee.HasErrors) return this.Bad(syntax, callee);
      if (callee instanceof BoundMethodGroup) return this.CallGroup(callee as BoundMethodGroup, args, syntax, target);
      if (callee instanceof BoundTypeExpression) {
        this.binder.Report(Descriptors.UseNewForType, syntax.Expression, []);
        return this.Bad(syntax, callee);
      }
      let type = callee.Type;
      if (type == null) {
        this.binder.Report(Descriptors.ExpressionNotAValue, syntax.Expression, []);
        return this.Bad(syntax, callee);
      }
      if (type instanceof NullableTypeSymbol) {
        this.binder.Report(Descriptors.PossiblyNull, syntax.Expression, ["expression"]);
        type = (type as NullableTypeSymbol).Underlying;
      }
      if (type instanceof NamedTypeSymbol && type.TypeKind == TypeKind.Delegate) {
        const invoke = (type as NamedTypeSymbol).DelegateInvokeMethod;
        if (invoke != null) {
          const resolved = this.binder.Overloads.ResolveOverloads(ImmutableArray.Create<MethodSymbol>(invoke),
            args, ImmutableArray<TypeSymbol>.Empty, syntax, "invoke", true);
          if (resolved != null) return this.At(new BoundCall(callee, resolved.Method, resolved.Arguments), syntax);
          return this.Bad(syntax, callee);
        }
      }
      this.binder.Report(Descriptors.NotCallable, syntax.Expression, [type!.ToDisplayString()]);
      return this.Bad(syntax, callee);
    }
    private CallGroup(group: BoundMethodGroup, args: ImmutableArray<BoundExpression>,
      syntax: InvocationExpressionSyntax, target: TypeSymbol?): BoundExpression {
      for (const arg of args) if (arg.HasErrors) return this.Bad(syntax, group, arg);
      const typeReceiver = group.Receiver instanceof BoundTypeExpression;
      let resolved: ResolvedCall? = null;
      let extension = false;
      if (!group.Candidates.IsDefaultOrEmpty)
        resolved = this.binder.Overloads.ResolveOverloads(group.Candidates, args, group.TypeArguments,
          syntax, group.Name, false, false, 0, null, target);
      if (resolved == null && group.Receiver != null && !typeReceiver && group.Receiver.Type != null) {
        resolved = this.binder.Overloads.ResolveOverloads(this.binder.LookupExtensionMethods(group.Name),
          args, group.TypeArguments, syntax, group.Name, false, false, 0, group.Receiver, target);
        extension = resolved != null;
      }
      if (resolved == null) {
        if (!group.Candidates.IsDefaultOrEmpty)
          this.binder.Overloads.ResolveOverloads(group.Candidates, args, group.TypeArguments, syntax, group.Name, true);
        else if (group.Receiver != null)
          this.binder.Overloads.ResolveOverloads(this.binder.LookupExtensionMethods(group.Name), args,
            group.TypeArguments, syntax, group.Name, true, false, 0, group.Receiver, target);
        else this.binder.Report(Descriptors.NotCallable, syntax, [group.Name]);
        return this.Bad(syntax, group);
      }
      const method = resolved.Method;
      if (resolved.Ambiguity != null)
        this.binder.Report(Descriptors.AmbiguousCall, syntax, [group.Name,
          this.Signature(resolved.Ambiguity!.First), this.Signature(resolved.Ambiguity!.Second)]);
      this.binder.Record(syntax.Expression instanceof MemberAccessExpressionSyntax ?
        (syntax.Expression as MemberAccessExpressionSyntax).Name : syntax.Expression, method.OriginalDefinition);
      let receiver: BoundExpression? = null;
      if (!extension && !method.IsStatic) {
        if (typeReceiver) {
          this.binder.Report(Descriptors.InstanceViaType, syntax, [method.Name, group.Receiver!.Type!.ToDisplayString()]);
          return this.Bad(syntax, group);
        }
        receiver = group.Receiver ?? this.ImplicitThis(syntax);
        if (receiver.HasErrors) return this.Bad(syntax, group);
      } else if (!extension && group.Receiver != null && !typeReceiver && method.IsStatic)
        this.binder.Report(Descriptors.StaticViaInstance, syntax, [method.Name, group.Receiver.Type?.ToDisplayString() ?? "?"]);
      const call = this.At(new BoundCall(receiver, method, resolved.Arguments), syntax);
      call.IsBaseCall = group.IsBaseAccess;
      return resolved.OutLocals.IsDefaultOrEmpty ? call : this.WrapOut(call, resolved.OutLocals, syntax);
    }
    private Signature(method: MethodSymbol): string {
      let text = (method.ContainingType?.Name ?? "") + "." +
        (method.MethodKind == MethodKind.Constructor ? method.ContainingType?.Name ?? method.Name : method.Name) + "(";
      for (let i = 0; i < method.Parameters.Length; i++) {
        if (i != 0) text += ", ";
        text += method.Parameters[i].Type.ToDisplayString();
      }
      return text + ")";
    }
    private WrapOut(call: BoundCall, outs: ImmutableArray<LocalSymbol>, syntax: SyntaxNode): BoundExpression {
      const locals = outs.ToBuilder();
      const effects = ImmutableArray.CreateBuilder<BoundStatement>();
      const elements = ImmutableArray.CreateBuilder<BoundExpression>();
      if (call.Method.ReturnType.IsVoid) effects.Add(this.At(new BoundExpressionStatement(call), syntax));
      else {
        const temp = this.Temp("<ret>", call.Type!);
        locals.Add(temp);
        effects.Add(this.At(new BoundLocalDeclaration(temp, call), syntax));
        elements.Add(new BoundLocal(temp));
      }
      for (const local of outs) elements.Add(new BoundLocal(local));
      const value = elements.Count == 1 ? elements[0] : this.Tuple(elements.ToImmutable(), syntax);
      return this.At(new BoundSequence(locals.ToImmutable(), effects.ToImmutable(), value), syntax);
    }
    Tuple(elements: ImmutableArray<BoundExpression>, syntax: SyntaxNode): BoundExpression {
      const definition = this.binder.Context.GetWellKnownType("System.ValueTuple`" + elements.Length);
      if (definition == null || elements.Length > 7) {
        this.binder.Report(Descriptors.RuntimeMissing, syntax, ["System.ValueTuple`" + elements.Length]);
        return this.Bad(syntax);
      }
      const types = ImmutableArray.CreateBuilder<TypeSymbol>();
      for (const element of elements) types.Add(element.Type!);
      const tuple = definition.Construct(types.ToImmutable());
      return this.At(new BoundObjectCreation(this.Constructor(tuple, elements.Length), tuple, elements,
        ImmutableArray<BoundMemberInit>.Empty), syntax);
    }
    Temp(name: string, type: TypeSymbol): LocalSymbol {
      const local = new LocalSymbol(name, type, false, this.binder.ContainingSymbol);
      local.IsSynthesized = true;
      return local;
    }
    Constructor(type: NamedTypeSymbol, count: int): MethodSymbol? {
      for (const constructor of type.InstanceConstructors) if (constructor.Parameters.Length == count) return constructor;
      return null;
    }
    private BindNew(syntax: NewExpressionSyntax, target: TypeSymbol?): BoundExpression {
      let type: TypeSymbol? = null;
      if (target != null && syntax.Type instanceof IdentifierNameSyntax) {
        const candidates = this.binder.Context.GetScope(this.binder.File).Lookup((syntax.Type as IdentifierNameSyntax).Name);
        let nonGeneric = false;
        let generic: NamedTypeSymbol? = null;
        for (const candidate of candidates) if (candidate instanceof NamedTypeSymbol) {
          if ((candidate as NamedTypeSymbol).OwnArity == 0) nonGeneric = true;
          else if (generic == null) generic = candidate as NamedTypeSymbol;
        }
        if (!nonGeneric && generic != null && target.StripNullable() instanceof NamedTypeSymbol) {
          const actual = target.StripNullable() as NamedTypeSymbol;
          if (Object.ReferenceEquals(generic.OriginalDefinition, actual.OriginalDefinition)) type = actual;
          else {
            const supers = new List<NamedTypeSymbol>();
            supers.AddRange(generic.AllInterfaces);
            for (let baseType = generic.BaseType; baseType != null; baseType = baseType.BaseType) supers.Add(baseType);
            for (const superType of supers) {
              const solved = new Dictionary<TypeParameterSymbol, TypeSymbol>();
              if (!this.Unify(superType, actual, generic, solved)) continue;
              const args = ImmutableArray.CreateBuilder<TypeSymbol>();
              for (const parameter of generic.TypeParameters) if (solved.ContainsKey(parameter)) args.Add(solved[parameter]);
              if (args.Count == generic.Arity) { type = generic.Construct(args.ToImmutable()); break; }
            }
          }
        }
      }
      type = type ?? this.binder.BindType(syntax.Type);
      const args = syntax.Arguments == null ? ImmutableArray<BoundExpression>.Empty : this.BindArguments(syntax.Arguments.Arguments);
      const result = this.BuildObjectCreation(type, args, syntax);
      this.binder.Flow.InvalidateAfterCall(this.CalledMethod(result));
      return result;
    }
    private Unify(pattern: TypeSymbol, actual: TypeSymbol, generic: NamedTypeSymbol,
      solved: Dictionary<TypeParameterSymbol, TypeSymbol>): bool {
      if (pattern instanceof TypeParameterSymbol && generic.TypeParameters.Contains(pattern as TypeParameterSymbol)) {
        const parameter = pattern as TypeParameterSymbol;
        if (solved.ContainsKey(parameter)) return solved[parameter].Equals(actual);
        solved[parameter] = actual;
        return true;
      }
      if (pattern instanceof NamedTypeSymbol && actual instanceof NamedTypeSymbol) {
        const p = pattern as NamedTypeSymbol;
        const a = actual as NamedTypeSymbol;
        if (!Object.ReferenceEquals(p.OriginalDefinition, a.OriginalDefinition) || p.TypeArguments.Length != a.TypeArguments.Length) return false;
        for (let i = 0; i < p.TypeArguments.Length; i++) if (!this.Unify(p.TypeArguments[i], a.TypeArguments[i], generic, solved)) return false;
        return true;
      }
      if (pattern instanceof ArrayTypeSymbol && actual instanceof ArrayTypeSymbol)
        return this.Unify((pattern as ArrayTypeSymbol).ElementType, (actual as ArrayTypeSymbol).ElementType, generic, solved);
      return pattern.Equals(actual);
    }
    BuildObjectCreation(type: TypeSymbol, args: ImmutableArray<BoundExpression>, syntax: SyntaxNode): BoundExpression {
      if (type.IsErrorType) return this.Bad(syntax);
      for (const arg of args) if (arg.HasErrors) return this.Bad(syntax, arg);
      if (type instanceof TypeParameterSymbol) {
        const parameter = type as TypeParameterSymbol;
        if (!parameter.HasConstructorConstraint) {
          this.binder.Report(Descriptors.NewRequiresConstraint, syntax, [parameter.Name]);
          return this.Bad(syntax);
        }
        if (args.Length != 0) {
          this.binder.Report(Descriptors.NewTypeParamNoArgs, syntax, []);
          return this.Bad(syntax);
        }
        return this.At(new BoundObjectCreation(null, type, args, ImmutableArray<BoundMemberInit>.Empty), syntax);
      }
      if (!(type instanceof NamedTypeSymbol)) {
        this.binder.Report(Descriptors.CannotInstantiate, syntax, [type.ToDisplayString()]);
        return this.Bad(syntax);
      }
      const named = type as NamedTypeSymbol;
      if (named.TypeKind == TypeKind.Interface || named.TypeKind == TypeKind.Enum || named.IsAbstract || named.IsStaticClass) {
        this.binder.Report(Descriptors.CannotInstantiate, syntax, [type.ToDisplayString()]);
        return this.Bad(syntax);
      }
      if (named.TypeKind == TypeKind.Delegate) {
        if (args.Length == 1) return this.Convert(args[0], named, syntax);
        this.binder.Report(Descriptors.CannotInstantiate, syntax, [named.ToDisplayString()]);
        return this.Bad(syntax);
      }
      const constructors = this.binder.LookupConstructors(named);
      if (named.TypeKind == TypeKind.Struct && args.Length == 0 && this.Constructor(named, 0) == null)
        return this.At(new BoundObjectCreation(null, type, args, ImmutableArray<BoundMemberInit>.Empty), syntax);
      if (constructors.IsDefaultOrEmpty) {
        this.binder.Report(Descriptors.NoAccessibleConstructor, syntax, [type.ToDisplayString()]);
        return this.Bad(syntax);
      }
      const resolved = this.binder.Overloads.ResolveOverloads(constructors, args, ImmutableArray<TypeSymbol>.Empty, syntax, named.Name, true);
      return resolved == null ? this.Bad(syntax) :
        this.At(new BoundObjectCreation(resolved.Method, type, resolved.Arguments, ImmutableArray<BoundMemberInit>.Empty), syntax);
    }
    private BindAwait(syntax: AwaitExpressionSyntax): BoundExpression {
      const value = this.binder.BindValue(syntax.Operand);
      if (!this.binder.IsAsync) {
        this.binder.Report(Descriptors.AwaitOutsideAsync, syntax, []);
        return this.Bad(syntax, value);
      }
      if (value.HasErrors || value.Type == null) return this.Bad(syntax, value);
      const info = this.GetAwaitInfo(value.Type, syntax);
      return info == null ? this.Bad(syntax, value) : this.At(new BoundAwait(value, info, info.GetResult.ReturnType), syntax);
    }
    GetAwaitInfo(type: TypeSymbol, at: SyntaxNode): AwaitInfo? {
      type = type.StripNullable();
      let getAwaiter: MethodSymbol? = null;
      for (const method of this.Methods(this.binder.LookupMembers(type, "GetAwaiter")))
        if (!method.IsStatic && method.Parameters.Length == 0) { getAwaiter = method; break; }
      if (getAwaiter == null) for (const method of this.binder.LookupExtensionMethods("GetAwaiter")) {
        if (method.Parameters.Length == 1 && this.binder.Classifier.ClassifyImplicit(null, type, method.Parameters[0].Type).Exists) {
          getAwaiter = method;
          break;
        }
      }
      if (getAwaiter != null) {
        const awaiter = getAwaiter.ReturnType;
        let completed: PropertySymbol? = null;
        let result: MethodSymbol? = null;
        for (const member of this.binder.LookupMembers(awaiter, "IsCompleted"))
          if (member instanceof PropertySymbol) { completed = member as PropertySymbol; break; }
        for (const method of this.Methods(this.binder.LookupMembers(awaiter, "GetResult")))
          if (method.Parameters.Length == 0) { result = method; break; }
        if (completed != null && completed.GetMethod != null && result != null)
          return new AwaitInfo(getAwaiter, completed, completed.GetMethod, result, awaiter);
      }
      this.binder.Report(Descriptors.NotAwaitable, at, [type.ToDisplayString()]);
      return null;
    }
    private BinaryKind(kind: SyntaxKind): BinaryOperatorKind? {
      switch (kind) {
        case SyntaxKind.PlusToken: case SyntaxKind.PlusEqualsToken: return BinaryOperatorKind.Add;
        case SyntaxKind.MinusToken: case SyntaxKind.MinusEqualsToken: return BinaryOperatorKind.Subtract;
        case SyntaxKind.AsteriskToken: case SyntaxKind.AsteriskEqualsToken: return BinaryOperatorKind.Multiply;
        case SyntaxKind.SlashToken: case SyntaxKind.SlashEqualsToken: return BinaryOperatorKind.Divide;
        case SyntaxKind.PercentToken: case SyntaxKind.PercentEqualsToken: return BinaryOperatorKind.Remainder;
        case SyntaxKind.LessThanLessThanToken: case SyntaxKind.LessThanLessThanEqualsToken: return BinaryOperatorKind.ShiftLeft;
        case SyntaxKind.GreaterThanGreaterThanToken: case SyntaxKind.GreaterThanGreaterThanEqualsToken: return BinaryOperatorKind.ShiftRight;
        case SyntaxKind.GreaterThanGreaterThanGreaterThanToken:
        case SyntaxKind.GreaterThanGreaterThanGreaterThanEqualsToken: return BinaryOperatorKind.UnsignedShiftRight;
        case SyntaxKind.AmpersandToken: case SyntaxKind.AmpersandEqualsToken: return BinaryOperatorKind.And;
        case SyntaxKind.BarToken: case SyntaxKind.BarEqualsToken: return BinaryOperatorKind.Or;
        case SyntaxKind.CaretToken: case SyntaxKind.CaretEqualsToken: return BinaryOperatorKind.Xor;
        case SyntaxKind.EqualsEqualsToken: return BinaryOperatorKind.Equal;
        case SyntaxKind.ExclamationEqualsToken: return BinaryOperatorKind.NotEqual;
        case SyntaxKind.LessThanToken: return BinaryOperatorKind.LessThan;
        case SyntaxKind.LessThanEqualsToken: return BinaryOperatorKind.LessThanOrEqual;
        case SyntaxKind.GreaterThanToken: return BinaryOperatorKind.GreaterThan;
        case SyntaxKind.GreaterThanEqualsToken: return BinaryOperatorKind.GreaterThanOrEqual;
      }
      return null;
    }
    private OperatorName(kind: BinaryOperatorKind): string {
      switch (kind) {
        case BinaryOperatorKind.Add: return "op_Addition";
        case BinaryOperatorKind.Subtract: return "op_Subtraction";
        case BinaryOperatorKind.Multiply: return "op_Multiply";
        case BinaryOperatorKind.Divide: return "op_Division";
        case BinaryOperatorKind.Remainder: return "op_Modulus";
        case BinaryOperatorKind.ShiftLeft: return "op_LeftShift";
        case BinaryOperatorKind.ShiftRight: return "op_RightShift";
        case BinaryOperatorKind.UnsignedShiftRight: return "op_UnsignedRightShift";
        case BinaryOperatorKind.And: return "op_BitwiseAnd";
        case BinaryOperatorKind.Or: return "op_BitwiseOr";
        case BinaryOperatorKind.Xor: return "op_ExclusiveOr";
        case BinaryOperatorKind.Equal: return "op_Equality";
        case BinaryOperatorKind.NotEqual: return "op_Inequality";
        case BinaryOperatorKind.LessThan: return "op_LessThan";
        case BinaryOperatorKind.LessThanOrEqual: return "op_LessThanOrEqual";
        case BinaryOperatorKind.GreaterThan: return "op_GreaterThan";
        case BinaryOperatorKind.GreaterThanOrEqual: return "op_GreaterThanOrEqual";
      }
      return "";
    }
    private BindBinary(syntax: BinaryExpressionSyntax, target: TypeSymbol?): BoundExpression {
      const op = syntax.OperatorKind;
      if (op == SyntaxKind.AmpersandAmpersandToken || op == SyntaxKind.BarBarToken) {
        const left = this.binder.Conversions.ConvertToBool(this.binder.BindValue(syntax.Left), syntax.Left);
        const saved = this.binder.Flow.SaveState();
        const branches = FlowNarrowing.GetNarrowing(left);
        let right: BoundExpression;
        try {
          this.binder.Flow.Apply(op == SyntaxKind.AmpersandAmpersandToken ? branches.WhenTrue : branches.WhenFalse);
          right = this.binder.Conversions.ConvertToBool(this.binder.BindValue(syntax.Right), syntax.Right);
        } finally { this.binder.Flow.RestoreState(saved); }
        if (left.HasErrors || right.HasErrors) return this.Bad(syntax, left, right);
        const logical = new BoundLogicalBinary(op == SyntaxKind.AmpersandAmpersandToken, left, right, this.binder.BoolType);
        if (left.ConstantValue?.Value instanceof bool && right.ConstantValue?.Value instanceof bool) {
          const l = left.ConstantValue!.Value as bool;
          const r = right.ConstantValue!.Value as bool;
          logical.Folded = new ConstantValue(logical.IsAnd ? l && r : l || r);
        }
        return this.At(logical, syntax);
      }
      if (op == SyntaxKind.QuestionQuestionToken) return this.BindCoalesce(syntax, target);
      const left = this.binder.BindValue(syntax.Left);
      const right = this.binder.BindValue(syntax.Right);
      if (left.HasErrors || right.HasErrors) return this.Bad(syntax, left, right);
      if (op == SyntaxKind.AsteriskAsteriskToken) return this.Power(syntax, left, right);
      const kind = this.BinaryKind(op);
      if (kind == null) return this.Bad(syntax, left, right);
      return kind == BinaryOperatorKind.Equal || kind == BinaryOperatorKind.NotEqual ?
        this.Equality(syntax, kind as BinaryOperatorKind, left, right) : this.Arithmetic(syntax, kind as BinaryOperatorKind, left, right);
    }
    private BindCoalesce(syntax: BinaryExpressionSyntax, target: TypeSymbol?): BoundExpression {
      let left = this.binder.BindValue(syntax.Left);
      const saved = this.binder.Flow.SaveState();
      let right: BoundExpression;
      try { right = this.binder.BindValue(syntax.Right, target ?? left.Type?.StripNullable()); }
      finally { this.binder.Flow.RestoreState(saved); }
      if (left.Type == null || left.HasErrors || right.HasErrors) return this.Bad(syntax, left, right);
      const source = left.Type;
      const underlying = source.StripNullable();
      if (right instanceof BoundUnbound) right = this.Convert(right, underlying, syntax.Right);
      if (right.Type == null) return this.Bad(syntax, left, right);
      if (right.Type.IsNullType) return left;
      let result: TypeSymbol?;
      if (right.Type instanceof NullableTypeSymbol) {
        result = this.BestCommonType(ImmutableArray.Create<BoundExpression>(left, right));
        if (result != null && !(result instanceof NullableTypeSymbol)) result = new NullableTypeSymbol(result);
        if (result != null) return this.At(new BoundCoalesce(this.Convert(left, result, syntax.Left),
          this.Convert(right, result, syntax.Right), result), syntax);
      } else {
        result = this.binder.Classifier.ClassifyImplicit(right, right.Type, underlying).Exists ? underlying :
          this.BestCommonType(ImmutableArray.Create<BoundExpression>(this.Unwrap(left), right));
        if (result != null) {
          if (!result.Equals(underlying))
            left = this.Convert(left, source instanceof NullableTypeSymbol ? new NullableTypeSymbol(result) : result, syntax.Left);
          if (!(source instanceof NullableTypeSymbol) && source.IsValueType)
            this.binder.Report(Descriptors.CoalesceOnNonNullable, syntax.OperatorToken, [source.ToDisplayString()]);
          return this.At(new BoundCoalesce(left, this.Convert(right, result, syntax.Right), result), syntax);
        }
      }
      this.binder.Report(Descriptors.NoBestCommonType, syntax, [source.ToDisplayString(), right.Type!.ToDisplayString()]);
      return this.Bad(syntax, left, right);
    }
    private Promote(type: SpecialType): SpecialType {
      if (type == SpecialType.SByte || type == SpecialType.Byte || type == SpecialType.Int16 ||
        type == SpecialType.UInt16 || type == SpecialType.Char) return SpecialType.Int32;
      return type;
    }
    private Promotion(a: SpecialType, b: SpecialType, left: BoundExpression?, right: BoundExpression?): SpecialType {
      if (!SpecialTypes.IsNumeric(a) || !SpecialTypes.IsNumeric(b)) return SpecialType.None;
      if (a == SpecialType.Decimal || b == SpecialType.Decimal)
        return SpecialTypes.IsFloating(a == SpecialType.Decimal ? b : a) ? SpecialType.None : SpecialType.Decimal;
      if (a == SpecialType.Double || b == SpecialType.Double) return SpecialType.Double;
      if (a == SpecialType.Single || b == SpecialType.Single) return SpecialType.Single;
      if (a == SpecialType.IntPtr || b == SpecialType.IntPtr) return SpecialType.IntPtr;
      if (a == SpecialType.UIntPtr || b == SpecialType.UIntPtr) return SpecialType.UIntPtr;
      a = this.Promote(a); b = this.Promote(b);
      if (a == SpecialType.UInt64 || b == SpecialType.UInt64) {
        const other = a == SpecialType.UInt64 ? b : a;
        const value = (a == SpecialType.UInt64 ? right : left)?.ConstantValue?.Value;
        if (SpecialTypes.IsSignedIntegral(other))
          return value != null && ConstantFolding.ConvertNumeric(value, SpecialType.UInt64) != null ? SpecialType.UInt64 : SpecialType.None;
        return SpecialType.UInt64;
      }
      if (a == SpecialType.Int64 || b == SpecialType.Int64) return SpecialType.Int64;
      if (a == SpecialType.UInt32 || b == SpecialType.UInt32) {
        const other = a == SpecialType.UInt32 ? b : a;
        const value = (a == SpecialType.UInt32 ? right : left)?.ConstantValue?.Value;
        return other == SpecialType.Int32 ? (value instanceof int && (value as int) >= 0 ? SpecialType.UInt32 : SpecialType.Int64) : SpecialType.UInt32;
      }
      return SpecialType.Int32;
    }
    private Primitive(type: TypeSymbol): bool {
      const special = type.SpecialType;
      return special == SpecialType.Boolean || (SpecialTypes.IsNumeric(special) && special != SpecialType.Decimal &&
        special != SpecialType.IntPtr && special != SpecialType.UIntPtr);
    }
    private MakeBinary(at: SyntaxNode, kind: BinaryOperatorKind, left: BoundExpression, right: BoundExpression,
      result: TypeSymbol, operand: TypeSymbol): BoundExpression {
      const binary = new BoundBinary(kind, left, right, result, operand);
      const l = left.ConstantValue?.Value;
      const r = right.ConstantValue?.Value;
      if (l != null && r != null && operand.SpecialType != SpecialType.None) {
        const folded = ConstantFolding.FoldBinary(kind, l, r, operand.SpecialType);
        if (folded != null) binary.Folded = new ConstantValue(folded);
      }
      return this.At(binary, at);
    }
    private BadOperands(at: SyntaxNode, kind: BinaryOperatorKind, left: BoundExpression, right: BoundExpression): BoundExpression {
      let text = kind.ToString();
      if (at instanceof BinaryExpressionSyntax) text = (at as BinaryExpressionSyntax).OperatorToken.Text;
      else if (at instanceof AssignmentExpressionSyntax) text = (at as AssignmentExpressionSyntax).OperatorToken.Text;
      this.binder.Report(Descriptors.BadOperands, at, [text, left.Type?.ToDisplayString() ?? "?", right.Type?.ToDisplayString() ?? "?"]);
      return this.Bad(at, left, right);
    }
    private UserBinary(name: string, left: BoundExpression, right: BoundExpression, at: SyntaxNode): BoundExpression? {
      const methods = new List<MethodSymbol>();
      this.CollectOperators(left.Type!, name, 2, methods);
      this.CollectOperators(right.Type!, name, 2, methods);
      if (methods.Count == 0) return null;
      const resolved = this.binder.Overloads.ResolveOverloads(methods, ImmutableArray.Create<BoundExpression>(left, right),
        ImmutableArray<TypeSymbol>.Empty, at, name, false);
      return resolved == null ? null : this.At(new BoundCall(null, resolved.Method, resolved.Arguments), at);
    }
    private CollectOperators(type: TypeSymbol, name: string, arity: int, methods: List<MethodSymbol>): void {
      for (let current: TypeSymbol? = type.StripNullable(); current != null; current = current.BaseType) {
        for (const method of this.Methods(current.GetMembers(name)))
          if (method.IsStatic && method.Parameters.Length == arity && this.binder.IsAccessible(method) && !methods.Contains(method)) methods.Add(method);
      }
    }
    Arithmetic(at: SyntaxNode, kind: BinaryOperatorKind, left: BoundExpression, right: BoundExpression): BoundExpression {
      const lt = left.Type;
      const rt = right.Type;
      if (lt == null || rt == null || lt.IsErrorType || rt.IsErrorType) return this.Bad(at, left, right);
      const comparison = kind >= BinaryOperatorKind.LessThan && kind <= BinaryOperatorKind.GreaterThanOrEqual;
      if (kind == BinaryOperatorKind.Add &&
        (lt.StripNullable().SpecialType == SpecialType.String || rt.StripNullable().SpecialType == SpecialType.String)) {
        if (lt.IsVoid || rt.IsVoid) return this.BadOperands(at, kind, left, right);
        if ((lt instanceof NullableTypeSymbol && lt.StripNullable().SpecialType != SpecialType.String) ||
          (rt instanceof NullableTypeSymbol && rt.StripNullable().SpecialType != SpecialType.String)) {
          this.binder.Report(Descriptors.PossiblyNull, at, ["expression"]);
          return this.Bad(at, left, right);
        }
        const parts = new List<BoundExpression>();
        parts.Add(lt.IsNullType ? this.binder.Literal("", this.binder.StringType, at) : left);
        parts.Add(rt.IsNullType ? this.binder.Literal("", this.binder.StringType, at) : right);
        return this.BuildStringConcat(parts, at);
      }
      if (lt instanceof NullableTypeSymbol || rt instanceof NullableTypeSymbol) {
        this.binder.Report(Descriptors.PossiblyNull, at, ["expression"]);
        return this.Bad(at, left, right);
      }
