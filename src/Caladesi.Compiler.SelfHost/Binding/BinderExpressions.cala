      const temp = this.Temp("<t" + locals.Count + ">", value.Type!);
      locals.Add(temp);
      effects.Add(this.At(new BoundLocalDeclaration(temp, value), at));
      return this.At(new BoundLocal(temp), at);
    }
    private StabilizeReceiver(value: BoundExpression, locals: List<LocalSymbol>, effects: List<BoundStatement>, at: SyntaxNode): BoundExpression {
      if (value.Type!.IsValueType) {
        if (value instanceof BoundArrayAccess) {
          const array = value as BoundArrayAccess;
          return this.At(new BoundArrayAccess(this.Stabilize(array.Array, locals, effects, at),
            this.Stabilize(array.Index, locals, effects, at), array.Type!), value.Syntax);
        }
        if (value instanceof BoundFieldAccess) {
          const field = value as BoundFieldAccess;
          if (!field.Field.IsStatic && field.Receiver != null) return this.At(new BoundFieldAccess(
            this.StabilizeReceiver(field.Receiver, locals, effects, at), field.Field), value.Syntax);
        }
      }
      return this.Stabilize(value, locals, effects, at);
    }
    private Compound(target: BoundExpression, returnOld: bool, at: SyntaxNode,
      compute: Func<BoundExpression, BoundExpression>, coalesce: bool): BoundExpression {
      const locals = new List<LocalSymbol>();
      const effects = new List<BoundStatement>();
      let stable = target;
      if (target instanceof BoundFieldAccess) {
        const field = target as BoundFieldAccess;
        if (field.Receiver != null) stable = this.At(new BoundFieldAccess(
          this.StabilizeReceiver(field.Receiver, locals, effects, at), field.Field), at);
      } else if (target instanceof BoundPropertyAccess) {
        const property = target as BoundPropertyAccess;
        const receiver = property.Receiver == null ? null : this.StabilizeReceiver(property.Receiver, locals, effects, at);
        const args = ImmutableArray.CreateBuilder<BoundExpression>();
        for (const argument of property.Arguments) args.Add(this.Stabilize(argument, locals, effects, at));
        const access = new BoundPropertyAccess(receiver, property.Property, args.ToImmutable());
        access.IsBaseAccess = property.IsBaseAccess;
        stable = this.At(access, at);
      } else if (target instanceof BoundArrayAccess) {
        const array = target as BoundArrayAccess;
        stable = this.At(new BoundArrayAccess(this.Stabilize(array.Array, locals, effects, at),
          this.Stabilize(array.Index, locals, effects, at), array.Type!), at);
      }
      let result: BoundExpression;
      if (returnOld) {
        const old = this.Temp("<old>", target.Type!);
        locals.Add(old);
        effects.Add(this.At(new BoundLocalDeclaration(old, stable), at));
        const value = compute.Invoke(new BoundLocal(old));
        if (value.HasErrors) return this.Bad(at, target, value);
        const assignment = this.At(new BoundAssignment(stable, value), at);
        assignment.IsDiscarded = true;
        effects.Add(this.At(new BoundExpressionStatement(assignment), at));
        result = new BoundLocal(old);
      } else if (coalesce) {
        const value = compute.Invoke(stable) as BoundCoalesce;
        result = this.At(new BoundCoalesce(stable, this.At(new BoundAssignment(stable, value.Right), at), value.Type!), at);
      } else {
        const value = compute.Invoke(stable);
        if (value.HasErrors) return this.Bad(at, target, value);
        result = this.At(new BoundAssignment(stable, value), at);
      }
      this.binder.Flow.InvalidateNarrowing(target);
      return locals.Count == 0 ? result : this.At(new BoundSequence(ImmutableArray.CreateRange<LocalSymbol>(locals),
        ImmutableArray.CreateRange<BoundStatement>(effects), result), at);
    }
    private DestructureAssignment(syntax: AssignmentExpressionSyntax, pattern: ExpressionSyntax): BoundExpression {
      const rhs = this.Natural(this.binder.BindValue(syntax.Right), syntax.Right);
      if (rhs.HasErrors || rhs.Type == null) return this.Bad(syntax, rhs);
      const temp = this.Temp("<da>", rhs.Type);
      const locals = new List<LocalSymbol>();
      locals.Add(temp);
      const effects = new List<BoundStatement>();
      effects.Add(this.At(new BoundLocalDeclaration(temp, rhs), syntax));
      let source: BoundExpression = new BoundLocal(temp);
      const type = rhs.Type!.StripNullable();
      if (rhs.Type instanceof NullableTypeSymbol) {
        this.binder.Report(Descriptors.PossiblyNull, syntax.Right, ["destructured value"]);
        source = this.Unwrap(source);
      }
      const literals = new BinderExpressionLiterals<TFile>(this.binder, this);
      if (pattern instanceof ArrayLiteralExpressionSyntax) {
        let index = 0;
        for (const element of (pattern as ArrayLiteralExpressionSyntax).Elements) {
          const current = index++;
          if (element instanceof MissingExpressionSyntax) continue;
          const value = element instanceof SpreadElementSyntax ? literals.Rest(source, type, current, element) :
            literals.Element(source, type, current, element);
          if (value != null) this.DestructureStore(element instanceof SpreadElementSyntax ?
            (element as SpreadElementSyntax).Expression : element, value, locals, effects, syntax);
        }
      } else if (pattern instanceof ObjectLiteralExpressionSyntax) {
        for (const member of (pattern as ObjectLiteralExpressionSyntax).Members) {
          if (member instanceof PropertyAssignmentSyntax) {
            const property = member as PropertyAssignmentSyntax;
            const value = literals.Member(source, type, property.NameToken.ValueText, member);
            if (value != null) this.DestructureStore(property.Value, value, locals, effects, syntax);
          } else if (member instanceof ShorthandPropertyAssignmentSyntax) {
            const shorthand = member as ShorthandPropertyAssignmentSyntax;
            const value = literals.Member(source, type, shorthand.NameToken.Text, member);
            if (value != null) {
              const target = this.CheckAssignable(this.BindName(shorthand.NameToken.Text, ImmutableArray<TypeSymbol>.Empty, member), member, false);
              this.DestructureStoreBound(target, value, effects, syntax);
            }
          } else this.binder.Report(Descriptors.InvalidAssignmentTarget, member, []);
        }
      }
      return this.At(new BoundSequence(ImmutableArray.CreateRange<LocalSymbol>(locals),
        ImmutableArray.CreateRange<BoundStatement>(effects), new BoundLocal(temp)), syntax);
    }
    private DestructureStore(syntax: ExpressionSyntax, value: BoundExpression, locals: List<LocalSymbol>,
      effects: List<BoundStatement>, at: SyntaxNode): void {
      if (syntax instanceof ArrayLiteralExpressionSyntax || syntax instanceof ObjectLiteralExpressionSyntax) {
        // Nested patterns use the same accessors, without rebinding the source expression.
        const temp = this.Temp("<nested>", value.Type!);
        locals.Add(temp);
        effects.Add(this.At(new BoundLocalDeclaration(temp, value), at));
        const literals = new BinderExpressionLiterals<TFile>(this.binder, this);
        let source: BoundExpression = new BoundLocal(temp);
        const sourceType = value.Type!.StripNullable();
        if (value.Type instanceof NullableTypeSymbol) {
          this.binder.Report(Descriptors.PossiblyNull, syntax, ["destructured value"]);
          source = this.Unwrap(source);
        }
        if (syntax instanceof ArrayLiteralExpressionSyntax) {
          let index = 0;
          for (const element of (syntax as ArrayLiteralExpressionSyntax).Elements) {
            const current = index++;
            if (element instanceof MissingExpressionSyntax) continue;
            const child = element instanceof SpreadElementSyntax ? literals.Rest(source, sourceType, current, element) :
              literals.Element(source, sourceType, current, element);
            if (child != null) this.DestructureStore(element instanceof SpreadElementSyntax ?
              (element as SpreadElementSyntax).Expression : element, child, locals, effects, at);
          }
        } else for (const member of (syntax as ObjectLiteralExpressionSyntax).Members) {
          if (member instanceof PropertyAssignmentSyntax) {
            const property = member as PropertyAssignmentSyntax;
            const child = literals.Member(source, sourceType, property.NameToken.ValueText, member);
            if (child != null) this.DestructureStore(property.Value, child, locals, effects, at);
          } else if (member instanceof ShorthandPropertyAssignmentSyntax) {
            const shorthand = member as ShorthandPropertyAssignmentSyntax;
            const child = literals.Member(source, sourceType, shorthand.NameToken.Text, member);
            if (child != null) {
              const target = this.CheckAssignable(this.BindName(shorthand.NameToken.Text,
                ImmutableArray<TypeSymbol>.Empty, member), member, false);
              this.DestructureStoreBound(target, child, effects, at);
            }
          } else {
            this.binder.Report(Descriptors.InvalidAssignmentTarget, member, []);
          }
        }
        return;
      }
      this.DestructureStoreBound(this.AssignmentTarget(syntax), value, effects, at);
    }
    private DestructureStoreBound(target: BoundExpression, value: BoundExpression, effects: List<BoundStatement>, at: SyntaxNode): void {
      if (target.HasErrors) return;
      const assignment = this.At(new BoundAssignment(target, this.Convert(value, target.Type!, at)), at);
      assignment.IsDiscarded = true;
      effects.Add(this.At(new BoundExpressionStatement(assignment), at));
      this.binder.Flow.InvalidateNarrowing(target);
    }
    ConvertMethodGroup(group: BoundMethodGroup, target: TypeSymbol, syntax: SyntaxNode?, report: bool): BoundExpression {
      const stripped = target.StripNullable();
      if (!(stripped instanceof NamedTypeSymbol) || stripped.TypeKind != TypeKind.Delegate) {
        if (report && !target.IsErrorType) this.binder.Report(Descriptors.MethodGroupNeedsDelegate, syntax, [group.Name, target.ToDisplayString()]);
        return this.Bad(syntax, group);
      }
      const delegateType = stripped as NamedTypeSymbol;
      const method = this.binder.Overloads.ResolveMethodGroupForDelegate(group, delegateType);
      if (method == null) {
        if (report) this.binder.Report(Descriptors.MethodGroupNotConvertible, syntax, [group.Name, target.ToDisplayString()]);
        return this.Bad(syntax, group);
      }
      let extension = method.IsExtensionMethod && group.Receiver != null && group.Receiver.Type != null;
      for (const candidate of group.Candidates)
        if (Object.ReferenceEquals(candidate.OriginalDefinition, method.OriginalDefinition)) extension = false;
      let receiver: BoundExpression? = null;
      if (extension) receiver = group.Receiver;
      else if (!method.IsStatic) receiver = group.Receiver ?? this.ImplicitThis(syntax ?? group.Syntax!);
      const created = this.At(new BoundDelegateCreation(receiver, method, delegateType), syntax ?? group.Syntax);
      return target instanceof NullableTypeSymbol ?
        this.At(new BoundConversion(created, ConversionKind.ToNullable, target), syntax) : created;
    }
  Bad(syntax: SyntaxNode?): BoundBadExpression {
    return this.binder.Bad(syntax, ImmutableArray<BoundNode>.Empty);
  }
  Bad(syntax: SyntaxNode?, child: BoundNode): BoundBadExpression {
    return this.binder.Bad(syntax, ImmutableArray.Create<BoundNode>(child));
  }
  Bad(syntax: SyntaxNode?, left: BoundNode, right: BoundNode): BoundBadExpression {
    return this.binder.Bad(syntax, ImmutableArray.Create<BoundNode>(left, right));
  }
  Convert(value: BoundExpression, type: TypeSymbol, at: SyntaxNode?): BoundExpression {
    return this.binder.Conversions.ConvertImplicit(value, type, at);
  }
  Natural(value: BoundExpression, at: SyntaxNode): BoundExpression {
    if (!(value instanceof BoundUnbound)) return value;
    const bound = (value as BoundUnbound).BindToType.Invoke(null);
    if (!(bound instanceof BoundUnbound)) return bound;
    this.binder.Report(Descriptors.CannotInferType, at, []);
    return this.Bad(at, value);
  }
  private Narrow(value: BoundExpression, syntax: SyntaxNode): BoundExpression {
    value.Syntax = syntax;
    return Object.ReferenceEquals(syntax, this.binder.AssignTargetSyntax) ? value : this.binder.Flow.ApplyNarrowing(value);
  }
  BindTypeArguments(list: TypeArgumentListSyntax?): ImmutableArray<TypeSymbol> {
    const result = ImmutableArray.CreateBuilder<TypeSymbol>();
    if (list != null) for (const syntax of list.Arguments) result.Add(this.binder.BindType(syntax));
    return result.ToImmutable();
  }
  Methods(symbols: IEnumerable<Symbol>): ImmutableArray<MethodSymbol> {
    const result = ImmutableArray.CreateBuilder<MethodSymbol>();
    for (const symbol of symbols) if (symbol instanceof MethodSymbol) result.Add(symbol as MethodSymbol);
    return result.ToImmutable();
  }

  private BindLiteral(syntax: LiteralExpressionSyntax): BoundExpression {
    const value = syntax.Token.Value;
    switch (syntax.Kind) {
      case SyntaxKind.TrueLiteralExpression: return this.binder.Literal(true, this.binder.BoolType, syntax);
      case SyntaxKind.FalseLiteralExpression: return this.binder.Literal(false, this.binder.BoolType, syntax);
      case SyntaxKind.NullLiteralExpression: return this.binder.Literal(null, NullTypeSymbol.Instance, syntax);
      case SyntaxKind.StringLiteralExpression:
      case SyntaxKind.NoSubstitutionTemplateExpression:
        return this.binder.Literal(value as string ?? "", this.binder.StringType, syntax);
      case SyntaxKind.BigIntLiteralExpression:
        return this.binder.Literal(value ?? BigInteger.Zero, this.binder.Special(SpecialType.BigInteger), syntax);
    }
    let special = SpecialType.Int32;
    if (value instanceof long) special = SpecialType.Int64;
    else if (value instanceof uint) special = SpecialType.UInt32;
    else if (value instanceof ulong) special = SpecialType.UInt64;
    else if (value instanceof double) special = SpecialType.Double;
    else if (value instanceof float) special = SpecialType.Single;
    else if (value instanceof decimal) special = SpecialType.Decimal;
    return this.binder.Literal(value ?? 0, this.binder.Special(special), syntax);
  }
  private BindTemplate(syntax: TemplateExpressionSyntax): BoundExpression {
    const parts = new List<BoundExpression>();
    const head = syntax.Head.Value as string ?? "";
    if (head.Length > 0) parts.Add(this.binder.Literal(head, this.binder.StringType, syntax));
    for (const span of syntax.Spans) {
      parts.Add(this.binder.BindRValue(span.Expression));
      const text = span.Literal.Value as string ?? "";
      if (text.Length > 0) parts.Add(this.binder.Literal(text, this.binder.StringType, syntax));
    }
    return this.BuildStringConcat(parts, syntax);
  }

  BindName(name: string, typeArgs: ImmutableArray<TypeSymbol>, syntax: SyntaxNode): BoundExpression {
    const local = this.binder.LookupLocal(name);
    if (local != null) {
      if (!typeArgs.IsDefaultOrEmpty && !(local instanceof MethodSymbol)) {
        this.binder.Report(Descriptors.NotGeneric, syntax, [name]);
        return this.Bad(syntax);
      }
      this.binder.Record(syntax, local);
      return this.SymbolExpression(local, syntax, typeArgs);
    }
    if (typeArgs.IsDefaultOrEmpty) for (let owner = this.binder.ContainingSymbol; owner != null; owner = owner.ContainingSymbol) {
      if (owner instanceof MethodSymbol) for (const parameter of (owner as MethodSymbol).TypeParameters)
        if (parameter.Name == name) return this.At(new BoundTypeExpression(parameter), syntax);
      if (owner instanceof NamedTypeSymbol) for (const parameter of (owner as NamedTypeSymbol).TypeParameters)
        if (parameter.Name == name) return this.At(new BoundTypeExpression(parameter), syntax);
    }
    const candidates = this.binder.Context.GetScope(this.binder.File).Lookup(name);
    if (!candidates.IsDefaultOrEmpty) return this.BindSymbols(candidates, name, typeArgs, syntax);
    if (typeArgs.IsDefaultOrEmpty) {
      if (name == "never") return this.At(new BoundTypeExpression(NeverTypeSymbol.Instance), syntax);
      for (let index = SpecialType.Object as int; index <= (SpecialType.BigInteger as int); index++) {
        const special = index as SpecialType;
        if (SpecialTypes.Keyword(special) == name) return this.At(new BoundTypeExpression(this.binder.Special(special)), syntax);
      }
      if (name == "undefined") this.binder.Report(Descriptors.UndefinedNotAllowed, syntax, []);
      else if (name == "any") this.binder.Report(Descriptors.AnyNotAllowed, syntax, []);
      else if (name == "NaN" || name == "Infinity")
        this.binder.Report(Descriptors.NotSupportedUseInstead, syntax, [name, name == "NaN" ? "double.NaN" : "double.PositiveInfinity"]);
      else this.binder.Report(Descriptors.NameNotFound, syntax, [name]);
    } else this.binder.Report(Descriptors.NameNotFound, syntax, [name]);
    return this.Bad(syntax);
  }
  private BindSymbols(candidates: IEnumerable<Symbol>, name: string, types: ImmutableArray<TypeSymbol>, at: SyntaxNode): BoundExpression {
    const all = ImmutableArray.CreateRange<Symbol>(candidates);
    const methods = this.Methods(all);
    if (!methods.IsDefaultOrEmpty) {
      this.binder.Record(at, methods[0]);
      return this.At(new BoundMethodGroup(null, name, methods, types), at);
    }
    for (const symbol of all) {
      if (symbol instanceof FieldSymbol || (symbol instanceof PropertySymbol && symbol.IsStatic))
        return this.SymbolExpression(symbol, at, types);
    }
    for (const symbol of all) {
      if (symbol instanceof NamedTypeSymbol && (symbol as NamedTypeSymbol).OwnArity == types.Length) {
        const named = symbol as NamedTypeSymbol;
        this.binder.Record(at, named);
        return this.At(new BoundTypeExpression(this.NamedOrNullable(types.Length == 0 ? named : named.Construct(types))), at);
      }
      if (symbol instanceof TypeAliasSymbol<TFile>) {
        const alias = symbol as TypeAliasSymbol<TFile>;
        if (alias.TypeParameters.Length == types.Length) {
          this.binder.Record(at, alias);
          const expanded = types.Length == 0 ? alias.Target : new TypeMap(alias.TypeParameters, types).Substitute(alias.Target);
          return this.At(new BoundTypeExpression(expanded), at);
        }
      }
      if (symbol instanceof TypeParameterSymbol && types.Length == 0)
        return this.At(new BoundTypeExpression(symbol as TypeParameterSymbol), at);
    }
    for (const symbol of all) {
      if (symbol instanceof NamespaceSymbol) return this.At(new BoundNamespaceExpression(symbol as NamespaceSymbol), at);
      if (symbol instanceof FileModuleSymbol<TFile>)
        return this.At(new BinderExpressionModule<TFile>((symbol as FileModuleSymbol<TFile>).File), at);
    }
    for (const symbol of all) if (symbol instanceof NamedTypeSymbol) {
      this.binder.Report(types.Length == 0 ? Descriptors.TypeRequiresArguments : Descriptors.TypeNotGeneric,
        at, [name, types.Length == 0 ? (symbol as NamedTypeSymbol).OwnArity : types.Length]);
      return this.Bad(at);
    }
    this.binder.Report(Descriptors.NameNotFound, at, [name]);
    return this.Bad(at);
  }
  SymbolExpression(symbol: Symbol, at: SyntaxNode, types: ImmutableArray<TypeSymbol>): BoundExpression {
    this.binder.Record(at, symbol);
    if (symbol instanceof LocalSymbol) return this.Narrow(new BoundLocal(symbol as LocalSymbol), at);
    if (symbol instanceof ParameterSymbol) return this.Narrow(new BoundParameter(symbol as ParameterSymbol), at);
    if (symbol instanceof FieldSymbol) return this.Narrow(new BoundFieldAccess(null, symbol as FieldSymbol), at);
    if (symbol instanceof PropertySymbol)
      return this.Narrow(new BoundPropertyAccess(null, symbol as PropertySymbol, ImmutableArray<BoundExpression>.Empty), at);
    if (symbol instanceof MethodSymbol)
      return this.At(new BoundMethodGroup(null, symbol.Name, ImmutableArray.Create<MethodSymbol>(symbol as MethodSymbol), types), at);
    if (symbol instanceof TypeSymbol) return this.At(new BoundTypeExpression(symbol as TypeSymbol), at);
    return this.Bad(at);
  }
  private get StaticContext(): bool {
    for (let owner = this.binder.ContainingSymbol; owner != null; owner = owner.ContainingSymbol) {
      if (owner instanceof MethodSymbol && (owner as MethodSymbol).MethodKind == MethodKind.LambdaMethod) continue;
      if (owner instanceof MethodSymbol || owner instanceof FieldSymbol || owner instanceof PropertySymbol) return owner.IsStatic;
    }
    return false;
  }
  ImplicitThis(at: SyntaxNode): BoundExpression {
    let type = this.binder.CurrentType;
    if (type == null || this.StaticContext) {
      this.binder.Report(Descriptors.ThisNotAvailable, at, []);
      return this.Bad(at);
    }
    if (type.IsGenericType) {
      const args = ImmutableArray.CreateBuilder<TypeSymbol>();
      for (const parameter of type.TypeParameters) args.Add(parameter);
      type = type.Construct(args.ToImmutable());
    }
    this.UsesThis = true;
    return this.At(new BoundThis(type), at);
  }

  private BindInstanceOf(syntax: InstanceOfExpressionSyntax): BoundExpression {
    const target = this.binder.BindType(syntax.Type);
    const value = this.binder.BindValue(syntax.Expression);
    if (target.IsErrorType || value.HasErrors) return this.binder.Literal(false, this.binder.BoolType, syntax);
    if (value.Type == null) return this.Bad(syntax, value);
    const source = value.Type;
    const actual = target.StripNullable();
    const stripped = source.StripNullable();
    if (stripped instanceof NamedTypeSymbol && (stripped as NamedTypeSymbol).IsUnionType) {
      const cases = (stripped as NamedTypeSymbol).UnionCases;
      for (let i = 0; i < cases.Length; i++) if (cases[i].Equals(actual)) {
        const test = new BoundTypeTest(this.Unwrap(value), actual, this.binder.BoolType, TypeTestKind.UnionCase, i);
        test.OperandWasNullable = source instanceof NullableTypeSymbol;
        return this.At(test, syntax);
      }
    }
    if (!this.binder.Classifier.ClassifyExplicit(null, stripped, actual).Exists) {
      this.binder.Report(Descriptors.InstanceOfImpossible, syntax, [source.ToDisplayString(), target.ToDisplayString()]);
      return this.binder.Literal(false, this.binder.BoolType, syntax);
    }
    return this.At(new BoundTypeTest(value, actual, this.binder.BoolType), syntax);
  }
  Unwrap(value: BoundExpression): BoundExpression {
    return value.Type instanceof NullableTypeSymbol ?
      this.At(new BoundConversion(value, ConversionKind.FromNullable, (value.Type as NullableTypeSymbol).Underlying), value.Syntax) : value;
  }
  private BindConditional(syntax: ConditionalExpressionSyntax, target: TypeSymbol?): BoundExpression {
    const condition = this.binder.Conversions.ConvertToBool(this.binder.BindValue(syntax.Condition), syntax.Condition);
    const branches = FlowNarrowing.GetNarrowing(condition);
    const saved = this.binder.Flow.SaveState();
    let left: BoundExpression;
    let right: BoundExpression;
    try {
      this.binder.Flow.Apply(branches.WhenTrue);
      left = this.binder.BindValue(syntax.WhenTrue, target);
      this.binder.Flow.RestoreState(saved);
      this.binder.Flow.Apply(branches.WhenFalse);
      right = this.binder.BindValue(syntax.WhenFalse, target);
    } finally { this.binder.Flow.RestoreState(saved); }
    if (target == null) {
      if (left instanceof BoundUnbound && right.Type != null) left = this.Convert(left, right.Type, syntax.WhenTrue);
      if (right instanceof BoundUnbound && left.Type != null) right = this.Convert(right, left.Type, syntax.WhenFalse);
      target = this.BestCommonType(ImmutableArray.Create<BoundExpression>(left, right));
    }
    if (target == null) {
      this.binder.Report(Descriptors.NoBestCommonType, syntax, [left.Type?.ToDisplayString() ?? "?", right.Type?.ToDisplayString() ?? "?"]);
      return this.Bad(syntax, left, right);
    }
    return this.At(new BoundConditional(condition, this.Convert(left, target, syntax.WhenTrue),
      this.Convert(right, target, syntax.WhenFalse), target), syntax);
  }
  BestCommonType(expressions: IEnumerable<BoundExpression>): TypeSymbol? {
    const all = ImmutableArray.CreateRange<BoundExpression>(expressions);
    const candidates = new List<TypeSymbol>();
    let hasNull = false;
    for (const expression of all) {
      const type = expression.Type;
      if (type == null || type.IsNeverType) continue;
      if (type.IsErrorType) return this.binder.ErrorType;
      if (type.IsNullType) { hasNull = true; continue; }
      if (type instanceof NullableTypeSymbol) hasNull = true;
      let found = false;
      for (const candidate of candidates) if (candidate.Equals(type)) found = true;
      if (!found) candidates.Add(type!);
    }
    if (candidates.Count == 0) return hasNull ? NullTypeSymbol.Instance : null;
    for (let pass = 0; pass < 2; pass++) for (const candidate of candidates) {
      const type = pass == 0 ? candidate : candidate.StripNullable();
      let applicable = true;
      for (const expression of all) {
        const source = expression.Type;
        if (source == null || source.IsNullType || source.IsNeverType) continue;
        if (!this.binder.Classifier.ClassifyImplicit(expression, pass == 0 ? source : source.StripNullable(), type).Exists) {
          applicable = false;
          break;
        }
      }
      if (applicable) return hasNull && !(type instanceof NullableTypeSymbol) ? new NullableTypeSymbol(type) : type;
    }
    return null;
  }
}
