import { CliOptions } from "./CliOptions";
import { File, Path, Directory, MemoryStream, IOException } from "System.IO";
import { Compilation, CompilerInfo } from "Caladesi.Compiler";
import { DiagnosticBag, DiagnosticSeverity } from "Caladesi.Compiler.Diagnostics";
import { ReferenceSet } from "Caladesi.Compiler.Symbols.Metadata";
import { SyntaxTree, TestEntryPoint } from "Caladesi.Compiler.Syntax";
import { SourceText } from "Caladesi.Compiler.Text";

function readSource(path: string): string? {
  try {
    return File.ReadAllText(path);
  } catch (ex: IOException) {
    Console.Error.WriteLine(`${path} : error CALC0004: cannot read file: ${ex.Message}`);
  } catch (ex: UnauthorizedAccessException) {
    Console.Error.WriteLine(`${path} : error CALC0004: cannot read file: ${ex.Message}`);
  }
  return null;
}

function run(args: string[]): int {
  const options = CliOptions.Parse(args);
  if (options.ShowVersion) {
    Console.WriteLine(`calac ${CompilerInfo.Version}`);
    return 0;
  }
  for (const error of options.Errors) Console.Error.WriteLine(`calac : error CALC0001: ${error}`);
  if (options.Errors.Count > 0) return 1;
  if (options.Sources.Count == 0) {
    Console.Error.WriteLine("calac : error CALC0002: no source files");
    Console.Error.WriteLine("usage: calac [-out:file] [-target:exe|library] [-ref:assembly]... [@response-file] source.cala...");
    return 1;
  }
  if (options.Output == null) {
    Console.Error.WriteLine("calac : error CALC0003: -out is required");
    return 1;
  }

  const texts = new Dictionary<string, SourceText>();
  const trees = new List<SyntaxTree>();
  for (const source of options.Sources) {
    const text = readSource(source);
    if (text == null) return 1;
    const tree = SyntaxTree.ParseText(text, Path.GetFullPath(source));
    texts[tree.FilePath] = tree.Text;
    trees.Add(tree);
  }
  if (options.GenerateTestEntryPoint) {
    const entry = TestEntryPoint.Create(options.ToCompilationOptions(), options.TestHooks);
    texts[entry.FilePath] = entry.Text;
    trees.Add(entry);
  }
  const refDiags = new DiagnosticBag();
  const references = ReferenceSet.Create(options.References, refDiags);
  const compilation = Compilation.Create(options.ToCompilationOptions(), trees, references);
  using pe = new MemoryStream();
  using pdb = new MemoryStream();
  const pdbName = options.PdbOutput != null ? Path.GetFileName(options.PdbOutput) : null;
  const result = compilation.Emit(pe, options.PdbOutput != null ? pdb : null, pdbName);
  for (const diagnostic of refDiags.Items.Concat(result.Diagnostics).Distinct()) {
    if (diagnostic.EffectiveSeverity == DiagnosticSeverity.Hidden) continue;
    const path = diagnostic.FilePath ?? "";
    const text = texts.ContainsKey(path) ? texts[path] : null;
    const line = diagnostic.Format(text);
    if (diagnostic.EffectiveSeverity == DiagnosticSeverity.Error) Console.Error.WriteLine(line);
    else Console.WriteLine(line);
  }
  if (!result.Success || refDiags.Items.Any(d => d.EffectiveSeverity == DiagnosticSeverity.Error)) return 1;
  try {
    const directory = Path.GetDirectoryName(Path.GetFullPath(options.Output!));
    if (!string.IsNullOrEmpty(directory)) Directory.CreateDirectory(directory!);
    File.WriteAllBytes(options.Output!, pe.ToArray());
    if (options.PdbOutput != null) File.WriteAllBytes(options.PdbOutput, pdb.ToArray());
  } catch (ex: IOException) {
    Console.Error.WriteLine(`calac : error CALC0005: cannot write output: ${ex.Message}`);
    return 1;
  } catch (ex: UnauthorizedAccessException) {
    Console.Error.WriteLine(`calac : error CALC0005: cannot write output: ${ex.Message}`);
    return 1;
  }
  return 0;
}

function main(args: string[]): int {
  try {
    return run(args);
  } catch (ex: OutOfMemoryException) {
    throw;
  } catch (ex: Exception) {
    Console.Error.WriteLine(`calac : error CALC9999: internal compiler error: ${ex.GetType().Name}: ${ex.Message}`);
    return 2;
  }
}
