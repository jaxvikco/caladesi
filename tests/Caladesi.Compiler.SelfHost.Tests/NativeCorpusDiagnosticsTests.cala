import { TestClassAttribute, TestMethodAttribute } from "Microsoft.VisualStudio.TestTools.UnitTesting";
import { MemoryStream } from "System.IO";
import { OutputKind } from "Caladesi.Compiler";
import { DiagnosticSeverity, Descriptors } from "Caladesi.Compiler.Diagnostics";
import { SyntaxTree } from "Caladesi.Compiler.Syntax";
import { NativeCorpusHarness } from "./NativeCorpusHarness";

@TestClass
export class NativeCorpusDiagnosticsTests {
  @TestMethod
  LibraryInitializersAndRefStructModuleVariables(): void {
    NativeCorpusHarness.Error("export const a: string = 5;", Descriptors.NotAssignable);
    NativeCorpusHarness.Error("const s: Span<int> = new Span<int>([1, 2]);\nConsole.WriteLine(s.Length);", Descriptors.RefStructModuleVariable, OutputKind.ConsoleApplication);
  }
  @TestMethod
  AwaitInsideConditionalAccessIsReportedNotThrown(): void {
    const compilation = NativeCorpusHarness.Create(
      "class P { name = \"x\"; echo(s: string): string { return s + this.name; } }\n" +
      "async function g(): Task<string> { return \"a\"; }\nasync function main(): Task {\n" +
      " const p: P | null = new P();\n Console.WriteLine(p?.echo(await g()));\n}");
    const pe = new MemoryStream();
    try {
      const result = compilation.Emit(pe);
      if (result.Success) throw new Exception("Conditional-access await must fail emission");
      for (const diagnostic of result.Diagnostics)
        if (diagnostic.Id == Descriptors.UnsupportedConstruct.Id) return;
      throw new Exception("Missing UnsupportedConstruct diagnostic");
    } finally { pe.Dispose(); }
  }
  @TestMethod
  OriginalCleanBindingPrograms(): void {
    NativeCorpusHarness.Clean("Console.WriteLine('hello');");
    NativeCorpusHarness.Clean("function add(a: int, b: int): int { return a + b; }\nconst x = add(1, 2) * 3;\nlet y: double = x / 2;\nlet s = `x=${x} y=${y}`;\nConsole.WriteLine(s);");
    NativeCorpusHarness.Clean("const xs = [1, 2, 3, 4];\nconst ys = xs.Where(x => x % 2 == 0).Select(x => x * 10).ToList();\nconst total = xs.Sum();\nConsole.WriteLine(ys.Count + total);");
    NativeCorpusHarness.Clean("import { List, Dictionary } from \"System.Collections.Generic\";\nconst l = new List<int>();\nl.Add(3);\nconst d = new Dictionary<string, int>();\nd[\"a\"] = 1;\nfor (const v of l) Console.WriteLine(v);");
  }
  @TestMethod
  NamesAssignmentsAndNullStrictness(): void {
    NativeCorpusHarness.Error("function f() { Console.WriteLine(nope); }", Descriptors.NameNotFound);
    NativeCorpusHarness.Error("function f() { let x: int = 'a'; }", Descriptors.NotAssignable);
    NativeCorpusHarness.Error("function f() { let s: string = null; }", Descriptors.NullNotAssignable);
    NativeCorpusHarness.Clean("function len(s: string | null): int {\n if (s == null) return 0;\n return s.Length;\n}\nConsole.WriteLine(len('abc'));");
    NativeCorpusHarness.Error("function len(s: string | null): int { return s.Length; }", Descriptors.PossiblyNull);
  }
  @TestMethod
  JumpsOutOfFinallyAreRejectedButLocalJumpsAreAllowed(): void {
    NativeCorpusHarness.Error("function f(): int { try { return 1; } finally { return 2; } }\nConsole.WriteLine(f());", Descriptors.JumpOutOfFinally, OutputKind.ConsoleApplication);
    NativeCorpusHarness.Error("function f(): int { let n = 0; while (true) { try { n++; } finally { break; } } return n; }\nConsole.WriteLine(f());", Descriptors.JumpOutOfFinally, OutputKind.ConsoleApplication);
    NativeCorpusHarness.Error("function f(): int { let n = 0; while (n < 3) { try { n++; } finally { continue; } } return n; }\nConsole.WriteLine(f());", Descriptors.JumpOutOfFinally, OutputKind.ConsoleApplication);
    NativeCorpusHarness.Clean("function f(): int { let n = 0; try { n++; } finally { for (let i = 0; i < 3; i++) { if (i == 1) continue; if (i == 2) break; n++; } const g = (): int => { return 1; }; n += g(); } return n; }\nConsole.WriteLine(f());");
  }
  @TestMethod
  RethrowInLambdaInsideCatchIsReported(): void {
    NativeCorpusHarness.Error("function f(): void { throw new Exception(\"x\"); }\ntry { f(); } catch (e) { const g = () => { throw; }; g(); }", Descriptors.RethrowOutsideCatch, OutputKind.ConsoleApplication);
  }
  @TestMethod
  StructMemberWriteThroughPropertyIsReported(): void {
    NativeCorpusHarness.Error("import { Vector2 } from \"System.Numerics\";\nclass P { pos: Vector2 = new Vector2(0, 0); m(): void { this.pos.X = 1; } }", Descriptors.ModifyValueTypeTemporary);
    NativeCorpusHarness.Error("import { Vector2 } from \"System.Numerics\";\nclass P { pos: Vector2 = new Vector2(0, 0); m(): void { this.pos.X += 1; } }", Descriptors.ModifyValueTypeTemporary);
  }
  @TestMethod
  OverrideAndInterfaceTypeMismatches(): void {
    NativeCorpusHarness.Error("class B { f(): int { return 1; } }\nclass D extends B { override f(): string { return \"x\"; } }", Descriptors.OverrideTypeMismatch);
    NativeCorpusHarness.Error("class B { get v(): int { return 1; } }\nclass D extends B { override get v(): string { return \"x\"; } }", Descriptors.OverrideTypeMismatch);
    NativeCorpusHarness.Error("interface I { x: string }\nclass C implements I { x: int = 1; }", Descriptors.InterfaceMemberNotImplemented);
    NativeCorpusHarness.Clean("class MyList extends List<int> {}", OutputKind.DynamicallyLinkedLibrary);
  }
  @TestMethod
  CamelCasePropertyOverrideOfPascalCaseAbstractPropertyIsClean(): void {
    NativeCorpusHarness.Clean(
      "import { Stream, SeekOrigin } from \"System.IO\";\nclass S extends Stream {\n" +
      " override get canRead(): bool { return true; }\n override get canSeek(): bool { return false; }\n override get canWrite(): bool { return false; }\n" +
      " override get length(): long { return 0; }\n override get position(): long { return 0; }\n override set position(v: long) {}\n" +
      " override flush(): void {}\n override read(buffer: byte[], offset: int, count: int): int { return 0; }\n" +
      " override seek(offset: long, origin: SeekOrigin): long { return 0; }\n override setLength(value: long): void {}\n" +
      " override write(buffer: byte[], offset: int, count: int): void {}\n}", OutputKind.DynamicallyLinkedLibrary);
  }
  @TestMethod
  ControlFlowNarrowingDoesNotLeakAcrossBreakContinueOrFallthrough(): void {
    NativeCorpusHarness.Error("function f(s: string | null): int { do { if (s == null) break; } while (false); return s.Length; }", Descriptors.PossiblyNull);
    NativeCorpusHarness.Error("function f(s: string | null): int { let i = 0; for (; i < 3; i += s.Length) { if (s == null) continue; } return i; }", Descriptors.PossiblyNull);
    NativeCorpusHarness.Error("type Circle = { r: double };\ntype Square = { side: double };\ntype Shape = Circle | Square;\nfunction f(x: Shape): double { switch (x) { case Circle: Console.WriteLine(\"c\"); case Square: return x.side; } }", Descriptors.MemberNotFound);
    NativeCorpusHarness.Error("type Circle = { r: double };\ntype Square = { side: double };\nfunction f(x: Circle | Square | null): double { if (x instanceof Circle) return 1; return x.side; }", Descriptors.PossiblyNull);
  }
  @TestMethod
  ValidNarrowingStillWorks(): void {
    NativeCorpusHarness.Clean(
      "type Circle = { r: double };\ntype Square = { side: double };\ntype Shape = Circle | Square;\n" +
      "function a(s: string | null): int { do { if (s == null) break; } while (false); return s == null ? 0 : s.Length; }\n" +
      "function b(s: string | null): int { if (s == null) return 0; let i = 0; for (; i < 3; i += s.Length) { if (i == 1) continue; } return i; }\n" +
      "function c(x: Shape): double { switch (x) { case Circle: return x.r; case Square: return x.side; } }\n" +
      "function d(x: Shape): double { if (x instanceof Circle) return x.r; return x.side; }\n" +
      "function e(x: Circle | Square | null): double { if (x == null) return 0; if (x instanceof Circle) return x.r; return x.side; }", OutputKind.DynamicallyLinkedLibrary);
  }
  @TestMethod
  LabeledBlockExitedWithBreakCompletesNormally(): void {
    NativeCorpusHarness.Error("function f(x: bool): int { outer: { if (x) break outer; return 1; } }", Descriptors.NotAllPathsReturn);
    NativeCorpusHarness.Clean("function f(x: bool): int { outer: { if (x) break outer; return 1; } return 2; }", OutputKind.DynamicallyLinkedLibrary);
  }
  @TestMethod
  AwaitUsingRequiresAsync(): void {
    NativeCorpusHarness.Error("class AsyncRes implements IAsyncDisposable { DisposeAsync(): ValueTask { return ValueTask.CompletedTask; } }\nfunction f(): void { await using x = new AsyncRes(); }", Descriptors.AwaitOutsideAsync);
  }
  @TestMethod
  DuplicateKeysAndRecursiveInferenceAreReportedNotThrown(): void {
    NativeCorpusHarness.Error("type Point = { x: int; y: int };\nconst p: Point = { x: 1, x: 2, y: 3 };", Descriptors.DuplicateObjectLiteralKey, OutputKind.ConsoleApplication);
    NativeCorpusHarness.Error("const o = { x: 1, x: 2 };\nConsole.WriteLine(o.x);", Descriptors.DuplicateObjectLiteralKey, OutputKind.ConsoleApplication);
    NativeCorpusHarness.Error("class C { static a = C.a; }", Descriptors.RecursiveInference);
  }
  @TestMethod
  DeeplyNestedParenthesesAreReportedNotOverflowed(): void {
    const source = "const x = " + new string("("[0], 20000) + "1" + new string(")"[0], 20000) + ";";
    NativeCorpusHarness.Error(source, Descriptors.NestingTooDeep, OutputKind.ConsoleApplication);
    if (SyntaxTree.ParseText(source, "/proj/main.cala").Root.ToFullString() != source) throw new Exception("Deep input round trip");
  }
  @TestMethod
  AmbiguousAndUnambiguousOverloads(): void {
    NativeCorpusHarness.Error("function f(a: int, b: long): string { return \"A\"; }\nfunction f(a: long, b: int): string { return \"B\"; }\nConsole.WriteLine(f(1, 2));", Descriptors.AmbiguousCall, OutputKind.ConsoleApplication);
    NativeCorpusHarness.Clean("function f(a: int, b: long): string { return \"A\"; }\nfunction f(a: long, b: int): string { return \"B\"; }\nConsole.WriteLine(f(1, 2L));");
    NativeCorpusHarness.Error("function f(x: string): string { return \"a\"; }\nfunction f(x: string | null): string { return \"b\"; }", Descriptors.DuplicateMember);
    NativeCorpusHarness.Error("const o: object = new List();", Descriptors.TypeRequiresArguments, OutputKind.ConsoleApplication);
  }
  @TestMethod
  ImpossibleInstanceofIsExactlyOneWarningWithoutErrors(): void {
    const diagnostics = NativeCorpusHarness.Create("const x: int = 1;\nConsole.WriteLine(x instanceof string);").GetDiagnostics();
    let hits = 0;
    for (const diagnostic of diagnostics) {
      if (diagnostic.EffectiveSeverity == DiagnosticSeverity.Error) throw new Exception(diagnostic.ToString());
      if (diagnostic.Id == Descriptors.InstanceOfImpossible.Id) {
        hits++;
        if (diagnostic.EffectiveSeverity != DiagnosticSeverity.Warning) throw new Exception("Expected warning severity");
      }
    }
    if (hits != 1) throw new Exception("Expected exactly one impossible-instanceof diagnostic");
  }
  @TestMethod
  SourceCallsResetFieldNarrowingButLibraryCallsDoNot(): void {
    NativeCorpusHarness.Error("class K {\n name: string | null = \"a\";\n clear(): void { this.name = null; }\n m(): int { if (this.name != null) { this.clear(); return this.name.Length; } return 0; }\n}", Descriptors.PossiblyNull);
    NativeCorpusHarness.Clean("class K {\n name: string | null = \"a\";\n m(): int { if (this.name != null) { Console.WriteLine(\"x\"); return this.name.Length; } return 0; }\n}", OutputKind.DynamicallyLinkedLibrary);
    NativeCorpusHarness.Error("function j(a: string, b: int | null): string { return a + b; }", Descriptors.PossiblyNull);
  }
  @TestMethod
  NonVoidMethodGroupDoesNotConvertToVoidDelegate(): void {
    NativeCorpusHarness.Error("const a: Action = Console.ReadLine;", Descriptors.MethodGroupNotConvertible, OutputKind.ConsoleApplication);
    NativeCorpusHarness.Clean("const a: Action = Console.WriteLine;\nconst b: Func<string | null> = Console.ReadLine;", OutputKind.DynamicallyLinkedLibrary);
  }
  @TestMethod
  NaNAndInfinityHaveTargetedMessages(): void {
    let hits = 0;
    for (const diagnostic of NativeCorpusHarness.Create("const x = NaN;\nconst y = Infinity;").GetDiagnostics()) {
      if (diagnostic.Id == Descriptors.NameNotFound.Id) throw new Exception("Must not use NameNotFound");
      if (diagnostic.Id == Descriptors.NotSupportedUseInstead.Id) hits++;
    }
    if (hits != 2) throw new Exception("Expected two targeted NaN/Infinity messages");
  }
  @TestMethod
  SealedOverridesCannotBeOverridden(): void {
    NativeCorpusHarness.Error("class A { f(): int { return 1; } }\nclass B extends A { sealed override f(): int { return 2; } }\nclass C extends B { override f(): int { return 3; } }", Descriptors.OverrideOfSealedMember);
    NativeCorpusHarness.Error("class A { get v(): int { return 1; } }\nclass B extends A { sealed override get v(): int { return 2; } }\nclass C extends B { override get v(): int { return 3; } }", Descriptors.OverrideOfSealedMember);
  }
}
