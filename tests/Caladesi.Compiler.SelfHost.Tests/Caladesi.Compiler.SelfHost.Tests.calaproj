<Project>
  <Import Project="Sdk.props" Sdk="MSTest.Sdk" />
  <Import Project="../../src/Caladesi.Sdk/targets/Caladesi.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Caladesi.Compiler.SelfHost.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
    <CaladesiImplicitRuntimeReference>false</CaladesiImplicitRuntimeReference>
    <CaladesiCompilerPath>$(CaladesiRepoRoot)src/Caladesi.Cli/bin/$(Configuration)/net10.0/calac.dll</CaladesiCompilerPath>
    <CaladesiTasksAssembly>$(CaladesiRepoRoot)src/Caladesi.Build.Tasks/bin/$(Configuration)/net10.0/Caladesi.Build.Tasks.dll</CaladesiTasksAssembly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Caladesi.Compiler.SelfHost/Caladesi.Compiler.SelfHost.calaproj" />
    <ProjectReference Include="../../src/Caladesi.Runtime/Caladesi.Runtime.csproj" />
    <ProjectReference Include="../../src/Caladesi.Cli/Caladesi.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Caladesi.Build.Tasks/Caladesi.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="MSTest.Sdk" />
  <Import Project="../../src/Caladesi.Sdk/targets/Caladesi.targets" />
</Project>
