import { TestClassAttribute, TestMethodAttribute } from "Microsoft.VisualStudio.TestTools.UnitTesting";
import { StringBuilder } from "System.Text";
import { Directory, File, Path, SearchOption } from "System.IO";
import { SyntaxTree, SyntaxKind, BinaryExpressionSyntax, GenericNameSyntax, VariableDeclaratorSyntax,
  ConditionalExpressionSyntax, ParenthesizedExpressionSyntax, ArrowFunctionSyntax,
  InvocationExpressionSyntax, MemberAccessExpressionSyntax } from "Caladesi.Compiler.Syntax";
import { DiagnosticDescriptor, Descriptors } from "Caladesi.Compiler.Diagnostics";
import { Formatter } from "Caladesi.Compiler.Formatting";

@TestClass
export class NativeCorpusParserTests {
  private static Samples(): string[] {
    return [
      "import { List, Dictionary } from \"System.Collections.Generic\";\nimport * as IO from \"System.IO\";\nimport \"System.Linq\";\nimport type { Foo } from './foo';",
      "const x = 1;\nlet y: double = 2.5, z = 10L;\nconst s = `a ${x + 1} b ${ {a: 1}.a } c`;",
      "export function add(a: int, b: int = 2, ...rest: int[]): int { return a + b; }",
      "export async function* gen<T extends IComparable<T> & new()>(xs: T[]): IAsyncEnumerable<T> { for await (const x of xs) yield x; }",
      "type Point = { x: double; y: double; z?: int; readonly w: string };\nstruct type P2 = { x: int, y: int }\ntype Id = string;\ntype Dir = 'up' | 'down';\ntype Shape = Circle | Square | null;",
      "export class Foo<in T, out U> extends Bar<T> implements IBaz, IQux { private readonly n: int = 0x1F_FF; static count = 0; constructor(public a: int, private b: string) { super(a); } override toString(): string { return this.n as string; } get area(): double { return 1; } set area(v: double) { } abstract go(): void; async run(): Task { await Task.Delay(1); } }",
      "@Obsolete(\"x\") export interface I<T> extends J { name: string; run(x: int): void; get value(): int; }",
      "enum Color { Red, Green = 2, Blue }",
      "const f = (a: int, b) => a + b; const g = async x => await x; const h = <T>(x: T): T => x; const k = () => { return 1; };",
      "if (a < b && c > d) { x = a >> 2; y = a >>> 3; z >>= 1; w >>>= 2; v = a >= b; } else if (!c) throw new Error('x'); else x++;",
      "for (let i = 0; i < 10; i++) { continue; }\nfor (const x of xs) break;\nwhile (true) { }\ndo { } while (false);\nouter: for (;;) { break outer; }",
      "switch (x) { case 1: case 2: foo(); break; case Circle: { break; } default: bar(); }",
      "try { a(); } catch (e: IOException) { throw; } catch (e) { } finally { b(); }",
      "using f = new File(); await using g = open(); const { a, b: c = 2, ...rest } = obj; const [p, , q, ...r] = arr;",
      "const l = new List<int>(); const m = new Dictionary<string, List<int>>(); const a = new int[5]; const t: [int, string] = [1, 'a']; const u = xs.Select<int, int>(x => x * 2);",
      "const o = { a: 1, 'b': 2, c, ...d }; const arr = [1, 2, ...rest]; const r = a ?? b; a ??= 1; const n = a?.b?.[0]!.c; const e = 2 ** 3 ** 2;",
      "const v = x satisfies Foo; const w = y instanceof Bar; const q = cond ? 1 : 2; function f(this s: string): int { return 1; }",
      "// comment\n/* block */ let a = 1; // trailing\n/// doc\nlet b = 2;",
      "type F = (a: int) => string; type G = <T>(x: T) => T; let ro: readonly int[] = []; let ro2: IReadOnlyList<int>; let nn: string | null; let nn2: string?; let nn3: int?[];"
    ];
  }
  private static Parse(source: string): SyntaxTree {
    const tree = SyntaxTree.ParseText(source, "t.cala");
    if (tree.Root.ToFullString() != source) throw new Exception("Parser round trip: " + source);
    return tree;
  }
  private static Clean(source: string): SyntaxTree {
    const tree = NativeCorpusParserTests.Parse(source);
    if (tree.Diagnostics.Length != 0) throw new Exception(source + "\n" + tree.Diagnostics[0].ToString());
    return tree;
  }
  private static Error(source: string, descriptor: DiagnosticDescriptor): void {
    for (const diagnostic of NativeCorpusParserTests.Parse(source).Diagnostics)
      if (diagnostic.Id == descriptor.Id) return;
    throw new Exception("Expected parser diagnostic " + descriptor.Id + "\n" + source);
  }
  @TestMethod
  ValidSamplesRoundTripWithoutDiagnostics(): void {
    for (const source of NativeCorpusParserTests.Samples()) NativeCorpusParserTests.Clean(source);
  }
  @TestMethod
  EveryPrefixAndMutationRoundTripsAndNeverThrows(): void {
    for (const source of NativeCorpusParserTests.Samples()) {
      for (let n = 0; n <= source.Length; n += 3) NativeCorpusParserTests.Parse(source.Substring(0, n));
      for (let n = 0; n < source.Length; n += 7) NativeCorpusParserTests.Parse(source.Remove(n, Math.Min(3, source.Length - n)));
    }
  }
  @TestMethod
  SeededGarbageDoesNotCrash(): void {
    const random = new Random(42);
    const alphabet = "abc (){}[]<>;:,.=+-*/&|!?`'\"\n \t0123@#~^%";
    for (let i = 0; i < 300; i++) {
      const builder = new StringBuilder();
      const length = random.Next(1, 80);
      for (let j = 0; j < length; j++) builder.Append(alphabet[random.Next(alphabet.Length)]);
      NativeCorpusParserTests.Parse(builder.ToString());
    }
  }
  @TestMethod
  BinaryPrecedenceAndNestedGenerics(): void {
    const tree = NativeCorpusParserTests.Clean("const x = 1 + 2 * 3 >> 1;");
    let found = false;
    for (const node of tree.Root.DescendantNodes()) {
      if (!(node instanceof BinaryExpressionSyntax)) continue;
      if ((node as BinaryExpressionSyntax).OperatorKind != SyntaxKind.GreaterThanGreaterThanToken)
        throw new Exception("Outermost operator must be shift");
      found = true;
      break;
    }
    if (!found) throw new Exception("Missing binary expression");
    const genericTree = NativeCorpusParserTests.Clean("let x: List<List<int>> = new List<List<int>>();");
    let count = 0;
    for (const node of genericTree.Root.DescendantNodes()) {
      if (!(node instanceof GenericNameSyntax)) continue;
      const generic = node as GenericNameSyntax;
      if (generic.Name == "List" && generic.TypeArguments.Arguments.Count == 1 &&
        generic.TypeArguments.Arguments.Get(0) instanceof GenericNameSyntax) count++;
    }
    if (count != 2) throw new Exception("Nested generics consumed shift");
  }
  @TestMethod
  ForInExportDefaultAndAccurateSpans(): void {
    const source = "export default function f() { } for (const k in o) { }";
    const tree = NativeCorpusParserTests.Parse(source);
    let forIn = false;
    let exportDefault = false;
    for (const diagnostic of tree.Diagnostics) {
      if (diagnostic.Id == "CAL0026") forIn = true;
      if (diagnostic.Id == "CAL0021") exportDefault = true;
    }
    if (!forIn || !exportDefault) throw new Exception("Missing unsupported syntax diagnostics");
    const text = "  let abc = 12 ;";
    const spans = NativeCorpusParserTests.Clean(text);
    let declarations = 0;
    for (const node of spans.Root.DescendantNodes()) {
      if (!(node instanceof VariableDeclaratorSyntax)) continue;
      if (text.Substring(node.Span.Start, node.Span.Length) != "abc = 12") throw new Exception("Declarator span");
      declarations++;
    }
    const token = spans.Root.FindToken(text.IndexOf("12", StringComparison.Ordinal));
    if (declarations != 1 || token == null || token.Text != "12") throw new Exception("Token span");
  }
  @TestMethod
  NumberAndStrictEqualityDiagnostics(): void {
    NativeCorpusParserTests.Error("const x = 0b102;", Descriptors.InvalidNumber);
    NativeCorpusParserTests.Clean("const x = 0b1_01;");
    for (const source of ["const x = 1e400;", "const x = 1e400d;", "const x = 1e50f;"])
      NativeCorpusParserTests.Error(source, Descriptors.InvalidNumber);
    NativeCorpusParserTests.Clean("const x = 1e308; const y = 3.4e38f; const z = 1e-400;");
    for (const source of ["const b = a === 1;", "const c = a !== 2;"]) {
      const tree = NativeCorpusParserTests.Parse(source);
      if (tree.Diagnostics.Length != 1 || tree.Diagnostics[0].Id != Descriptors.NotSupportedUseInstead.Id)
        throw new Exception("Strict equality must report one targeted error");
    }
  }
  @TestMethod
  ComparisonChainDoesNotParseAsGenericName(): void {
    const tree = NativeCorpusParserTests.Clean("const r = a < b >= c;");
    let found = false;
    for (const node of tree.Root.DescendantNodes()) {
      if (node instanceof GenericNameSyntax) throw new Exception("Comparison parsed as generic");
      if (!found && node instanceof BinaryExpressionSyntax) {
        if ((node as BinaryExpressionSyntax).OperatorToken.Text != ">=") throw new Exception("Comparison chain operator");
        found = true;
      }
    }
    if (!found) throw new Exception("Missing comparison");
    NativeCorpusParserTests.Clean("const r = f<int>(1); const g = a<b>;");
  }
  @TestMethod
  ConditionalArrowAlternativesAndTypeofMemberAccess(): void {
    const tree = NativeCorpusParserTests.Clean("const v = c ? (x) : y => y * 2;");
    let count = 0;
    for (const node of tree.Root.DescendantNodes()) {
      if (!(node instanceof ConditionalExpressionSyntax)) continue;
      const conditional = node as ConditionalExpressionSyntax;
      if (!(conditional.WhenTrue instanceof ParenthesizedExpressionSyntax) ||
        !(conditional.WhenFalse instanceof ArrowFunctionSyntax)) throw new Exception("Conditional arrow disambiguation");
      count++;
    }
    if (count != 1) throw new Exception("Expected one conditional");
    const typed = NativeCorpusParserTests.Clean("const v = c ? (a: int): int => a : null;");
    let arrows = 0;
    for (const node of typed.Root.DescendantNodes())
      if (node instanceof ConditionalExpressionSyntax && (node as ConditionalExpressionSyntax).WhenTrue instanceof ArrowFunctionSyntax) arrows++;
    if (arrows != 1) throw new Exception("Typed arrow in conditional");
    NativeCorpusParserTests.Clean("const w = c ? f((a: int): int => a) : null;");
    const typeOf = NativeCorpusParserTests.Clean("Console.WriteLine(typeof(int).Name);");
    let invocation = false;
    for (const node of typeOf.Root.DescendantNodes()) {
      if (!(node instanceof InvocationExpressionSyntax)) continue;
      if (!((node as InvocationExpressionSyntax).Arguments.Arguments.Get(0) instanceof MemberAccessExpressionSyntax))
        throw new Exception("typeof member access");
      invocation = true;
      break;
    }
    if (!invocation) throw new Exception("Missing typeof invocation");
  }
  @TestMethod
  UnaryExponentRequiresParentheses(): void {
    for (const source of ["const x = -2 ** 2;", "const x = +a ** 2;", "const x = !a ** 2;", "async function f() { return await g() ** 2; }", "const x = a * -2 ** b;"])
      NativeCorpusParserTests.Error(source, Descriptors.UnaryBeforeExponent);
    for (const source of ["const x = (-2) ** 2;", "const x = -(2 ** 2);", "const x = 2 ** -2;"])
      NativeCorpusParserTests.Clean(source);
  }
  @TestMethod
  ExportRecoveryAndTemplateFormattingPreserveSource(): void {
    for (const source of ["export default function f() {}", "@A export default class C {}", "export default 1;", "@A\nexport default function () {}"])
      NativeCorpusParserTests.Error(source, Descriptors.ExportDefaultNotSupported);
    const source = "const s = `abc  \n  def   \nghi`;   \nconst t = 1;\n";
    if (Formatter.Format(SyntaxTree.ParseText(source, "t.cala")) != "const s = `abc  \n  def   \nghi`;\nconst t = 1;\n")
      throw new Exception("Multiline template whitespace");
  }
  @TestMethod
  TemplateSourcesParseWithoutErrors(): void {
    let root = AppContext.BaseDirectory;
    while (!File.Exists(Path.Combine(root, "Caladesi.slnx"))) {
      const parent = Directory.GetParent(root);
      if (parent == null) throw new Exception("Cannot find repository templates");
      root = parent.FullName;
    }
    const templates = Path.Combine(root, "src", "Caladesi.Templates", "templates");
    let count = 0;
    for (const path of Directory.EnumerateFiles(templates, "*.cala", SearchOption.AllDirectories)) {
      const tree = SyntaxTree.ParseText(File.ReadAllText(path), path);
      if (tree.Diagnostics.Length != 0) throw new Exception(path + "\n" + tree.Diagnostics[0].ToString());
      count++;
    }
    if (count == 0) throw new Exception("Missing template source corpus");
  }
}
