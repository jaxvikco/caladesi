<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Caladesi.LanguageServer.Tests</RootNamespace>
    <!-- MSTest requires public test classes (CA1515); Subject_Scenario method names are the established test naming style (CA1707). -->
    <NoWarn>$(NoWarn);CA1515;CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Caladesi.Compiler\Caladesi.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Caladesi.LanguageServer\Caladesi.LanguageServer.csproj" />
    <ProjectReference Include="..\..\src\Caladesi.Runtime\Caladesi.Runtime.csproj" />
  </ItemGroup>
</Project>
