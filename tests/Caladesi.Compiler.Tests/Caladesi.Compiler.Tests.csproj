<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Caladesi.Compiler.Tests</RootNamespace>
    <!-- NU1903: the MSBuild task API package (used only to instantiate the build task, as in Caladesi.Build.Tasks) has an advisory. -->
    <!-- MSTest requires public test classes (CA1515); Subject_Scenario method names are the established test naming style (CA1707). -->
    <NoWarn>$(NoWarn);CA1515;CA1707;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Caladesi.Compiler\Caladesi.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Caladesi.Compiler.SelfHost\Caladesi.Compiler.SelfHost.calaproj" Aliases="SelfHost" />
    <ProjectReference Include="..\..\src\Caladesi.Cli.SelfHost\Caladesi.Cli.SelfHost.calaproj" Aliases="SelfHostCli" />
    <ProjectReference Include="..\..\src\Caladesi.Build.Tasks.SelfHost\Caladesi.Build.Tasks.SelfHost.calaproj" Aliases="SelfHostBuild" />
    <ProjectReference Include="..\..\src\Caladesi.Runtime.SelfHost\Caladesi.Runtime.SelfHost.calaproj" Aliases="SelfHostRuntime" />
    <ProjectReference Include="..\..\src\Caladesi.Runtime\Caladesi.Runtime.csproj" />
    <!-- built first so the CLI tests can run calac.dll; nothing from it is referenced -->
    <ProjectReference Include="..\..\src\Caladesi.Cli\Caladesi.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Caladesi.Build.Tasks\Caladesi.Build.Tasks.csproj" />
    <!-- the task project references MSBuild compile-only; the test instantiates the task, so it needs the runtime assemblies -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="Microsoft.ILVerification" />
  </ItemGroup>
</Project>
